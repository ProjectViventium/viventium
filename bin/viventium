remote_tunnel_surface_healthy() {
  local mode=""
  local state_root=""
  local state_file=""
  mode="$(read_generated_env_value "VIVENTIUM_REMOTE_CALL_MODE" "disabled")"
  [[ -n "$mode" && "$mode" != "disabled" ]] || return 0
  state_root="$(read_generated_env_value "VIVENTIUM_STATE_ROOT" "")"
  if [[ -z "$state_root" ]]; then
    state_root="$APP_SUPPORT_DIR/state/runtime/${VIVENTIUM_RUNTIME_PROFILE:-isolated}"
  fi
  state_file="$state_root/public-network.json"
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/remote_call_tunnel.py" status \
    --state-file "$state_file" >/dev/null 2>&1
}

glasshive_surface_healthy() {
  local runtime_port=""
  local ui_port=""
  runtime_port="$(read_generated_env_value "GLASSHIVE_RUNTIME_PORT" "8766")"
  ui_port="$(read_generated_env_value "GLASSHIVE_UI_PORT" "8780")"
  {
    http_json_status_healthy "http://localhost:${runtime_port}/health" ||
      http_json_status_healthy "http://127.0.0.1:${runtime_port}/health"
  } &&
    # The MCP transport itself is the supported liveness contract. FastMCP
    # correctly returns a protocol-level 4xx to an unauthenticated GET, while
    # older deployed builds do not expose a separate /health route.
    mcp_url_surface_reachable "GLASSHIVE_MCP_URL" "http://127.0.0.1:8767/mcp" &&
    {
      http_json_status_healthy "http://localhost:${ui_port}/health" ||
        http_json_status_healthy "http://127.0.0.1:${ui_port}/health"
    }
}

prompt_workbench_surface_healthy() {
  local port=""
  port="$(read_generated_env_value "VIVENTIUM_PROMPT_WORKBENCH_PORT" "8781")"
  local_http_surface_healthy "$port" "/api/health"
}

runtime_pid_file_running() {
  local pid_file_name="${1:-}"
  [[ -n "$pid_file_name" ]] || return 1

  local runtime_profile="${VIVENTIUM_RUNTIME_PROFILE:-isolated}"
  local state_root=""
  state_root="$(read_generated_env_value "VIVENTIUM_STATE_ROOT" "")"
  if [[ -z "$state_root" ]]; then
    state_root="$APP_SUPPORT_DIR/state/runtime/$runtime_profile"
  fi

  local candidate pid
  for candidate in "$state_root/$pid_file_name" "$state_root/logs/$pid_file_name"; do
    [[ -f "$candidate" ]] || continue
    pid="$(tr -d '[:space:]' <"$candidate" 2>/dev/null || true)"
    if pid_is_running "$pid"; then
      return 0
    fi
  done

  return 1
}

telegram_bridge_surface_healthy() {
  local api_port=""
  local frontend_port=""
  local playground_port=""
  local state_root=""
  local health_json=""
  assign_runtime_ports api_port frontend_port playground_port
  state_root="$(read_generated_env_value "VIVENTIUM_STATE_ROOT" "")"
  if [[ -z "$state_root" ]]; then
    state_root="$APP_SUPPORT_DIR/state/runtime/${VIVENTIUM_RUNTIME_PROFILE:-isolated}"
  fi
  health_json="$(
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/telegram_poller_handoff.py" health \
      --state-dir "$state_root/telegram-poller" \
      --pid-file "$state_root/telegram_bot.pid" \
      --require-receipt 2>/dev/null
  )" || return 1
  "$PYTHON_BIN" -c '
import json, sys
payload = json.loads(sys.stdin.read())
raise SystemExit(0 if payload.get("running") is True and payload.get("ready") is True else 1)
' <<<"$health_json" &&
    api_surface_healthy "$api_port"
}

telegram_codex_surface_healthy() {
  runtime_pid_file_running "telegram_codex.pid"
}

optional_install_surfaces_healthy() {
  if runtime_env_true "START_SEARXNG" "false" && ! searxng_surface_healthy; then
    return 1
  fi
  if runtime_env_true "START_FIRECRAWL" "false" && ! firecrawl_surface_healthy; then
    return 1
  fi
  return 0
}

runtime_optional_surfaces_healthy() {
  if runtime_env_true "START_RAG_API" "false" && ! rag_api_surface_healthy; then
    return 1
  fi
  if runtime_env_true "START_GOOGLE_MCP" "false" && ! mcp_url_surface_reachable "GOOGLE_WORKSPACE_MCP_URL" "http://localhost:8111/mcp"; then
    return 1
  fi
  if runtime_env_true "START_MS365_MCP" "false" && ! mcp_url_surface_reachable "MS365_MCP_SERVER_URL" "http://localhost:6274/mcp"; then
    return 1
  fi
  if runtime_env_true "START_SCHEDULING_MCP" "false" && ! scheduling_surface_healthy; then
    return 1
  fi
  if runtime_env_true "START_GLASSHIVE" "false" && ! glasshive_surface_healthy; then
    return 1
  fi
  if runtime_env_true "START_PROMPT_WORKBENCH" "false" && ! prompt_workbench_surface_healthy; then
    return 1
  fi
  if runtime_env_true "START_CODE_INTERPRETER" "false" && ! code_interpreter_surface_healthy; then
    return 1
  fi
  if runtime_env_true "START_SKYVERN" "false" && ! skyvern_surface_healthy; then
    return 1
  fi
  if runtime_env_true "VIVENTIUM_VOICE_ENABLED" "false"; then
    if ! livekit_surface_healthy || ! voice_gateway_surface_healthy; then
      return 1
    fi
  fi
  if runtime_env_true "START_TELEGRAM" "false" && ! telegram_bridge_surface_healthy; then
    return 1
  fi
  if runtime_env_true "START_TELEGRAM_CODEX" "false" && ! telegram_codex_surface_healthy; then
    return 1
  fi
  # Public-edge setup depends on router ownership and other external network
  # state. Its owning contract explicitly keeps localhost running and records
  # an actionable degraded status when mappings conflict. Do not turn that
  # expected degradation into an endless local upgrade rollback.
  optional_install_surfaces_healthy
}

pid_matches_repo_scope() {
  local pid="${1:-}"
  [[ -n "$pid" ]] || return 1

  local cmd
  cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  if [[ -n "$cmd" ]]; then
    case "$cmd" in
      "$REPO_ROOT"|"$REPO_ROOT"/*|*" $REPO_ROOT"|*" $REPO_ROOT"/*)
        return 0
        ;;
    esac
  fi

  return 1
}

pid_matches_runtime_process_group() {
  local pid="${1:-}"
  local recorded_pgid=""
  local current_pgid=""
  [[ -n "$pid" ]] || return 1

  recorded_pgid="$(read_detached_launch_process_group)"
  [[ "$recorded_pgid" =~ ^[0-9]+$ ]] || return 1

  current_pgid="$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '[:space:]' || true)"
  [[ "$current_pgid" == "$recorded_pgid" ]]
}

pattern_running_in_repo() {
  local pattern="${1:-}"
  [[ -n "$pattern" ]] || return 1
  local pids
  pids="$(pgrep -f "$pattern" 2>/dev/null || true)"
  [[ -n "$pids" ]] || return 1

  local pid
  for pid in $pids; do
    if pid_matches_repo_scope "$pid" && pid_matches_runtime_process_group "$pid"; then
      return 0
    fi
  done

  return 1
}

managed_process_running() {
  pattern_running_in_repo "npm ci" ||
    pattern_running_in_repo "npm install" ||
    pattern_running_in_repo "npm run build" ||
    pattern_running_in_repo "vite build" ||
    pattern_running_in_repo "node.*api/server" ||
    pattern_running_in_repo "next dev" ||
    pattern_running_in_repo "TelegramVivBot.*bot.py" ||
    pattern_running_in_repo "worker.py start" ||
    pattern_running_in_repo "main.py --transport"
}

is_stack_running() {
  local api_port=""
  local frontend_port=""
  local playground_port=""
  local sandpack_port=""
  assign_runtime_ports api_port frontend_port playground_port sandpack_port
  runtime_port_listening "$api_port" ||
    runtime_port_listening "$frontend_port" ||
    { sandpack_runtime_required && runtime_port_listening "$sandpack_port"; } ||
    runtime_port_listening "$playground_port" ||
    managed_process_running
}

all_user_surfaces_healthy() {
  local api_port=""
  local frontend_port=""
  local playground_port=""
  local sandpack_port=""
  assign_runtime_ports api_port frontend_port playground_port sandpack_port
  api_surface_healthy "$api_port" &&
    frontend_surface_healthy "$frontend_port" &&
    { ! sandpack_runtime_required || sandpack_surface_healthy "$sandpack_port"; } &&
    { express_install_experience || playground_surface_healthy "$playground_port"; }
}

install_surfaces_healthy() {
  # The installer should unblock as soon as the user-facing surfaces are ready.
  # Docker-backed web-search sidecars can keep warming in the background via the
  # launcher's late optional recovery worker without holding first-run success.
  all_user_surfaces_healthy
}

user_surface_healthy() {
  all_user_surfaces_healthy
}

capture_detached_start_log_offset() {
  local launch_log="${1:-}"
  local byte_count=0

  if [[ -f "$launch_log" ]]; then
    byte_count="$(wc -c <"$launch_log" 2>/dev/null | tr -d '[:space:]' || true)"
  fi
  if [[ ! "$byte_count" =~ ^[0-9]+$ ]]; then
    byte_count=0
  fi
  DETACHED_START_LOG_OFFSET="$byte_count"
}

launch_stack_detached() {
  ensure_app_support_layout "$APP_SUPPORT_DIR"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Missing config: $CONFIG_FILE" >&2
    echo "Run: bin/viventium install" >&2
    exit 1
  fi
  if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_MODE:-}" != "quiesced" ]]; then
    if ! initialize_telegram_user_config_authority; then
      echo "Viventium start stopped before Telegram could select an ambiguous preference root." >&2
      return 1
    fi
  fi
  local core_surfaces_healthy=1
  if user_surface_healthy; then
    core_surfaces_healthy=0
    if runtime_optional_surfaces_healthy && postcommit_api_finalization_ready; then
      echo "Viventium is already running."
      return 0
    fi
  fi
  if detached_launch_process_group_running; then
    echo "Viventium is already starting."
    return 0
  fi
  if type runtime_start_claim_active >/dev/null 2>&1 && runtime_start_claim_active; then
    echo "Viventium is already starting."
    return 0
  fi
  if [[ "$core_surfaces_healthy" == "0" ]]; then
    echo "Viventium core surfaces are running, but enabled sidecars need startup. Repairing..."
  elif is_stack_running; then
    echo "Detected Viventium processes, but no healthy user-facing surface. Restarting the local stack..."
    stop_stack_for_upgrade
  fi

  local launch_log="$APP_SUPPORT_DIR/logs/helper-start.log"
  mkdir -p "$(dirname "$launch_log")"
  capture_detached_start_log_offset "$launch_log"
  local detached_repo_root="${VIVENTIUM_DETACHED_REPO_ROOT:-$REPO_ROOT}"
  local detached_lock_file="${VIVENTIUM_DETACHED_LOCK_FILE:-$LOCK_FILE}"
  local detached_runtime_profile="${VIVENTIUM_RUNTIME_PROFILE:-isolated}"
  local detached_state_root="$APP_SUPPORT_DIR/state/runtime/$detached_runtime_profile"
  local child_pid
  child_pid="$(
    "$PYTHON_BIN" - "$launch_log" "$detached_repo_root" "$APP_SUPPORT_DIR" "$CONFIG_FILE" "$RUNTIME_DIR" "$detached_lock_file" "$detached_state_root" "$detached_runtime_profile" "$@" <<'PY'
import os
import subprocess
import sys

launch_log, repo_root, app_support_dir, config_file, runtime_dir, lock_file, state_root, runtime_profile, *extra_args = sys.argv[1:]
env = os.environ.copy()
inherit_cli_lock = env.pop("VIVENTIUM_DETACHED_INHERIT_CLI_LOCK", "0") == "1"
if inherit_cli_lock:
    env["VIVENTIUM_CLI_LOCK_INHERITED_ONCE"] = "1"
else:
    env.pop("VIVENTIUM_CLI_LOCK_HELD", None)
    env.pop("VIVENTIUM_CLI_LOCK_DIR", None)
    env.pop("VIVENTIUM_CLI_LOCK_OWNER_PID", None)
env["VIVENTIUM_DETACHED_START"] = "1"
env["VIVENTIUM_BASE_STATE_DIR"] = os.path.join(app_support_dir, "state")
env["VIVENTIUM_STATE_ROOT"] = state_root
env["VIVENTIUM_RUNTIME_PROFILE"] = runtime_profile
compat_launcher = env.pop("VIVENTIUM_DETACHED_COMPAT_LAUNCHER", "").strip()
if compat_launcher:
    env["VIVENTIUM_LAUNCHER_INTERNAL"] = "1"
    env["VIVENTIUM_HELPER_V0_ROOT"] = os.path.join(repo_root, "viventium_v0_4")
    env["VIVENTIUM_HELPER_CORE_ROOT"] = repo_root
    env["VIVENTIUM_HELPER_WORKSPACE_ROOT"] = os.path.dirname(repo_root)
    env["VIVENTIUM_APP_SUPPORT_DIR"] = app_support_dir
    env["VIVENTIUM_ENV_FILE"] = os.path.join(runtime_dir, "runtime.env")
    env["VIVENTIUM_COMPONENTS_LOCK_FILE"] = lock_file
    cmd = ["/bin/bash", compat_launcher, "--restart", *extra_args]
else:
    cmd = [
        os.path.join(repo_root, "bin", "viventium"),
        "--app-support-dir",
        app_support_dir,
        "--config-file",
        config_file,
        "--runtime-dir",
        runtime_dir,
        "--lock-file",
        lock_file,
        "start",
        "--restart",
        *extra_args,
    ]

with open(launch_log, "ab", buffering=0) as log:
    proc = subprocess.Popen(
        cmd,
        cwd=repo_root,
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        close_fds=True,
        env=env,
    )
    print(proc.pid)
PY
  )"
  DETACHED_START_PID="$child_pid"
  echo "Launched Viventium in the background (pid $child_pid)."
}

format_install_wait_elapsed() {
  local total_seconds="${1:-0}"
  printf '%dm%02ds' "$((total_seconds / 60))" "$((total_seconds % 60))"
}

pid_is_running() {
  local pid="${1:-}"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  ps -p "$pid" >/dev/null 2>&1
}

docker_container_name_matches() {
  local pattern="${1:-}"
  [[ -n "$pattern" ]] || return 1
  command -v docker >/dev/null 2>&1 || return 1
  docker ps -a --format '{{.Names}}' 2>/dev/null | grep -Eq "$pattern"
}

docker_container_running_matches() {
  local pattern="${1:-}"
  [[ -n "$pattern" ]] || return 1
  command -v docker >/dev/null 2>&1 || return 1
  docker ps --format '{{.Names}}' 2>/dev/null | grep -Eq "$pattern"
}

docker_install_prewarm_running() {
  local service="${1:-}"
  local pid_file="$APP_SUPPORT_DIR/state/install/docker-prewarm-${service}.pid"
  local pid=""

  [[ -f "$pid_file" ]] || return 1
  pid="$(tr -d '\r\n' <"$pid_file" 2>/dev/null || true)"
  pid_is_running "$pid"
}

searxng_install_wait_label() {
  if docker_install_prewarm_running "searxng"; then
    printf '%s\n' "SearXNG local search (Docker image warmup)"
    return 0
  fi
  if docker_container_running_matches '^viventium_searxng(_redis)?$'; then
    printf '%s\n' "SearXNG local search (Docker container starting)"
    return 0
  fi
  if docker_container_name_matches '^viventium_searxng(_redis)?$'; then
    printf '%s\n' "SearXNG local search (Docker container created)"
    return 0
  fi
  printf '%s\n' "SearXNG local search"
}

firecrawl_install_wait_label() {
  if docker_install_prewarm_running "firecrawl"; then
    printf '%s\n' "Firecrawl local scraper (Docker image warmup)"
    return 0
  fi
  if docker_container_running_matches '^viventium_firecrawl_'; then
    printf '%s\n' "Firecrawl local scraper (Docker container starting)"
    return 0
  fi
  if docker_container_name_matches '^viventium_firecrawl_'; then
    printf '%s\n' "Firecrawl local scraper (Docker container created)"
    return 0
  fi
  printf '%s\n' "Firecrawl local scraper"
}

launch_log_indicates_startup_failure() {
  local launch_log="${1:-}"
  local start_offset="${2:-${DETACHED_START_LOG_OFFSET:-0}}"
  [[ -f "$launch_log" ]] || return 1
  [[ "$start_offset" =~ ^[0-9]+$ ]] || start_offset=0

  local tail_output=""
  tail_output="$(tail -c "+$((start_offset + 1))" "$launch_log" 2>/dev/null | tail -n 200 || true)"
  [[ -n "$tail_output" ]] || return 1

  # The launcher owns one clean-tree retry after a dependency install error.
  # Do not let the detached-start watcher abort that recovery path; the final
  # dependency check/install error remains in the stream and is terminal.
  tail_output="$({
    printf '%s\n' "$tail_output" |
      grep -vF '[viventium] LibreChat dependency install failed; cleaning dependency trees and retrying once...' ||
      true
  })"
  tail_output="$({
    printf '%s\n' "$tail_output" |
      grep -vF 'Remote access setup failed; local startup will continue without it:' ||
      true
  })"
  [[ -n "$tail_output" ]] || return 1

  if printf '%s\n' "$tail_output" | grep -Eq \
    '(\[viventium\].*(Failed|failed|ERROR|Error)|\[viventium\].*Docker is not running([.]|$| \(required for)|Failed to switch pnpm|spawnSync .*pnpm.* ENOENT|ERR_PNPM|Shutting down\.\.\.|error during build:|Build failed in|npm error Lifecycle script|Could not resolve .* from)'
  then
    return 0
  fi

  printf '%s\n' "$tail_output" | grep -Eq \
    '(\[viventium\].*(LibreChat ports? .*skipping startup|LibreChat port [0-9]+.*skipping startup|Port [0-9]+ in use - skipping LibreChat startup|Playground port [0-9]+.*skipping playground startup))'
}

launch_log_indicates_detached_submission() {
  local launch_log="${1:-}"
  local start_offset="${2:-${DETACHED_START_LOG_OFFSET:-0}}"
  [[ -f "$launch_log" ]] || return 1
  [[ "$start_offset" =~ ^[0-9]+$ ]] || start_offset=0

  tail -c "+$((start_offset + 1))" "$launch_log" 2>/dev/null |
    grep -F 'Detached Startup Submitted' >/dev/null
}

detached_start_failed_early() {
  local launch_log="${1:-}"

  # A required build can fail while optional sidecars or a wrapper process are
  # still alive. Explicit errors from this launch attempt are terminal and
  # must win over process-liveness signals.
  if launch_log_indicates_startup_failure "$launch_log"; then
    return 0
  fi

  # A detached launcher is intentionally finite: after it publishes the
  # submission marker, long-lived children and watchdogs own readiness. Its
  # clean wrapper exit must not roll a healthy-but-still-warming candidate
  # back. Explicit fatal evidence above remains authoritative.
  if launch_log_indicates_detached_submission "$launch_log"; then
    return 1
  fi

  if [[ -n "$DETACHED_START_PID" ]]; then
    if pid_is_running "$DETACHED_START_PID"; then
      return 1
    fi
    if detached_launch_process_group_running || is_stack_running || user_surface_healthy; then
      return 1
    fi
    return 0
  fi

  if detached_launch_process_group_running || is_stack_running || user_surface_healthy; then
    return 1
  fi
  return 0
}

install_waiting_on_surfaces() {
  local display_mode="${1:-verbose}"
  local api_port=""
  local frontend_port=""
  local playground_port=""
  local sandpack_port=""
  local waiting_on=()
  assign_runtime_ports api_port frontend_port playground_port sandpack_port

  if ! api_surface_healthy "$api_port"; then
    if [[ "$display_mode" == "compact" ]]; then
      waiting_on+=("API :$api_port")
    else
      waiting_on+=("LibreChat API :$api_port")
    fi
  fi
  if ! frontend_surface_healthy "$frontend_port"; then
    if [[ "$display_mode" == "compact" ]]; then
      waiting_on+=("Web :$frontend_port")
    else
      waiting_on+=("LibreChat Frontend :$frontend_port")
    fi
  fi
  if sandpack_runtime_required && ! sandpack_surface_healthy "$sandpack_port"; then
    if [[ "$display_mode" == "compact" ]]; then
      waiting_on+=("Artifacts :$sandpack_port")
    else
      waiting_on+=("Isolated browser runtime :$sandpack_port")
    fi
  fi
  if ! express_install_experience && ! playground_surface_healthy "$playground_port"; then
    if [[ "$display_mode" == "compact" ]]; then
      waiting_on+=("Playground :$playground_port")
    else
      waiting_on+=("Modern Playground :$playground_port")
    fi
  fi
  if runtime_env_true "START_SEARXNG" "false" && ! searxng_surface_healthy; then
    if [[ "$display_mode" == "compact" ]]; then
      waiting_on+=("SearXNG")
    else
      waiting_on+=("$(searxng_install_wait_label)")
    fi
  fi
  if runtime_env_true "START_FIRECRAWL" "false" && ! firecrawl_surface_healthy; then
    if [[ "$display_mode" == "compact" ]]; then
      waiting_on+=("Firecrawl")
    else
      waiting_on+=("$(firecrawl_install_wait_label)")
    fi
  fi
  if runtime_env_true "START_RAG_API" "false" && ! rag_api_surface_healthy; then
    waiting_on+=("Recall/RAG")
  fi
  if runtime_env_true "START_GOOGLE_MCP" "false" &&
    ! mcp_url_surface_reachable "GOOGLE_WORKSPACE_MCP_URL" "http://localhost:8111/mcp"
  then
    waiting_on+=("Google Workspace")
  fi
  if runtime_env_true "START_MS365_MCP" "false" &&
    ! mcp_url_surface_reachable "MS365_MCP_SERVER_URL" "http://localhost:6274/mcp"
  then
    waiting_on+=("Microsoft 365")
  fi
  if runtime_env_true "START_SCHEDULING_MCP" "false" && ! scheduling_surface_healthy; then
    waiting_on+=("Scheduling Cortex")
  fi
  if runtime_env_true "START_GLASSHIVE" "false" && ! glasshive_surface_healthy; then
    waiting_on+=("GlassHive")
  fi
  if runtime_env_true "START_PROMPT_WORKBENCH" "false" && ! prompt_workbench_surface_healthy; then
    waiting_on+=("Prompt Workbench")
  fi
  if runtime_env_true "START_CODE_INTERPRETER" "false" && ! code_interpreter_surface_healthy; then
    waiting_on+=("Code Interpreter")
  fi
  if runtime_env_true "START_SKYVERN" "false" && ! skyvern_surface_healthy; then
    waiting_on+=("Skyvern")
  fi
  if runtime_env_true "VIVENTIUM_VOICE_ENABLED" "false"; then
    if ! livekit_surface_healthy; then
      waiting_on+=("LiveKit")
    fi
    if ! voice_gateway_surface_healthy; then
      waiting_on+=("Voice Gateway")
    fi
  fi
  if runtime_env_true "START_TELEGRAM" "false" && ! telegram_bridge_surface_healthy; then
    waiting_on+=("Telegram")
  fi
  if runtime_env_true "START_TELEGRAM_CODEX" "false" && ! telegram_codex_surface_healthy; then
    waiting_on+=("Telegram Codex")
  fi
  if ! remote_tunnel_surface_healthy; then
    waiting_on+=("Remote access tunnel")
  fi

  if (( ${#waiting_on[@]} == 0 )); then
    printf '%s\n' "final health confirmation"
    return 0
  fi

  local formatted=""
  printf -v formatted '%s, ' "${waiting_on[@]}"
  printf '%s\n' "${formatted%, }"
}

install_wait_log_activity_summary() {
  local launch_log="${1:-}"
  [[ -f "$launch_log" ]] || return 0

  local cleaned_tail=""
  cleaned_tail="$(
    tail -n 240 "$launch_log" 2>/dev/null | \
      sed $'s/\033\\[[0-9;]*[[:alpha:]]//g'
  )"
  [[ -n "$cleaned_tail" ]] || return 0

  printf '%s\n' "$cleaned_tail" | awk '
    /Installing LibreChat dependencies/ { msg = "Installing LibreChat dependencies" }
    /Building LibreChat server packages for installer-managed runtime tasks/ { msg = "Preparing LibreChat runtime packages" }
    /Building LibreChat server packages/ { msg = "Building LibreChat server packages" }
    /Building LibreChat client package/ { msg = "Building LibreChat client package" }
    /Building LibreChat client bundle/ { msg = "Building LibreChat web app" }
    /Ensuring local conversation search is fully indexed/ { msg = "Indexing local conversation search" }
    /Starting LibreChat \(backend\+frontend\)/ { msg = "Starting LibreChat services" }
    /Server listening at http:\/\/localhost:[0-9]+/ { msg = "LibreChat API is responding" }
    /VITE v[0-9].*ready/ { msg = "LibreChat frontend is responding" }
    /Installing playground dependencies/ { msg = "Installing modern playground dependencies" }
    /Starting .*Playground/ { msg = "Starting modern playground" }
    /Playground pid:/ { msg = "Modern playground is starting" }
    /Installing voice gateway dependencies/ { msg = "Installing voice gateway dependencies" }
    /Starting Voice Gateway worker/ { msg = "Starting voice services" }
    /Detached launch is still waiting for parallel optional sidecars before exiting/ { msg = "Finalizing optional local sidecars" }
    END { print msg }
  '
}

install_wait_inline_enabled() {
  [[ "${HEADLESS:-0}" != "1" ]] || return 1
  [[ -t 1 ]] || return 1
  [[ "${TERM:-}" != "dumb" ]] || return 1
}

install_wait_spinner_frame() {
  local tick="${1:-0}"
  case $((tick % 4)) in
    0) printf '%s\n' '-' ;;
    1) printf '%s\n' '\' ;;
    2) printf '%s\n' '|' ;;
    *) printf '%s\n' '/' ;;
  esac
}

install_wait_pick_next_tagline() {
  local tick="${1:-0}"
  local count="${#INSTALL_WAIT_TAGLINES[@]}"
  if (( count == 0 )); then
    INSTALL_WAIT_TAGLINE=""
    INSTALL_WAIT_TAGLINE_INDEX=-1
    INSTALL_WAIT_TAGLINE_STARTED_TICK="$tick"
    return 1
  fi

  local next_index=0
  if (( count > 1 )); then
    next_index=$((RANDOM % count))
    if (( next_index == INSTALL_WAIT_TAGLINE_INDEX )); then
      next_index=$(((next_index + 1 + (RANDOM % (count - 1))) % count))
    fi
  fi

  INSTALL_WAIT_TAGLINE_INDEX="$next_index"
  INSTALL_WAIT_TAGLINE="${INSTALL_WAIT_TAGLINES[$next_index]}"
  INSTALL_WAIT_TAGLINE_STARTED_TICK="$tick"
}

install_wait_current_tagline() {
  local tick="${1:-0}"
  local destination="${2:-}"
  local enabled="${VIVENTIUM_INSTALL_FUN_TAGLINES:-1}"
  local chars_per_tick="${VIVENTIUM_INSTALL_TAGLINE_CHARS_PER_TICK:-10}"
  local hold_ticks="${VIVENTIUM_INSTALL_TAGLINE_HOLD_TICKS:-25}"
  case "$enabled" in
    0|false|FALSE|no|NO|off|OFF)
      return 0
      ;;
  esac

  if [[ ! "$chars_per_tick" =~ ^[0-9]+$ ]] || (( chars_per_tick < 1 )); then
    chars_per_tick=10
  fi
  if [[ ! "$hold_ticks" =~ ^[0-9]+$ ]] || (( hold_ticks < 0 )); then
    hold_ticks=25
  fi

  if [[ -z "$INSTALL_WAIT_TAGLINE" ]]; then
    install_wait_pick_next_tagline "$tick" || return 0
  fi

  local full_text="$INSTALL_WAIT_TAGLINE"
  local line_length="${#full_text}"
  if (( line_length == 0 )); then
    return 0
  fi

  local age_ticks=$((tick - INSTALL_WAIT_TAGLINE_STARTED_TICK))
  if (( age_ticks < 0 )); then
    age_ticks=0
  fi

  local typing_ticks=$(((line_length + chars_per_tick - 1) / chars_per_tick))
  if (( age_ticks >= typing_ticks + hold_ticks )); then
    install_wait_pick_next_tagline "$tick" || return 0
    full_text="$INSTALL_WAIT_TAGLINE"
    line_length="${#full_text}"
    age_ticks=0
  fi

  local visible_chars=$(((age_ticks + 1) * chars_per_tick))
  local rendered=""
  if (( visible_chars >= line_length )); then
    rendered="$full_text"
  else
    rendered="${full_text:0:visible_chars}_"
  fi

  if [[ -n "$destination" ]]; then
    printf -v "$destination" '%s' "$rendered"
    return 0
  fi

  printf '%s\n' "$rendered"
}

clear_install_wait_progress_frame() {
  if [[ "$INSTALL_WAIT_PROGRESS_ACTIVE" != "1" ]]; then
    printf '\r\033[2K'
    return 0
  fi

  printf '\r\033[2K'
  if (( INSTALL_WAIT_PROGRESS_LINES >= 2 )); then
    printf '\033[1A\r\033[2K'
  fi
}

render_install_wait_progress() {
  local elapsed="${1:-0}"
  local waiting_on="${2:-}"
  local launch_log="${3:-}"
  local current_step="${INSTALL_WAIT_CURRENT_STEP:-}"
  if [[ -z "$current_step" ]]; then
    current_step="$(install_wait_log_activity_summary "$launch_log" || true)"
  fi
  if [[ -z "$current_step" ]]; then
    current_step="Starting local services"
  fi

  if install_wait_inline_enabled; then
    local spinner=""
    local tagline=""
    local reset=$'\033[0m'
    local bold=$'\033[1m'
    local dim=$'\033[2m'
    local cyan=$'\033[36m'
    local yellow=$'\033[33m'
    local orange=$'\033[38;5;208m'
    local bright_white=$'\033[97m'
    local title=""
    local elapsed_label=""
    local step_label=""
    local waiting_label=""
    local tagline_label=""
    spinner="$(install_wait_spinner_frame "${INSTALL_WAIT_INLINE_TICK:-$elapsed}")"
    install_wait_current_tagline "${INSTALL_WAIT_INLINE_TICK:-0}" tagline
    title="${bold}${cyan}Starting Viventium${reset}"
    elapsed_label="${dim}$(format_install_wait_elapsed "$elapsed")${reset}"
    step_label="${bright_white}${current_step}${reset}"
    if [[ -n "$waiting_on" ]]; then
      waiting_label="${dim}Waiting for:${reset} ${yellow}${waiting_on}${reset}"
    fi
    if [[ -n "$tagline" ]]; then
      tagline_label="${dim}While you wait:${reset} ${orange}${tagline}${reset}"
    fi
    clear_install_wait_progress_frame
    printf '%s[%s%s%s]%s %s %s %s|%s %s' \
      "$dim" \
      "$cyan" \
      "$spinner" \
      "$dim" \
      "$reset" \
      "$title" \
      "$elapsed_label" \
      "$dim" \
      "$reset" \
      "$step_label"
    if [[ -n "$waiting_label" ]]; then
      printf ' %s|%s %s' "$dim" "$reset" "$waiting_label"
    fi
    if [[ -n "$tagline_label" ]]; then
      printf '\n\033[2K%s' "$tagline_label"
      INSTALL_WAIT_PROGRESS_LINES=2
    else
      INSTALL_WAIT_PROGRESS_LINES=1
    fi
    INSTALL_WAIT_PROGRESS_ACTIVE=1
    return 0
  fi

  local progress_message=""
  if [[ -n "$waiting_on" ]]; then
    progress_message="Still waiting for Viventium to finish starting ($(format_install_wait_elapsed "$elapsed") elapsed; current step: $current_step; waiting on: $waiting_on)."
  else
    progress_message="Still waiting for Viventium to finish starting ($(format_install_wait_elapsed "$elapsed") elapsed; current step: $current_step)."
  fi

  local repeat_interval="${VIVENTIUM_INSTALL_START_LOG_REPEAT_SECONDS:-60}"
  if [[ "$progress_message" != "$INSTALL_WAIT_LAST_MESSAGE" ]] ||
    (( elapsed - INSTALL_WAIT_LAST_MESSAGE_ELAPSED >= repeat_interval ))
  then
    echo "$progress_message"
    INSTALL_WAIT_LAST_MESSAGE="$progress_message"
    INSTALL_WAIT_LAST_MESSAGE_ELAPSED="$elapsed"
  fi
}

finish_install_wait_progress() {
  if install_wait_inline_enabled && [[ "$INSTALL_WAIT_PROGRESS_ACTIVE" == "1" ]]; then
    clear_install_wait_progress_frame
    printf '\n'
  fi
  INSTALL_WAIT_PROGRESS_ACTIVE=0
  INSTALL_WAIT_PROGRESS_LINES=0
  INSTALL_WAIT_LAST_MESSAGE=""
  INSTALL_WAIT_LAST_MESSAGE_ELAPSED=0
  INSTALL_WAIT_INLINE_TICK=0
  INSTALL_WAIT_CURRENT_STEP=""
  INSTALL_WAIT_TAGLINE_INDEX=-1
  INSTALL_WAIT_TAGLINE=""
  INSTALL_WAIT_TAGLINE_STARTED_TICK=0
}

install_first_run_build_expected() {
  local librechat_dir="$REPO_ROOT/viventium_v0_4/LibreChat"
  local playground_dir="$REPO_ROOT/viventium_v0_4/agent-starter-react"

  [[ -f "$librechat_dir/packages/api/dist/index.js" ]] || return 0
  [[ -f "$librechat_dir/packages/client/dist/index.js" ]] || return 0
  [[ -f "$librechat_dir/client/dist/index.html" ]] || return 0
  if ! express_install_experience && [[ ! -d "$playground_dir/node_modules" ]]; then
    return 0
  fi
  return 1
}

print_install_start_expectations() {
  local build_note_needed=0
  local docker_note_needed=0

  if install_first_run_build_expected; then
    build_note_needed=1
  fi
  if runtime_env_true "START_SEARXNG" "false" || runtime_env_true "START_FIRECRAWL" "false"; then
    docker_note_needed=1
  fi
  if [[ "$build_note_needed" != "1" && "$docker_note_needed" != "1" ]]; then
    return 0
  fi

  echo "Preparing first-run startup..."
  if [[ "$build_note_needed" == "1" ]]; then
    if express_install_experience; then
      echo "  - Building the Viventium web app locally. The deferred voice playground is not part of Easy Install startup."
    else
      echo "  - Building LibreChat and playground assets locally. On a clean Mac this can take around 10-15 minutes."
    fi
  fi
  if [[ "$docker_note_needed" == "1" ]]; then
    echo "  - Starting local web-search services in parallel through Docker Desktop."
  fi
}

print_install_timeout_log_excerpt() {
  local launch_log="${1:-}"
  local line_count="${2:-20}"
  [[ -f "$launch_log" ]] || return 0

  echo "Last lines from the detached start log:" >&2
  while IFS= read -r line; do
    echo "  $line" >&2
  done < <(tail -n "$line_count" "$launch_log")
}

wait_for_install_stack_health() {
  local timeout_seconds="${VIVENTIUM_INSTALL_START_HEALTH_TIMEOUT_SECONDS:-1800}"
  local poll_interval="${VIVENTIUM_INSTALL_START_POLL_SECONDS:-2}"
  local progress_interval="${VIVENTIUM_INSTALL_START_PROGRESS_SECONDS:-15}"
  local inline_render_interval="${VIVENTIUM_INSTALL_START_INLINE_PROGRESS_SECONDS:-0.2}"
  local inline_health_every_ticks=1
  local launch_log="$APP_SUPPORT_DIR/logs/helper-start.log"
  local deadline=$((SECONDS + timeout_seconds))
  local started_at="$SECONDS"
  local next_progress=$((SECONDS + progress_interval))
  local inline_progress=0
  local waiting_on="core service readiness"

  INSTALL_WAIT_CURRENT_STEP=""
  INSTALL_WAIT_INLINE_TICK=0

  if install_wait_inline_enabled; then
    if [[ ! "$inline_render_interval" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      inline_render_interval="0.2"
    fi
    inline_health_every_ticks="$(
      awk -v health="$poll_interval" -v render="$inline_render_interval" '
        BEGIN {
          if (render <= 0) {
            print 1
            exit
          }
          ticks = int((health / render) + 0.999)
          if (ticks < 1) {
            ticks = 1
          }
          print ticks
        }
      '
    )"
    if [[ ! "$inline_health_every_ticks" =~ ^[0-9]+$ ]] || (( inline_health_every_ticks < 1 )); then
      inline_health_every_ticks=1
    fi
    inline_progress=1
  fi

  while (( SECONDS < deadline )); do
    if [[ "$inline_progress" == "1" ]]; then
      if (( INSTALL_WAIT_INLINE_TICK % inline_health_every_ticks == 0 )); then
        if install_surfaces_healthy; then
          finish_install_wait_progress
          return 0
        fi
        if detached_start_failed_early "$launch_log"; then
          finish_install_wait_progress
          return 2
        fi
        waiting_on="$(install_waiting_on_surfaces compact || true)"
        if [[ -z "$waiting_on" ]]; then
          waiting_on="core service readiness"
        fi
        INSTALL_WAIT_CURRENT_STEP="$(install_wait_log_activity_summary "$launch_log" || true)"
      fi

      local elapsed="$((SECONDS - started_at))"
      render_install_wait_progress "$elapsed" "$waiting_on" "$launch_log"
      INSTALL_WAIT_INLINE_TICK=$((INSTALL_WAIT_INLINE_TICK + 1))
      sleep "$inline_render_interval"
      continue
    fi

    if install_surfaces_healthy; then
      finish_install_wait_progress
      return 0
    fi
    if detached_start_failed_early "$launch_log"; then
      finish_install_wait_progress
      return 2
    fi
    if [[ "$inline_progress" == "1" || SECONDS -ge next_progress ]]; then
      local elapsed="$((SECONDS - started_at))"
      local waiting_on=""
      if [[ "$inline_progress" == "1" ]]; then
        waiting_on="$(install_waiting_on_surfaces compact || true)"
      else
        waiting_on="$(install_waiting_on_surfaces verbose || true)"
      fi
      if [[ -z "$waiting_on" ]]; then
        waiting_on="core service readiness"
      fi
      render_install_wait_progress "$elapsed" "$waiting_on" "$launch_log"
      next_progress=$((SECONDS + progress_interval))
    fi
    sleep "$poll_interval"
  done

  finish_install_wait_progress
  return 1
}

start_stack_for_install() {
  local helper_grace_seconds="${VIVENTIUM_INSTALL_HELPER_GRACE_SECONDS:-8}"
  local helper_deadline=$((SECONDS + helper_grace_seconds))
  local launch_log="$APP_SUPPORT_DIR/logs/helper-start.log"
  local wait_status=0

  # Detached helper/launcher paths need their own CLI lock. Release the install
  # lock before we wait for helper auto-start or submit a detached launch.
  cleanup_cli_lock
  DETACHED_START_PID=""
  capture_detached_start_log_offset "$launch_log"

  if install_surfaces_healthy; then
    return 0
  fi

  print_install_start_expectations

  # Interactive macOS installs may have already launched the helper, which
  # auto-starts the stack. Give that path a brief window to claim startup
  # before submitting a detached launch ourselves.
  if [[ "$(uname -s)" == "Darwin" && "${HEADLESS:-0}" != "1" ]]; then
    while (( SECONDS < helper_deadline )); do
      if user_surface_healthy || is_stack_running; then
        break
      fi
      sleep 1
    done
  fi

  if ! user_surface_healthy && ! is_stack_running; then
    launch_stack_detached
  fi

  wait_for_install_stack_health
  wait_status=$?
  if [[ "$wait_status" == "0" ]]; then
    return 0
  fi

  local timeout_seconds="${VIVENTIUM_INSTALL_START_HEALTH_TIMEOUT_SECONDS:-1800}"
  local waiting_on=""
  local frontend_port=""
  waiting_on="$(install_waiting_on_surfaces || true)"
  if [[ -z "$waiting_on" ]]; then
    waiting_on="service readiness checks"
  fi
  assign_runtime_ports _ frontend_port _

  if [[ "$wait_status" == "2" ]]; then
    echo "Viventium stopped during startup before the required surfaces became healthy." >&2
  else
    echo "Viventium did not become healthy before the install start timeout (${timeout_seconds}s)." >&2
  fi
  echo "Still waiting on: $waiting_on" >&2
  if [[ -f "$launch_log" ]]; then
    echo "Check the detached start log: $launch_log" >&2
  fi
  print_install_timeout_log_excerpt "$launch_log"
  if [[ -n "$frontend_port" ]]; then
    echo "If package builds are still running, try again shortly at http://localhost:${frontend_port}." >&2
  fi
  return 1
}

wait_for_upgrade_runtime_health() {
  local timeout_seconds="${VIVENTIUM_UPGRADE_RUNTIME_HEALTH_TIMEOUT_SECONDS:-${VIVENTIUM_INSTALL_START_HEALTH_TIMEOUT_SECONDS:-1800}}"
  local poll_interval="${VIVENTIUM_INSTALL_START_POLL_SECONDS:-2}"
  local launch_log="$APP_SUPPORT_DIR/logs/helper-start.log"
  local deadline=$((SECONDS + timeout_seconds))

  while (( SECONDS < deadline )); do
    if install_surfaces_healthy &&
      runtime_optional_surfaces_healthy &&
      postcommit_api_finalization_ready
    then
      return 0
    fi
    if detached_start_failed_early "$launch_log"; then
      return 2
    fi
    sleep "$poll_interval"
  done
  return 1
}

wait_for_quiesced_runtime_health() {
  local timeout_seconds="${VIVENTIUM_UPGRADE_RUNTIME_HEALTH_TIMEOUT_SECONDS:-${VIVENTIUM_INSTALL_START_HEALTH_TIMEOUT_SECONDS:-1800}}"
  local poll_interval="${VIVENTIUM_INSTALL_START_POLL_SECONDS:-2}"
  local launch_log="$APP_SUPPORT_DIR/logs/helper-start.log"
  local deadline=$((SECONDS + timeout_seconds))

  while (( SECONDS < deadline )); do
    # Quiesced successor acceptance intentionally proves only the core
    # user-facing process artifact. Configured sidecars are held until the
    # outer transaction commits and are verified by the ordinary full-runtime
    # health gate during post-commit finalization.
    if install_surfaces_healthy; then
      return 0
    fi
    if detached_start_failed_early "$launch_log"; then
      return 2
    fi
    sleep "$poll_interval"
  done
  return 1
}

restart_quiesced_runtime_after_upgrade() {
  local launch_log="$APP_SUPPORT_DIR/logs/helper-start.log"
  local timeout_seconds="${VIVENTIUM_INSTALL_START_HEALTH_TIMEOUT_SECONDS:-1800}"
  local wait_status=0
  local waiting_on=""

  DETACHED_START_PID=""
  echo "Starting Viventium successor in protected validation mode..."
  VIVENTIUM_SUCCESSOR_VALIDATION_INTERNAL=1 \
    VIVENTIUM_SUCCESSOR_VALIDATION_MODE=quiesced \
    VIVENTIUM_SUCCESSOR_VALIDATION_DISABLED_WRITERS="$SUCCESSOR_VALIDATION_DISABLED_WRITERS" \
    VIVENTIUM_DETACHED_INHERIT_CLI_LOCK=1 \
    launch_stack_detached

  wait_for_quiesced_runtime_health
  wait_status=$?
  if [[ "$wait_status" == "0" ]]; then
    return 0
  fi

  waiting_on="$(install_waiting_on_surfaces || true)"
  [[ -n "$waiting_on" ]] || waiting_on="quiesced core readiness checks"
  if [[ "$wait_status" == "2" ]]; then
    echo "Viventium successor stopped during protected validation startup." >&2
  else
    echo "Viventium successor did not become healthy before the protected validation timeout (${timeout_seconds}s)." >&2
  fi
  echo "Still waiting on: $waiting_on" >&2
  if [[ -f "$launch_log" ]]; then
    echo "Check the detached start log: $launch_log" >&2
  fi
  print_install_timeout_log_excerpt "$launch_log"
  return 1
}

restart_stack_after_upgrade() {
  local launch_log="$APP_SUPPORT_DIR/logs/helper-start.log"
  local timeout_seconds="${VIVENTIUM_INSTALL_START_HEALTH_TIMEOUT_SECONDS:-1800}"
  local wait_status=0
  local waiting_on=""

  # Upgrade already refreshed components and regenerated runtime outputs.
  # Restart should hand off to the detached launcher path instead of keeping
  # the upgrade process attached to the long-lived stack owner.
  if [[ "${UPGRADE_TRANSACTION_ACTIVE:-0}" != "1" ]]; then
    cleanup_cli_lock
  fi
  DETACHED_START_PID=""

  if install_surfaces_healthy &&
    runtime_optional_surfaces_healthy &&
    postcommit_api_finalization_ready
  then
    return 0
  fi

  echo "Restarting Viventium..."
  VIVENTIUM_DETACHED_INHERIT_CLI_LOCK=1 launch_stack_detached

  wait_for_upgrade_runtime_health
  wait_status=$?
  if [[ "$wait_status" == "0" ]]; then
    return 0
  fi

  waiting_on="$(install_waiting_on_surfaces || true)"
  if [[ -z "$waiting_on" ]]; then
    waiting_on="service readiness checks"
  fi

  if [[ "$wait_status" == "2" ]]; then
    echo "Viventium stopped during restart before the required surfaces became healthy." >&2
  else
    echo "Viventium did not become healthy before the restart timeout (${timeout_seconds}s)." >&2
  fi
  echo "Still waiting on: $waiting_on" >&2
  if [[ -f "$launch_log" ]]; then
    echo "Check the detached start log: $launch_log" >&2
  fi
  print_install_timeout_log_excerpt "$launch_log"
  return 1
}

force_restart_stack_after_owner_env_alignment() {
  # The ordinary restart helper intentionally no-ops when surfaces are already
  # healthy. A preserved post-acceptance owner edit requires a real stop/start
  # so the running process loads the durable owner environment.
  if ! VIVENTIUM_DEV_RUNTIME_RECOVERY_INTERNAL=1 stop_stack_for_upgrade; then
    return 1
  fi
  set_helper_runtime_intent running
  VIVENTIUM_PRESERVE_HELPER_RUNTIME_INTENT=1 \
    VIVENTIUM_DEV_RUNTIME_RECOVERY_INTERNAL=1 restart_stack_after_upgrade
}

finalize_first_upgrade_bridge_after_commit() {
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/first_upgrade_bridge.py" \
    finalize-after-commit \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --config-file "$CONFIG_FILE" \
    --runtime-dir "$RUNTIME_DIR" \
    --lock-file "$LOCK_FILE" >/dev/null
}

finalize_quiesced_upgrade_session_after_commit() {
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/first_upgrade_bridge.py" \
    finalize-session-after-commit \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --config-file "$CONFIG_FILE" \
    --runtime-dir "$RUNTIME_DIR" \
    --lock-file "$LOCK_FILE" >/dev/null
}

validate_quiesced_upgrade_session_before_post_capture() {
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/first_upgrade_bridge.py" \
    validate-session \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --config-file "$CONFIG_FILE" \
    --runtime-dir "$RUNTIME_DIR" \
    --lock-file "$LOCK_FILE" >/dev/null
}

recover_pending_quiesced_upgrade_finalization() {
  local active_pointer="$APP_SUPPORT_DIR/state/upgrade-transaction-active.json"
  local session_state="$APP_SUPPORT_DIR/state/continuity/quiesced-upgrade-session.json"
  local bridge_state="$APP_SUPPORT_DIR/state/continuity/first-upgrade-bridge.json"
  if [[ "${VIVENTIUM_QUIESCED_FINALIZATION_INTERNAL:-0}" == "1" ]]; then
    return 0
  fi
  [[ ! -e "$active_pointer" ]] || return 0
  if [[ -e "$session_state" ]]; then
    finalize_quiesced_upgrade_session_after_commit
  fi
  if [[ -e "$bridge_state" ]]; then
    finalize_first_upgrade_bridge_after_commit
  fi
}

inherit_quiesced_successor_validation_if_active() {
  local active_pointer="$APP_SUPPORT_DIR/state/upgrade-transaction-active.json"
  local bridge_state="$APP_SUPPORT_DIR/state/continuity/first-upgrade-bridge.json"
  local session_state="$APP_SUPPORT_DIR/state/continuity/quiesced-upgrade-session.json"
  local inspection=""
  local status=""

  if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_MODE:-}" == "quiesced" ]]; then
    return 0
  fi
  if [[ ! -e "$active_pointer" ]] ||
    [[ ! -e "$bridge_state" && ! -e "$session_state" ]]
  then
    return 0
  fi
  inspection="$(
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/first_upgrade_bridge.py" \
      active-quiesced \
      --repo-root "$REPO_ROOT" \
      --app-support-dir "$APP_SUPPORT_DIR"
  )" || return 1
  status="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1]).get("status", ""))' \
      "$inspection"
  )" || return 1
  if [[ "$status" != "active" ]]; then
    return 0
  fi
  VIVENTIUM_SUCCESSOR_VALIDATION_INTERNAL=1
  VIVENTIUM_SUCCESSOR_VALIDATION_MODE=quiesced
  VIVENTIUM_SUCCESSOR_VALIDATION_DISABLED_WRITERS="$SUCCESSOR_VALIDATION_DISABLED_WRITERS"
  export VIVENTIUM_SUCCESSOR_VALIDATION_INTERNAL
  export VIVENTIUM_SUCCESSOR_VALIDATION_MODE
  export VIVENTIUM_SUCCESSOR_VALIDATION_DISABLED_WRITERS
}

inherit_pending_postcommit_finalization_if_needed() {
  local inspection=""
  local status=""
  local bridge_state="$APP_SUPPORT_DIR/state/continuity/first-upgrade-bridge.json"
  local session_state="$APP_SUPPORT_DIR/state/continuity/quiesced-upgrade-session.json"
  if [[ -n "${VIVENTIUM_POSTCOMMIT_FINALIZATION_ID:-}" ]]; then
    return 0
  fi
  if [[ ! -e "$bridge_state" && ! -e "$session_state" ]]; then
    return 0
  fi
  inspection="$(
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/first_upgrade_bridge.py" \
      pending-postcommit \
      --repo-root "$REPO_ROOT" \
      --app-support-dir "$APP_SUPPORT_DIR"
  )" || return 1
  status="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1]).get("status", ""))' \
      "$inspection"
  )" || return 1
  if [[ "$status" == "inactive" ]]; then
    return 0
  fi
  if [[ "$status" != "pending" ]]; then
    return 1
  fi
  VIVENTIUM_POSTCOMMIT_FINALIZATION_ID="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1]).get("runId", ""))' \
      "$inspection"
  )" || return 1
  VIVENTIUM_POSTCOMMIT_SOURCE_ID="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1]).get("sourceId", ""))' \
      "$inspection"
  )" || return 1
  local telegram_preference_root=""
  telegram_preference_root="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("telegramPreferenceRoot", ""))' \
      "$inspection"
  )" || return 1
  [[ "$VIVENTIUM_POSTCOMMIT_FINALIZATION_ID" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$VIVENTIUM_POSTCOMMIT_SOURCE_ID" =~ ^[0-9a-f]{40,64}$ ]] || return 1
  export VIVENTIUM_POSTCOMMIT_FINALIZATION_ID
  export VIVENTIUM_POSTCOMMIT_SOURCE_ID
  if [[ -n "$telegram_preference_root" ]]; then
    VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR="$telegram_preference_root"
    export VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR
  fi
}

finalize_deferred_uploads_after_upgrade_commit() {
  local legacy_root="$REPO_ROOT/viventium_v0_4/LibreChat/uploads"
  local canonical_root="$APP_SUPPORT_DIR/data/uploads"
  local migration_helper="$REPO_ROOT/scripts/viventium/uploads_migration.py"
  local migration_needed=0
  local stopped_for_migration=0

  migration_needed="$(
    "$PYTHON_BIN" - "$legacy_root" "$canonical_root" <<'PY'
import os
import stat
import sys
from pathlib import Path

legacy = Path(sys.argv[1])
canonical = Path(sys.argv[2])
try:
    legacy_meta = legacy.lstat()
except FileNotFoundError:
    print(0)
    raise SystemExit(0)
if stat.S_ISLNK(legacy_meta.st_mode) or not stat.S_ISDIR(legacy_meta.st_mode):
    print(0)
    raise SystemExit(0)
try:
    legacy_populated = next(os.scandir(legacy), None) is not None
except OSError:
    print(0)
    raise SystemExit(0)
try:
    canonical_meta = canonical.lstat()
except FileNotFoundError:
    canonical_populated = False
else:
    if stat.S_ISLNK(canonical_meta.st_mode) or not stat.S_ISDIR(canonical_meta.st_mode):
        print(0)
        raise SystemExit(0)
    canonical_populated = next(os.scandir(canonical), None) is not None
print(1 if legacy_populated and not canonical_populated else 0)
PY
  )"
  [[ "$migration_needed" == "1" ]] || return 0

  if [[ "${UPGRADE_TRANSACTION_WAS_RUNNING:-0}" == "1" ]]; then
    if ! stop_stack_for_upgrade; then
      echo "Committed upgrade could not stop writers for canonical uploads finalization." >&2
      return 1
    fi
    stopped_for_migration=1
  fi
  if ! "$PYTHON_BIN" "$migration_helper" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --librechat-dir "$REPO_ROOT/viventium_v0_4/LibreChat" \
    --canonical-root "$canonical_root" >/dev/null
  then
    echo "Committed upgrade kept the predecessor uploads tree because canonical migration failed." >&2
    if [[ "$stopped_for_migration" == "1" ]]; then
      set_helper_runtime_intent running
      restart_stack_after_upgrade || true
    fi
    return 1
  fi
  if [[ "$stopped_for_migration" == "1" ]]; then
    set_helper_runtime_intent running
    if ! restart_stack_after_upgrade; then
      echo "Uploads migration committed, but the validated runtime did not restart." >&2
      return 1
    fi
  fi
}

recover_running_stack_after_failed_upgrade() {
  local exit_status="${1:-$?}"

  # Prevent recursive signal/EXIT handling while rollback and recovery run.
  trap - EXIT INT TERM

  if [[ "$exit_status" -ne 0 && "${UPGRADE_TRANSACTION_ACTIVE:-0}" == "1" ]]; then
    echo "Upgrade did not complete. Restoring the verified pre-upgrade source, config, runtime, and stopped data checkpoint..." >&2
    if ! stop_stack_for_upgrade; then
      echo "Rollback paused because the changed runtime could not be stopped safely." >&2
      echo "The recovery transaction remains active at $(display_safe_path "$UPGRADE_TRANSACTION_DIR")." >&2
      cleanup_cli_lock
      exit "$exit_status"
    fi
    local telegram_recovery_ready=0
    local telegram_controller_ready=0
    local recovery_receipt_loaded=0
    local loaded_receipt_config_root=""
    if load_active_telegram_recovery_component \
      "upgrade" "$UPGRADE_TRANSACTION_DIR"
    then
      recovery_receipt_loaded=1
      loaded_receipt_config_root="$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT"
      telegram_controller_ready=1
    elif load_telegram_predecessor_recovery_component; then
      telegram_controller_ready=1
    else
      echo "Rollback paused because its sealed Telegram predecessor controller is unavailable." >&2
    fi
    if [[ "$telegram_controller_ready" == "1" ]] &&
      ! resume_telegram_user_config_migration_if_pending
    then
      echo "Rollback paused because its stopped-writer Telegram preference journal could not be completed." >&2
      telegram_controller_ready=0
    fi
    if [[ "$telegram_controller_ready" == "1" ]]; then
      TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
        resolve_predecessor_telegram_user_config_root "$REPO_ROOT"
      )" || TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT=""
      if [[ -n "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" ]] &&
        {
          [[ "$recovery_receipt_loaded" == "1" &&
            "$loaded_receipt_config_root" == "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" ]] ||
            {
              publish_active_telegram_recovery_component \
                "upgrade" "$UPGRADE_TRANSACTION_DIR" &&
                load_active_telegram_recovery_component \
                  "upgrade" "$UPGRADE_TRANSACTION_DIR"
            }
        }
      then
        telegram_recovery_ready=1
      else
        echo "Rollback paused because sealed Telegram recovery could not adopt the committed preference authority." >&2
      fi
    fi
    if [[ "$telegram_recovery_ready" != "1" ]]; then
      echo "The recovery transaction remains active at $(display_safe_path "$UPGRADE_TRANSACTION_DIR")." >&2
      cleanup_cli_lock
      exit "$exit_status"
    fi
    if upgrade_transaction_rollback &&
      verify_loaded_telegram_recovery_after_rollback \
        "upgrade" "$UPGRADE_TRANSACTION_DIR"
    then
      if [[ "${UPGRADE_TRANSACTION_WAS_RUNNING:-0}" == "1" ]]; then
        # The internal upgrade stop deliberately suppresses helper relaunches by
        # persisting "stopped". Restore the user's prior running intent before
        # handing the verified predecessor back to detached supervision.
        set_helper_runtime_intent running
        if [[ "$telegram_recovery_ready" == "1" ]] &&
          VIVENTIUM_DETACHED_COMPAT_LAUNCHER="$STAGED_TELEGRAM_COMPAT_LAUNCHER" \
          VIVENTIUM_TELEGRAM_COMPONENT_SELECTION_FILE="$STAGED_TELEGRAM_RECOVERY_SELECTION" \
          VIVENTIUM_TELEGRAM_COMPONENT_TOOL="$STAGED_TELEGRAM_COMPONENT_TOOL" \
          VIVENTIUM_TELEGRAM_POLLER_HANDOFF_HELPER="$STAGED_TELEGRAM_HANDOFF_HELPER" \
          VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR="${TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT:-$APP_SUPPORT_DIR/state/telegram-user-configs}" \
          restart_stack_after_upgrade
        then
          echo "The previous verified Viventium runtime and running state were restored." >&2
        else
          echo "The previous on-disk state was restored, but automatic restart failed. Run: bin/viventium launch" >&2
        fi
      else
        echo "The previous verified Viventium on-disk state was restored and remains stopped." >&2
      fi
      launch_macos_helper_app || true
    else
      echo "Rollback failed closed before exposing an unverified recovery runtime. The recovery transaction remains active." >&2
      echo "Resolve the reported local-state conflict, then rerun bin/viventium upgrade." >&2
    fi
  fi

  cleanup_cli_lock
  exit "$exit_status"
}

upgrade_transaction_active_info() {
  "${UPGRADE_TRANSACTION_PYTHON:-$PYTHON_BIN}" "$REPO_ROOT/scripts/viventium/upgrade_transaction.py" active \
    --app-support-dir "$APP_SUPPORT_DIR"
}

upgrade_transaction_begin() {
  local target_head="${1:-}"
  local args=(
    begin
    --repo-root "$REPO_ROOT"
    --app-support-dir "$APP_SUPPORT_DIR"
    --config-file "$CONFIG_FILE"
    --runtime-dir "$RUNTIME_DIR"
    --lock-file "$LOCK_FILE"
    --telegram-preference-root "${TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT:-}"
    --was-running "$([[ "${UPGRADE_STACK_WAS_RUNNING:-0}" == "1" ]] && printf true || printf false)"
  )
  if [[ -n "$target_head" ]]; then
    args+=(--target-head "$target_head")
  fi
  if [[ "${ALLOW_DIRTY:-0}" == "1" ]]; then
    args+=(--allow-dirty-parent)
  fi
  local result=""
  UPGRADE_TRANSACTION_PYTHON="$PYTHON_BIN"
  result="$("$UPGRADE_TRANSACTION_PYTHON" "$REPO_ROOT/scripts/viventium/upgrade_transaction.py" "${args[@]}")"
  UPGRADE_TRANSACTION_DIR="$(
    "$UPGRADE_TRANSACTION_PYTHON" -c 'import json,sys; print(json.loads(sys.argv[1])["transaction_path"])' "$result"
  )"
  UPGRADE_TRANSACTION_RUNNER="$(
    "$UPGRADE_TRANSACTION_PYTHON" -c 'import json,sys; print(json.loads(sys.argv[1])["transaction_runner"])' "$result"
  )"
  UPGRADE_TRANSACTION_WAS_RUNNING="${UPGRADE_STACK_WAS_RUNNING:-0}"
  UPGRADE_TRANSACTION_ACTIVE=1
}

upgrade_transaction_snapshot_stopped_state() {
  "$UPGRADE_TRANSACTION_PYTHON" "$UPGRADE_TRANSACTION_RUNNER" snapshot-stopped-state \
    --transaction "$UPGRADE_TRANSACTION_DIR" >/dev/null
}

upgrade_transaction_prepare_candidate() {
  local result=""
  result="$(
    "$UPGRADE_TRANSACTION_PYTHON" "$UPGRADE_TRANSACTION_RUNNER" prepare-candidate \
      --transaction "$UPGRADE_TRANSACTION_DIR"
  )"
  UPGRADE_CANDIDATE_CONFIG="$(
    "$UPGRADE_TRANSACTION_PYTHON" -c 'import json,sys; print(json.loads(sys.argv[1])["config_file"])' "$result"
  )"
  UPGRADE_CANDIDATE_RUNTIME="$(
    "$UPGRADE_TRANSACTION_PYTHON" -c 'import json,sys; print(json.loads(sys.argv[1])["runtime_dir"])' "$result"
  )"
}

upgrade_transaction_checkpoint() {
  local stage="$1"
  "$UPGRADE_TRANSACTION_PYTHON" "$UPGRADE_TRANSACTION_RUNNER" checkpoint \
    --transaction "$UPGRADE_TRANSACTION_DIR" \
    --stage "$stage" >/dev/null
}

upgrade_transaction_activate_candidate() {
  "$UPGRADE_TRANSACTION_PYTHON" "$UPGRADE_TRANSACTION_RUNNER" activate-candidate \
    --transaction "$UPGRADE_TRANSACTION_DIR" >/dev/null
}

upgrade_transaction_rollback() {
  local result=""
  result="$(
    "$UPGRADE_TRANSACTION_PYTHON" "$UPGRADE_TRANSACTION_RUNNER" rollback \
      --transaction "$UPGRADE_TRANSACTION_DIR"
  )" || return 1
  UPGRADE_TRANSACTION_ACTIVE=0
  return 0
}

upgrade_transaction_commit() {
  "$UPGRADE_TRANSACTION_PYTHON" "$UPGRADE_TRANSACTION_RUNNER" commit \
    --transaction "$UPGRADE_TRANSACTION_DIR" >/dev/null
  UPGRADE_TRANSACTION_ACTIVE=0
  install_cli_lock_traps
}

recover_interrupted_upgrade_transaction() {
  local active_info=""
  local active_status=""
  local recovery_receipt_loaded=0
  local loaded_receipt_config_root=""
  active_info="$(upgrade_transaction_active_info)" || {
    local status=$?
    if [[ "$status" == "1" ]]; then
      return 0
    fi
    echo "Upgrade cannot continue because the prior transaction pointer is unreadable or unsafe." >&2
    exit "$status"
  }
  UPGRADE_TRANSACTION_DIR="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1])["transaction_path"])' "$active_info"
  )"
  UPGRADE_TRANSACTION_PYTHON="$PYTHON_BIN"
  UPGRADE_TRANSACTION_RUNNER="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1])["transaction_runner"])' "$active_info"
  )"
  UPGRADE_TRANSACTION_WAS_RUNNING="$(
    "$PYTHON_BIN" -c 'import json,sys; print(1 if json.loads(sys.argv[1])["was_running"] else 0)' "$active_info"
  )"
  active_status="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1])["status"])' "$active_info"
  )"
  TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("telegram_preference_root", ""))' \
      "$active_info"
  )" || exit 1
  UPGRADE_TRANSACTION_ACTIVE=1
  if [[ "$active_status" == "committed" ]]; then
    echo "A committed upgrade left a recovery pointer. Completing its idempotent cleanup..." >&2
    if ! upgrade_transaction_commit; then
      echo "The committed upgrade cleanup could not be completed safely." >&2
      exit 1
    fi
    return 0
  fi
  if [[ "$active_status" == "rolled_back" ]]; then
    echo "A rolled-back upgrade left a recovery pointer. Completing its idempotent cleanup..." >&2
    if ! upgrade_transaction_rollback; then
      echo "The rolled-back upgrade cleanup could not be completed safely." >&2
      exit 1
    fi
    return 0
  fi
  echo "An interrupted upgrade was found. Recovering its verified pre-upgrade checkpoint before any new mutation..." >&2
  if ! stop_stack_for_upgrade; then
    echo "Interrupted-upgrade recovery stopped because the current runtime could not be drained safely." >&2
    exit 1
  fi
  if load_active_telegram_recovery_component \
    "upgrade" "$UPGRADE_TRANSACTION_DIR"
  then
    recovery_receipt_loaded=1
    loaded_receipt_config_root="$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT"
  else
    if [[ -z "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" ]]; then
      TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
        resolve_predecessor_telegram_user_config_root "$REPO_ROOT"
      )"
    fi
    if ! load_telegram_predecessor_recovery_component; then
      if ! stage_telegram_runtime_component "$REPO_ROOT" ||
        ! load_telegram_predecessor_recovery_component
      then
        local active_recovery_receipt=""
        local pending_telegram_migration="$APP_SUPPORT_DIR/state/telegram-user-config-migration/pending.json"
        active_recovery_receipt="$(active_telegram_recovery_selection_file)"
        if [[ ! -e "$active_recovery_receipt" &&
          ! -L "$active_recovery_receipt" &&
          ! -e "$pending_telegram_migration" &&
          ! -L "$pending_telegram_migration" ]]
        then
          echo "Interrupted-upgrade recovery could not seal a Telegram compatibility component; restoring the verified core checkpoint in stopped mode." >&2
          set_helper_runtime_intent stopped
          if upgrade_transaction_rollback; then
            set_helper_runtime_intent stopped
            echo "The verified pre-upgrade source and state were restored and remain stopped. Run bin/viventium launch from the restored checkout." >&2
            cleanup_cli_lock
            exit 4
          fi
        fi
        echo "Interrupted-upgrade recovery could not seal a Telegram predecessor component before rollback." >&2
        exit 1
      fi
    fi
  fi
  if ! resume_telegram_user_config_migration_if_pending; then
    echo "Interrupted-upgrade recovery could not complete its stopped-writer Telegram preference journal." >&2
    echo "The upgrade transaction remains active and no rollback mutation was attempted." >&2
    exit 1
  fi
  # The transaction records the root observed before shutdown. A crash can
  # occur after migration commits a newer canonical/custom authority but
  # before the passive recovery receipt is refreshed, so always reconcile
  # against the durable root-selection authority before rollback/restart.
  TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
    resolve_predecessor_telegram_user_config_root "$REPO_ROOT"
  )" || exit 1
  if [[ "$recovery_receipt_loaded" != "1" ||
    "$loaded_receipt_config_root" != "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" ]]
  then
    if ! publish_active_telegram_recovery_component \
      "upgrade" "$UPGRADE_TRANSACTION_DIR" ||
      ! load_active_telegram_recovery_component \
        "upgrade" "$UPGRADE_TRANSACTION_DIR"
    then
      echo "Interrupted-upgrade recovery could not bind sealed recovery to the committed Telegram preference authority." >&2
      exit 1
    fi
    recovery_receipt_loaded=1
    loaded_receipt_config_root="$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT"
  fi
  if ! upgrade_transaction_rollback; then
    echo "Interrupted-upgrade rollback refused to overwrite unrecognized local work." >&2
    exit 1
  fi
  if [[ "$recovery_receipt_loaded" == "1" ]]; then
    if ! verify_loaded_telegram_recovery_after_rollback \
      "upgrade" "$UPGRADE_TRANSACTION_DIR"
    then
      echo "Interrupted-upgrade rollback could not verify its sealed Telegram recovery receipt." >&2
      exit 1
    fi
  else
    echo "Interrupted-upgrade rollback completed without a validated Telegram recovery receipt." >&2
    exit 1
  fi
  if [[ "$UPGRADE_TRANSACTION_WAS_RUNNING" == "1" ]]; then
    set_helper_runtime_intent running
    if ! VIVENTIUM_DETACHED_COMPAT_LAUNCHER="$STAGED_TELEGRAM_COMPAT_LAUNCHER" \
      VIVENTIUM_TELEGRAM_COMPONENT_SELECTION_FILE="$STAGED_TELEGRAM_RECOVERY_SELECTION" \
      VIVENTIUM_TELEGRAM_COMPONENT_TOOL="$STAGED_TELEGRAM_COMPONENT_TOOL" \
      VIVENTIUM_TELEGRAM_POLLER_HANDOFF_HELPER="$STAGED_TELEGRAM_HANDOFF_HELPER" \
      VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR="${TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT:-$APP_SUPPORT_DIR/state/telegram-user-configs}" \
      restart_stack_after_upgrade
    then
      echo "The interrupted upgrade was rolled back, but the prior runtime did not restart." >&2
      exit 1
    fi
  fi
  echo "Interrupted upgrade rolled back successfully. Rerun the upgrade command to start a new transaction." >&2
  cleanup_cli_lock
  exit 4
}

recover_interrupted_upgrade_before_runtime_start() {
  if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_INTERNAL:-0}" == "1" ]] ||
    [[ "${UPGRADE_TRANSACTION_ACTIVE:-0}" == "1" ]]
  then
    return 0
  fi
  recover_interrupted_upgrade_transaction
}

stop_stack_for_upgrade() {
  "$REPO_ROOT/bin/viventium" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --config-file "$CONFIG_FILE" \
    --runtime-dir "$RUNTIME_DIR" \
    --lock-file "$LOCK_FILE" \
    stop
}

stop_native_stack_detached() {
  local stop_log="$APP_SUPPORT_DIR/logs/native-stop.log"
  mkdir -p "$(dirname "$stop_log")"
  local child_pid=""
  child_pid="$(
    "$PYTHON_BIN" - "$stop_log" "$REPO_ROOT" <<'PY'
import os
import subprocess
import sys

stop_log, repo_root = sys.argv[1:]
env = os.environ.copy()

cmd = [
    os.path.join(repo_root, "scripts", "viventium", "native_stack.sh"),
    "stop",
]

with open(stop_log, "ab", buffering=0) as log:
    proc = subprocess.Popen(
        cmd,
        cwd=repo_root,
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        close_fds=True,
        env=env,
    )
    print(proc.pid)
PY
  )"
  echo "[viventium] Native runtime cleanup continuing in background (pid ${child_pid}, log: ${stop_log})"
}

ensure_supported_upgrade_predecessor() {
  local policy="$REPO_ROOT/release/upgrade-support.json"
  [[ -f "$policy" ]] || return 0
  if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/upgrade_support.py" \
    --repo-root "$REPO_ROOT" \
    --policy "$policy" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --runtime-dir "$RUNTIME_DIR"; then
    echo "This install is outside the reviewed universal-upgrade range." >&2
    echo "Create a supported backup/restore transfer or upgrade through a reviewed intermediate release." >&2
    return 1
  fi
}

repair_shallow_upgrade_history() {
  local shallow=""
  shallow="$(git -C "$REPO_ROOT" rev-parse --is-shallow-repository 2>/dev/null || true)"
  [[ "$shallow" == "true" ]] || return 0

  local current_branch=""
  local configured_remote=""
  local merge_ref=""
  current_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD)"
  configured_remote="$(git -C "$REPO_ROOT" config --get "branch.${current_branch}.remote" || true)"
  merge_ref="$(git -C "$REPO_ROOT" config --get "branch.${current_branch}.merge" || true)"
  if [[ -z "$configured_remote" || "$merge_ref" != refs/heads/* ]]; then
    echo "Upgrade cannot repair this legacy shallow checkout without its configured remote branch." >&2
    return 1
  fi

  echo "Retrieving Viventium upgrade history for this legacy shallow checkout..."
  if ! git -C "$REPO_ROOT" fetch --unshallow "$configured_remote" "$merge_ref" >/dev/null; then
    echo "Upgrade could not retrieve the history required to validate this checkout." >&2
    echo "Restore network access to '$configured_remote' and retry; no working-tree or runtime changes were made." >&2
    return 1
  fi
}

ensure_upgradeable_git_state() {
  local allow_dirty="${1:-0}"
  local require_remote="${2:-1}"
  local git_root
  git_root="$(git -C "$REPO_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$git_root" ]]; then
    echo "Upgrade requires a git checkout: $REPO_ROOT" >&2
    exit 1
  fi

  local current_branch
  current_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD)"
  if [[ -z "$current_branch" || "$current_branch" == "HEAD" ]]; then
    echo "Upgrade requires a named branch checkout, not detached HEAD." >&2
    exit 1
  fi

  if [[ "$require_remote" == "1" ]]; then
    local configured_remote=""
    local merge_ref=""
    configured_remote="$(git -C "$REPO_ROOT" config --get "branch.${current_branch}.remote" || true)"
    merge_ref="$(git -C "$REPO_ROOT" config --get "branch.${current_branch}.merge" || true)"
    if [[ -z "$configured_remote" || "$merge_ref" != refs/heads/* ]]; then
      echo "Upgrade refused because the current branch has no configured Git remote branch." >&2
      echo "Configure its upstream, or use --skip-pull for an intentional local-only refresh." >&2
      exit 1
    fi
  fi

  # Parent tracked/untracked state is classified once by upgrade_check.py so managed
  # nested component directories are not mistaken for unrelated parent user work.
  # Keep the argument in this gate's interface because the structured check applies it.
  : "$allow_dirty"
}

ensure_local_checkout_alignment() {
  local allow_dirty="${1:-0}"
  local expected_config_sha256="${2:-}"
  local check_args=(
    --repo-root "$REPO_ROOT"
    --app-support-dir "$APP_SUPPORT_DIR"
    --no-fetch
    --json
  )
  if [[ -f "$CONFIG_FILE" ]]; then
    check_args+=(--config-file "$CONFIG_FILE")
  fi
  if [[ -n "$expected_config_sha256" ]]; then
    check_args+=(--expected-config-sha256 "$expected_config_sha256")
  fi
  if [[ "$allow_dirty" == "1" ]]; then
    check_args+=(--allow-dirty-parent)
  fi

  local report=""
  local status=0
  report="$("$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/upgrade_check.py" "${check_args[@]}")" ||
    status=$?
  if [[ "$status" -eq 0 ]]; then
    return 0
  fi

  "$PYTHON_BIN" - "$report" <<'PY' >&2
import json
import sys

try:
    report = json.loads(sys.argv[1])
except (IndexError, json.JSONDecodeError):
    print("Local checkout safety inspection did not return readable status.")
    raise SystemExit(0)

for blocker in report.get("blockers", []):
    print(f"Local checkout blocker: {blocker}")
for item in report.get("component_lock_drift", []):
    if not isinstance(item, dict):
        continue
    name = str(item.get("name") or "managed component")
    status = str(item.get("status") or "unsafe")
    print(f"Managed component blocker: {name} ({status})")
PY
  return "$status"
}

prove_fresh_dev_runtime_activation() {
  "$PYTHON_BIN" - "$APP_SUPPORT_DIR" "$CONFIG_FILE" "$RUNTIME_DIR" "$CLI_LOCK_DIR" <<'PY'
import os
import sys
from pathlib import Path

app_support = Path(os.path.abspath(os.path.expanduser(sys.argv[1])))
config = Path(os.path.abspath(os.path.expanduser(sys.argv[2])))
runtime = Path(os.path.abspath(os.path.expanduser(sys.argv[3])))
cli_lock = Path(os.path.abspath(os.path.expanduser(sys.argv[4])))

for path in (
    config,
    app_support / "helper-config.json",
    app_support / "state" / "install-ownership.json",
    app_support / "state" / "runtime-checkout.json",
):
    if path.exists() or path.is_symlink():
        raise SystemExit(1)

for root in (
    runtime,
    app_support / "data",
    app_support / "state",
):
    if not root.exists() and not root.is_symlink():
        continue
    if root.is_symlink() or not root.is_dir():
        raise SystemExit(1)
    for current, directories, files in os.walk(
        root,
        topdown=True,
        followlinks=False,
    ):
        current_path = Path(current)
        directories[:] = [
            name
            for name in directories
            if current_path / name != cli_lock
        ]
        for name in directories:
            if (current_path / name).is_symlink():
                raise SystemExit(1)
        if files:
            raise SystemExit(1)
raise SystemExit(0)
PY
}


resolve_dev_runtime_librechat_owner_env_source() {
  local previous_repo="${1:-}"
  local established_runtime="${2:-0}"
  local candidate_env="$REPO_ROOT/viventium_v0_4/LibreChat/.env"
  local previous_env=""
  if [[ -n "$previous_repo" ]]; then
    previous_env="$previous_repo/viventium_v0_4/LibreChat/.env"
  fi

  if [[ "$established_runtime" == "1" ]]; then
    if [[ ! -e "$previous_env" && ! -L "$previous_env" ]]; then
      echo "Established runtime has no provable LibreChat owner environment." >&2
      return 1
    fi
    if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" inspect \
      --source "$previous_env" >/dev/null
    then
      echo "Established LibreChat owner environment is unsafe or unreadable." >&2
      return 1
    fi
    printf '%s\n' "$previous_env"
    return 0
  fi

  local explicit_env="${VIVENTIUM_LIBRECHAT_CANONICAL_ENV_FILE:-}"
  local private_env=""
  if [[ -n "$PRIVATE_CURATED_DIR_DEFAULT" ]]; then
    private_env="$PRIVATE_CURATED_DIR_DEFAULT/configs/librechat/librechat.env"
  fi
  local source=""
  for source in "$explicit_env" "$private_env" "$candidate_env"; do
    [[ -n "$source" ]] || continue
    if [[ ! -e "$source" && ! -L "$source" ]]; then
      continue
    fi
    if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" inspect \
      --source "$source" >/dev/null
    then
      echo "LibreChat owner environment is unsafe or unreadable." >&2
      return 1
    fi
    printf '%s\n' "$source"
    return 0
  done
  return 0
}

fetch_current_branch_target() {
  local current_branch
  local configured_remote
  local merge_ref
  current_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD)"
  configured_remote="$(git -C "$REPO_ROOT" config --get "branch.${current_branch}.remote" || true)"
  merge_ref="$(git -C "$REPO_ROOT" config --get "branch.${current_branch}.merge" || true)"
  if [[ -z "$configured_remote" ]]; then
    echo "Upgrade requires the current branch to have a configured Git remote." >&2
    return 1
  fi
  if [[ "$merge_ref" != refs/heads/* ]]; then
    echo "Upgrade requires the current branch to track a normal remote branch." >&2
    return 1
  fi
  git -C "$REPO_ROOT" fetch "$configured_remote" "$merge_ref" >/dev/null
  git -C "$REPO_ROOT" rev-parse --verify FETCH_HEAD
}

fast_forward_current_branch_to_target() {
  local target_head="$1"
  if [[ -z "$target_head" ]]; then
    echo "Upgrade target commit is missing after fetch." >&2
    return 1
  fi
  git -C "$REPO_ROOT" merge --ff-only "$target_head"
}

capture_agent_source_ref() {
  local source_json=""
  source_json="$(
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/agent_migration_state.py" source-ref \
      --repo-root "$REPO_ROOT"
  )" || return 1
  "$PYTHON_BIN" -c '
import json, re, sys
value = str(json.loads(sys.argv[1]).get("source_ref") or "")
if not re.fullmatch(r"[a-f0-9]{40}", value):
    raise SystemExit("Upgrade source identity is invalid.")
print(value, end="")
' "$source_json"
}

ensure_no_pending_agent_migration() {
  local pending_state="$APP_SUPPORT_DIR/state/runtime/agent-managed-migration-pending.json"
  if [[ -e "$pending_state" || -L "$pending_state" ]]; then
    echo "Upgrade refused because the prior managed-agent migration has not finished." >&2
    echo "Run bin/viventium start to finish it, then retry the upgrade." >&2
    return 1
  fi
}

prepare_agent_migration_state() {
  local predecessor_ref="$1"
  local successor_ref="$2"
  if [[ "$predecessor_ref" == "$successor_ref" ]]; then
    return 0
  fi
  local transaction_id="${UPGRADE_TRANSACTION_DIR##*/}"
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/agent_migration_state.py" prepare \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --predecessor-ref "$predecessor_ref" \
    --successor-ref "$successor_ref" \
    --transaction-id "$transaction_id" >/dev/null
}

if [[ $# -gt 0 ]]; then
  PARSED_ARGS=()
  parse_global_options "$@"
  set -- "${PARSED_ARGS[@]}"
fi

COMMAND="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$COMMAND" in
  restore)
    PYTHON_BIN="${VIVENTIUM_PYTHON_BIN:-$(command -v python3)}"
    export PYTHON_BIN
    ;;
  upgrade|update)
    # Register and checkpoint the upgrade before its candidate requirements can
    # mutate the product-owned bootstrap environment. Reuse the already prepared
    # product Python when it exists; do not fall back to an incomplete system
    # Python merely because refresh is intentionally deferred.
    if ! PYTHON_BIN="$(resolve_upgrade_transaction_python)"; then
      echo "Upgrade needs the existing Viventium Python environment with its installer requirements." >&2
      echo "Run bin/viventium preflight --apply, then retry the upgrade." >&2
      exit 1
    fi
    export PYTHON_BIN
    ;;
  *) refresh_repo_python ;;
esac
maybe_reexec_active_runtime_checkout "$COMMAND" "$@"

case "$COMMAND" in
  install|bootstrap)
    acquire_cli_lock "$COMMAND"
    AUTO_START=1
    CONFIG_INPUT=""
    HEADLESS=0
    INSTALL_ARGS=()
    CURRENT_INSTALL_STAGE="configure"
    INSTALL_TRAP_ACTIVE=1
    trap 'install_status=$?; if [[ "${INSTALL_TRAP_ACTIVE:-0}" == "1" && "$install_status" -ne 0 ]]; then drain_failed_install_runtime || true; rollback_config_candidate || true; write_install_stage "$CURRENT_INSTALL_STAGE"; print_install_recovery_guidance "$CURRENT_INSTALL_STAGE"; fi; cleanup_config_candidate || true; cleanup_cli_lock || true; exit "$install_status"' EXIT
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage install
      exit 0
    fi
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --no-start)
          AUTO_START=0
          shift
          ;;
        --headless|--non-interactive)
          HEADLESS=1
          shift
          ;;
        --config-input|--preset|--config)
          if [[ $# -lt 2 ]]; then
            echo "Missing value for $1" >&2
            exit 1
          fi
          CONFIG_INPUT="$2"
          shift 2
          ;;
        *)
          INSTALL_ARGS+=("$1")
          shift
          ;;
      esac
    done
    if [[ "$HEADLESS" != "1" ]]; then
      reattach_stdin_from_tty_if_available || true
    fi
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    RECOVERY_ACTION="resume"
    if [[ -z "$CONFIG_INPUT" ]]; then
      PRIOR_INSTALL_STAGE="$(read_install_stage)"
      if [[ -n "$PRIOR_INSTALL_STAGE" && -f "$CONFIG_FILE" ]]; then
        RECOVERY_ACTION="$(prompt_install_recovery_action "$PRIOR_INSTALL_STAGE")"
        case "$RECOVERY_ACTION" in
          reconfigure)
            echo "Re-running installer setup with the current app support location." >&2
            ;;
          start-over)
            BACKUP_CONFIG_PATH="$(backup_existing_install_config)"
            if [[ -n "$BACKUP_CONFIG_PATH" ]]; then
              echo "Backed up the previous config to $BACKUP_CONFIG_PATH" >&2
            fi
            rm -f "$CONFIG_FILE"
            rm -rf "$RUNTIME_DIR"
            clear_install_stage
            ;;
          *)
            echo "Resuming with the current installer choices." >&2
            ;;
        esac
      fi
    fi
    if [[ ! -f "$CONFIG_FILE" || -n "$CONFIG_INPUT" || "$RECOVERY_ACTION" == "reconfigure" ]]; then
      write_install_stage "configure"
      if [[ -n "$CONFIG_INPUT" ]]; then
        prepare_config_candidate "$CONFIG_INPUT"
        apply_config_candidate
      elif [[ "$HEADLESS" == "1" ]]; then
        echo "install --headless requires --preset/--config-input/--config <file>" >&2
        exit 1
      else
        WIZARD_ARGS=(--output "$CONFIG_FILE")
        "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/wizard.py" "${WIZARD_ARGS[@]}"
      fi
    fi
    apply_default_nightly_routines
    CURRENT_INSTALL_STAGE="preflight"
    write_install_stage "$CURRENT_INSTALL_STAGE"
    run_preflight apply
    apply_default_nightly_routines
    CURRENT_INSTALL_STAGE="bootstrap-components"
    write_install_stage "$CURRENT_INSTALL_STAGE"
    bootstrap_components
    ensure_viventium_health_runtime >/dev/null
    CURRENT_INSTALL_STAGE="compile-config"
    write_install_stage "$CURRENT_INSTALL_STAGE"
    if [[ ${#INSTALL_ARGS[@]} -gt 0 ]]; then
      compile_config "${INSTALL_ARGS[@]}"
    else
      compile_config
    fi
    prepare_telegram_runtime_component "$REPO_ROOT" "$RUNTIME_DIR"
    CURRENT_INSTALL_STAGE="bootstrap-life"
    write_install_stage "$CURRENT_INSTALL_STAGE"
    bootstrap_life
    echo "Config written to $CONFIG_FILE"
    echo "Generated runtime files in $RUNTIME_DIR"
    CURRENT_INSTALL_STAGE="doctor"
    write_install_stage "$CURRENT_INSTALL_STAGE"
    "$REPO_ROOT/scripts/viventium/doctor.sh" \
      --config "$CONFIG_FILE" \
      --runtime-dir "$RUNTIME_DIR" \
      --repo-root "$REPO_ROOT" \
      --lock-file "$LOCK_FILE"
    sync_memory_hardening_schedule
    CURRENT_INSTALL_STAGE="install-helper"
    write_install_stage "$CURRENT_INSTALL_STAGE"
    maybe_install_macos_helper --no-launch
    if [[ "$AUTO_START" == "1" ]]; then
      echo "Starting Viventium..."
      CURRENT_INSTALL_STAGE="start"
      write_install_stage "$CURRENT_INSTALL_STAGE"
      if ! start_stack_for_install; then
        print_install_summary 1
        exit 1
      fi
      INSTALL_TRAP_ACTIVE=0
      trap cleanup_cli_lock EXIT
      finish_config_candidate
      clear_install_stage
      launch_macos_helper_app
      print_install_summary 1
      open_default_browser
      print_connected_accounts_browser_reminder
      exit 0
    fi
    INSTALL_TRAP_ACTIVE=0
    trap cleanup_cli_lock EXIT
    finish_config_candidate
    clear_install_stage
    print_install_summary 0
    ;;
  upgrade|update)
    AUTO_RESTART=0
    SKIP_PULL=0
    ALLOW_DIRTY=0
    CHECK_ONLY=0
    CHECK_JSON=0
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --check)
          CHECK_ONLY=1
          shift
          ;;
        --json)
          CHECK_JSON=1
          shift
          ;;
        --restart)
          AUTO_RESTART=1
          shift
          ;;
        --skip-pull)
          SKIP_PULL=1
          shift
          ;;
        --allow-dirty)
          ALLOW_DIRTY=1
          shift
          ;;
        *)
          echo "Unknown upgrade option: $1" >&2
          exit 1
          ;;
      esac
    done
    if [[ "$CHECK_ONLY" == "1" ]]; then
      check_args=(--repo-root "$REPO_ROOT" --app-support-dir "$APP_SUPPORT_DIR")
      if [[ -f "$CONFIG_FILE" ]]; then
        check_args+=(--config-file "$CONFIG_FILE")
      fi
      if [[ "$CHECK_JSON" == "1" ]]; then
        check_args+=(--json)
      fi
      exec "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/upgrade_check.py" "${check_args[@]}"
    fi
    if [[ "$AUTO_RESTART" != "1" ]]; then
      echo "A mutating upgrade must restart and validate the candidate runtime before commit." >&2
      echo "Rerun with: bin/viventium upgrade --restart" >&2
      exit 1
    fi
    if [[ "$ALLOW_DIRTY" == "1" && "$SKIP_PULL" != "1" ]]; then
      echo "--allow-dirty is only safe with --skip-pull; refusing to fetch or merge into a dirty checkout." >&2
      exit 1
    fi
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    acquire_cli_lock "$COMMAND"
    recover_interrupted_upgrade_transaction
    if ! recover_pending_quiesced_upgrade_finalization; then
      echo "A previously committed upgrade still needs a healthy full-runtime finalization." >&2
      echo "Resolve the reported runtime prerequisite and rerun upgrade --restart." >&2
      exit 1
    fi
    ensure_no_pending_agent_migration
    if [[ ! -f "$CONFIG_FILE" ]]; then
      echo "Missing config: $CONFIG_FILE" >&2
      echo "Run: bin/viventium install" >&2
      exit 1
    fi
    UPGRADE_REQUIRES_REMOTE=1
    if [[ "$SKIP_PULL" == "1" ]]; then
      UPGRADE_REQUIRES_REMOTE=0
    fi
    ensure_upgradeable_git_state "$ALLOW_DIRTY" "$UPGRADE_REQUIRES_REMOTE"
    UPGRADE_STACK_WAS_RUNNING=0
    if is_stack_running; then
      if [[ "$AUTO_RESTART" == "1" ]]; then
        UPGRADE_STACK_WAS_RUNNING=1
      else
        echo "Upgrade refused because the Viventium stack is currently running." >&2
        echo "Run: bin/viventium stop first, or rerun with --restart." >&2
        exit 1
      fi
    fi
    UPGRADE_SAFETY_ARGS=(
      --repo-root "$REPO_ROOT"
      --app-support-dir "$APP_SUPPORT_DIR"
      --no-fetch
      --json
    )
    if [[ -f "$CONFIG_FILE" ]]; then
      UPGRADE_SAFETY_ARGS+=(--config-file "$CONFIG_FILE")
    fi
    if [[ "$ALLOW_DIRTY" == "1" ]]; then
      UPGRADE_SAFETY_ARGS+=(--allow-dirty-parent)
    fi
    UPGRADE_SAFETY_STATUS=0
    UPGRADE_SAFETY_JSON="$("$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/upgrade_check.py" "${UPGRADE_SAFETY_ARGS[@]}")" || UPGRADE_SAFETY_STATUS=$?
    if [[ "$UPGRADE_SAFETY_STATUS" -ne 0 ]]; then
      "$PYTHON_BIN" - "$UPGRADE_SAFETY_JSON" <<'PY' >&2
import json
import sys

try:
    report = json.loads(sys.argv[1])
except (IndexError, json.JSONDecodeError):
    print("Local upgrade safety inspection did not return readable status.")
    raise SystemExit(0)

for blocker in report.get("blockers", []):
    print(f"Upgrade blocker: {blocker}")
    if blocker == "dirty_checkout":
        print(
            "Preserve or remove the untracked/modified parent files, then retry. "
            "For an intentional local-only refresh, use --skip-pull --allow-dirty."
        )
for item in report.get("component_lock_drift", []):
    name = str(item.get("name") or "managed component")
    status = str(item.get("status") or "unsafe")
    print(f"Managed component blocker: {name} ({status})")
PY
      echo "Upgrade aborted before pull or component mutation because local safety blockers must be resolved first." >&2
      exit "$UPGRADE_SAFETY_STATUS"
    fi
    repair_shallow_upgrade_history
    ensure_supported_upgrade_predecessor
    UPGRADE_AUDIT_TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
    UPGRADE_AGENT_PREDECESSOR_SOURCE_REF="$(capture_agent_source_ref)"
    VIVENTIUM_CONTINUITY_AUDIT_SKIP_PYTHON_REFRESH=1
    PRE_UPGRADE_CONTINUITY_AUDIT="$(capture_continuity_audit "pre-upgrade-${UPGRADE_AUDIT_TIMESTAMP}")"
    unset VIVENTIUM_CONTINUITY_AUDIT_SKIP_PYTHON_REFRESH
    PRE_UPGRADE_CONTINUITY_STATUS="$(continuity_audit_status "$PRE_UPGRADE_CONTINUITY_AUDIT")"
    echo "Pre-upgrade continuity audit written to $(display_safe_path "$PRE_UPGRADE_CONTINUITY_AUDIT")"
    if [[ "$PRE_UPGRADE_CONTINUITY_STATUS" == "error" || "$PRE_UPGRADE_CONTINUITY_STATUS" == "unknown" ]]; then
      echo "Upgrade aborted because the pre-upgrade continuity audit is not trustworthy." >&2
      echo "Review $(display_safe_path "$PRE_UPGRADE_CONTINUITY_AUDIT") before changing the installed runtime." >&2
      exit 1
    fi
    UPGRADE_TELEGRAM_SOURCE_MODE="predecessor"
    if [[ "$ALLOW_DIRTY" == "1" ]]; then
      UPGRADE_TELEGRAM_SOURCE_MODE=""
    fi
    if ! stage_telegram_runtime_component \
      "$REPO_ROOT" \
      "$UPGRADE_TELEGRAM_SOURCE_MODE"
    then
      echo "Upgrade could not stage a rollback-safe Telegram predecessor component." >&2
      if [[ "$ALLOW_DIRTY" == "1" ]]; then
        echo "Preserve or commit the local changes, then retry without --allow-dirty." >&2
      fi
      echo "Source, generated runtime, helper, and running state were not changed." >&2
      exit 1
    fi
    UPGRADE_TARGET_HEAD=""
    if [[ "$SKIP_PULL" != "1" ]]; then
      # Fetch updates Git metadata only; if the network fails, the still-running
      # product and every mutable product surface remain untouched.
      UPGRADE_TARGET_HEAD="$(fetch_current_branch_target)"
    fi
    # Register rollback ownership and arm the trap while the old runtime is
    # still healthy. The mutable data checkpoint is taken only after shutdown.
    trap recover_running_stack_after_failed_upgrade EXIT
    trap 'recover_running_stack_after_failed_upgrade 130' INT
    trap 'recover_running_stack_after_failed_upgrade 143' TERM
    TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
      resolve_predecessor_telegram_user_config_root "$REPO_ROOT"
    )"
    upgrade_transaction_begin "$UPGRADE_TARGET_HEAD"
    if ! publish_active_telegram_recovery_component \
      "upgrade" "$UPGRADE_TRANSACTION_DIR"
    then
      echo "Upgrade could not publish transaction-bound passive helper recovery before shutdown." >&2
      exit 1
    fi
    if [[ "$UPGRADE_STACK_WAS_RUNNING" == "1" ]]; then
      echo "Running Viventium stack detected. Stopping before component refresh..."
      if ! stop_stack_for_upgrade; then
        echo "Upgrade aborted because the running stack could not be stopped safely." >&2
        echo "No source pull or component refresh was attempted. Resolve the stop failure, then retry." >&2
        exit 1
      fi
    fi
    if ! migrate_telegram_user_configs "$REPO_ROOT"; then
      echo "Upgrade could not preserve legacy Telegram preferences in canonical App Support state." >&2
      exit 1
    fi
    if ! publish_active_telegram_recovery_component \
      "upgrade" "$UPGRADE_TRANSACTION_DIR"
    then
      echo "Upgrade could not bind its migrated Telegram preference authority to rollback." >&2
      exit 1
    fi
    if ! arm_persistent_telegram_recovery_helper; then
      echo "Upgrade could not arm persistent helper recovery before candidate mutation." >&2
      exit 1
    fi
    upgrade_transaction_snapshot_stopped_state
    upgrade_transaction_prepare_candidate
    if [[ "$SKIP_PULL" != "1" ]]; then
      fast_forward_current_branch_to_target "$UPGRADE_TARGET_HEAD"
    fi
    upgrade_transaction_checkpoint "source_pulled"
    apply_default_nightly_routines "$UPGRADE_CANDIDATE_CONFIG"
    (
      CONFIG_FILE="$UPGRADE_CANDIDATE_CONFIG"
      if ! run_preflight check; then
        echo "The upgrade candidate needs a prerequisite that is not installed yet." >&2
        echo "The current version will be restored; run bin/viventium preflight --apply, then retry the upgrade." >&2
        exit 1
      fi
    )
    refresh_repo_python
    apply_default_nightly_routines "$UPGRADE_CANDIDATE_CONFIG"
    (
      CONFIG_FILE="$UPGRADE_CANDIDATE_CONFIG"
      bootstrap_components_upgrade_checked
      ensure_viventium_health_runtime >/dev/null
    )
    upgrade_transaction_checkpoint "components_refreshed"
    mkdir -p "$UPGRADE_CANDIDATE_RUNTIME"
    VIVENTIUM_LIBRECHAT_SOURCE_PHASE=compile \
    VIVENTIUM_LIBRECHAT_SOURCE_OF_TRUTH= \
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_compiler.py" \
      --config "$UPGRADE_CANDIDATE_CONFIG" \
      --output-dir "$UPGRADE_CANDIDATE_RUNTIME"
    prepare_telegram_runtime_component "$REPO_ROOT" "$UPGRADE_CANDIDATE_RUNTIME"
    "$REPO_ROOT/scripts/viventium/doctor.sh" \
      --config "$UPGRADE_CANDIDATE_CONFIG" \
      --runtime-dir "$UPGRADE_CANDIDATE_RUNTIME" \
      --repo-root "$REPO_ROOT" \
      --lock-file "$LOCK_FILE"
    UPGRADE_AGENT_SUCCESSOR_SOURCE_REF="$(capture_agent_source_ref)"
    prepare_agent_migration_state \
      "$UPGRADE_AGENT_PREDECESSOR_SOURCE_REF" \
      "$UPGRADE_AGENT_SUCCESSOR_SOURCE_REF"
    upgrade_transaction_checkpoint "candidate_validated"
    upgrade_transaction_activate_candidate
    upgrade_transaction_checkpoint "candidate_activated"
    if ! validate_quiesced_upgrade_session_before_post_capture; then
      echo "Upgrade candidate could not start and validate its protected quiesced runtime; rolling back." >&2
      exit 1
    fi
    POST_UPGRADE_CONTINUITY_AUDIT="$(capture_continuity_audit "post-upgrade-${UPGRADE_AUDIT_TIMESTAMP}")"
    POST_UPGRADE_CONTINUITY_STATUS="$(continuity_audit_status "$POST_UPGRADE_CONTINUITY_AUDIT")"
    echo "Post-upgrade continuity audit written to $(display_safe_path "$POST_UPGRADE_CONTINUITY_AUDIT")"
    case "$POST_UPGRADE_CONTINUITY_STATUS" in
      ok|warning)
        if [[ "$POST_UPGRADE_CONTINUITY_STATUS" == "warning" ]]; then
          echo "Upgrade continuity audit reported warnings. Review $(display_safe_path "$POST_UPGRADE_CONTINUITY_AUDIT") before concluding the install is fully aligned." >&2
        fi
        ;;
      error|unknown|*)
        echo "Upgrade candidate did not pass the post-activation continuity gate; rolling back." >&2
        echo "Review $(display_safe_path "$POST_UPGRADE_CONTINUITY_AUDIT") before retrying." >&2
        exit 1
        ;;
    esac
    if ! compare_upgrade_continuity_audits \
      "$PRE_UPGRADE_CONTINUITY_AUDIT" \
      "$POST_UPGRADE_CONTINUITY_AUDIT" \
      "upgrade-comparison-${UPGRADE_AUDIT_TIMESTAMP}"; then
      exit 1
    fi
    upgrade_transaction_checkpoint "continuity_verified"
    if [[ "$UPGRADE_STACK_WAS_RUNNING" == "1" ]]; then
      set_helper_runtime_intent running
    else
      echo "Returning Viventium to its pre-upgrade stopped state..."
      if ! stop_stack_for_upgrade; then
        echo "Upgrade candidate could not preserve the prior stopped state; rolling back." >&2
        exit 1
      fi
      set_helper_runtime_intent stopped
    fi
    upgrade_transaction_checkpoint "continuity_and_runtime_intent_verified"
    upgrade_transaction_commit
    postcommit_life_bootstrap_status=0
    bootstrap_life || postcommit_life_bootstrap_status=$?
    if ! finalize_quiesced_upgrade_session_after_commit; then
      echo "The source upgrade committed, but protected runtime finalization is incomplete." >&2
      echo "Resolve the reported runtime health failure, then rerun bin/viventium upgrade --restart." >&2
      exit 1
    fi
    if ! finalize_deferred_uploads_after_upgrade_commit; then
      echo "The source upgrade committed safely, but uploads finalization still needs recovery." >&2
      echo "Rerun bin/viventium upgrade --restart to complete the remaining local migration." >&2
      exit 1
    fi
    # LaunchAgents are derived host state, not part of the App Support/source
    # transaction. Reconcile only after commit and protected runtime finalization;
    # the loader restores the exact prior plist/load state if reconciliation fails.
    if ! sync_memory_hardening_schedule; then
      echo "The core upgrade is finalized, but the maintenance schedule refresh failed; the previous LaunchAgent state was restored." >&2
      echo "Resolve the reported launchctl or filesystem error, then rerun: bin/viventium compile-config" >&2
      exit 1
    fi
    if ! maybe_install_macos_helper --no-launch; then
      echo "The core upgrade is finalized, but the macOS helper refresh failed. Run: bin/viventium install-helper" >&2
      exit 1
    fi
    if ! clear_active_telegram_recovery_component; then
      echo "The upgrade committed, but stale Telegram recovery state could not be cleared." >&2
      exit 1
    fi
    launch_macos_helper_app
    if [[ "$postcommit_life_bootstrap_status" -ne 0 ]]; then
      echo "The upgrade and protected runtime finalization completed, but canonical LIFE is not ready." >&2
      echo "Resolve the reported LIFE path conflict, then rerun: bin/viventium start" >&2
      exit "$postcommit_life_bootstrap_status"
    fi
    exit 0
    ;;
  configure|wizard)
    acquire_cli_lock "$COMMAND"
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    CONFIG_INPUT=""
    HEADLESS=0
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --headless|--non-interactive)
          HEADLESS=1
          shift
          ;;
        --config-input|--preset|--config)
          if [[ $# -lt 2 ]]; then
            echo "Missing value for $1" >&2
            exit 1
          fi
          CONFIG_INPUT="$2"
          shift 2
          ;;
        *)
          echo "Unknown configure option: $1" >&2
          exit 1
          ;;
      esac
    done
    if [[ "$HEADLESS" != "1" ]]; then
      reattach_stdin_from_tty_if_available || true
    fi
    if [[ -n "$CONFIG_INPUT" ]]; then
      if ! prepare_config_candidate "$CONFIG_INPUT"; then
        cleanup_config_candidate || true
        exit 1
      fi
      if ! apply_config_candidate; then
        cleanup_config_candidate || true
        exit 1
      fi
    elif [[ "$HEADLESS" == "1" ]]; then
      echo "configure --headless requires --preset/--config-input/--config <file>" >&2
      exit 1
    else
      WIZARD_ARGS=(--output "$CONFIG_FILE")
      "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/wizard.py" "${WIZARD_ARGS[@]}"
      apply_default_nightly_routines
    fi
    if ! bootstrap_components || ! compile_config || ! bootstrap_life || ! ensure_configured_prerequisites || ! sync_memory_hardening_schedule; then
      rollback_config_candidate || true
      cleanup_config_candidate || true
      exit 1
    fi
    finish_config_candidate
    ;;
  bootstrap-components)
    acquire_cli_lock "$COMMAND"
    bootstrap_components "$@"
    ensure_viventium_health_runtime >/dev/null
    ;;
  compile-config)
    acquire_cli_lock "$COMMAND"
    apply_default_nightly_routines
    bootstrap_components
    compile_config "$@"
    sync_memory_hardening_schedule
    ;;
  doctor)
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    prepare_runtime_exports
    run_preflight check
    exec "$REPO_ROOT/scripts/viventium/doctor.sh" \
      --config "$CONFIG_FILE" \
      --runtime-dir "$RUNTIME_DIR" \
      --repo-root "$REPO_ROOT" \
      --lock-file "$LOCK_FILE" \
      "$@"
    ;;
  status)
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    if [[ ! -f "$CONFIG_FILE" ]]; then
      echo "Missing config: $CONFIG_FILE" >&2
      echo "Run: bin/viventium install" >&2
      exit 1
    fi
    refresh_repo_python
    exec "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/install_summary.py" \
      --config "$CONFIG_FILE" \
      --runtime-dir "$RUNTIME_DIR" \
      --repo-root "$REPO_ROOT" \
      --probe-live
    ;;
  register-link)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage register-link
      exit 0
    fi
    reg_username="$1"; shift
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    prepare_runtime_exports
    refresh_repo_python
    exec "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/directory_link.py" \
      --state-file "$VIVENTIUM_PUBLIC_NETWORK_STATE_FILE" \
      --username "$reg_username" \
      "$@"
    ;;
  password-reset-link)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage password-reset-link
      exit 0
    fi
    reset_email="$1"; shift
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    compile_config
    prepare_runtime_exports
    if [[ -f "$GENERATED_ENV" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$GENERATED_ENV"
      if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LOCAL_ENV"
      fi
      if [[ -f "$GENERATED_LIBRECHAT_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LIBRECHAT_ENV"
      fi
      set +a
    fi
    prepare_password_reset_link_runtime
    exec node "$PASSWORD_RESET_LINK_SCRIPT" \
      --email "$reset_email" \
      "$@"
    ;;
  launch)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage launch
      exit 0
    fi
    # Authenticate an exact receipt-bound quiesced successor before generic
    # interrupted-upgrade recovery. Otherwise a detached successor launched by
    # the still-lock-owning outer transaction mistakes that same transaction for
    # an interruption and deadlocks trying to recover itself.
    if ! inherit_quiesced_successor_validation_if_active; then
      echo "Active upgrade validation state is unsafe; refusing to launch writers." >&2
      exit 1
    fi
    recover_interrupted_upgrade_before_runtime_start
    if ! recover_interrupted_helper_install; then
      echo "Interrupted helper installation recovery failed closed." >&2
      exit 1
    fi
    if [[ "${VIVENTIUM_DETACHED_START:-false}" != "true" ]]; then
      set_helper_runtime_intent running
    fi
    launch_stack_detached "$@"
    ;;
  install-helper)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage install-helper
      exit 0
    fi
    run_macos_helper_installer install "$@"
    write_install_ownership_receipt true
    ;;
  shell-init)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage shell-init
      exit 0
    fi
    run_shell_init "$@"
    ;;
  continuity-audit)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage continuity-audit
      exit 0
    fi
    CLEAR_RECALL_MARKER=0
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --clear-recall-marker)
          CLEAR_RECALL_MARKER=1
          shift
          ;;
        *)
          echo "Unknown continuity-audit option: $1" >&2
          exit 1
          ;;
      esac
    done
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    audit_path="$(capture_continuity_audit "manual-$(date -u +%Y%m%dT%H%M%SZ)")"
    echo "Continuity audit written to $(display_safe_path "$audit_path")"
    if [[ "$CLEAR_RECALL_MARKER" == "1" ]]; then
      if cleared_marker="$(remove_recall_rebuild_marker)"; then
        echo "Cleared recall rebuild-required marker at $(display_safe_path "$cleared_marker")"
      else
        echo "No recall rebuild-required marker was present."
      fi
    fi
    ;;
  cognitive-integrity)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage cognitive-integrity
      exit 0
    fi
    ensure_brew_paths_on_path
    exec uv run \
      --with fastapi \
      --with PyYAML \
      --with pydantic \
      --with croniter \
      python "$REPO_ROOT/scripts/viventium/cognitive_integrity.py" \
      --repo-root "$REPO_ROOT" \
      "$@"
    ;;
  memory-harden)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage memory-harden
      exit 0
    fi
    memory_harden_subcommand="${1:-}"
    if [[ "$memory_harden_subcommand" != "status" ]]; then
      acquire_cli_lock "$COMMAND"
    fi
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    if [[ ! -f "$CONFIG_FILE" ]]; then
      echo "Missing config: $CONFIG_FILE" >&2
      echo "Run: bin/viventium install" >&2
      exit 1
    fi
    if [[ "$memory_harden_subcommand" != "status" ]]; then
      compile_config >/dev/null
    fi
    prepare_runtime_exports
    if [[ -f "$GENERATED_ENV" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$GENERATED_ENV"
      if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LOCAL_ENV"
      fi
      if [[ -f "$GENERATED_LIBRECHAT_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LIBRECHAT_ENV"
      fi
      set +a
    fi
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/memory_harden.py" \
      --repo-root "$REPO_ROOT" \
      --app-support-dir "$APP_SUPPORT_DIR" \
      --runtime-dir "$RUNTIME_DIR" \
      "$@"
    ;;
  transcripts)
    transcripts_command "$@"
    ;;
  qa-test-account)
    qa_test_account_command "$@"
    ;;
  memory-dedupe)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage memory-dedupe
      exit 0
    fi
    acquire_cli_lock "$COMMAND"
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    if [[ ! -f "$CONFIG_FILE" ]]; then
      echo "Missing config: $CONFIG_FILE" >&2
      echo "Run: bin/viventium install" >&2
      exit 1
    fi
    compile_config >/dev/null
    prepare_runtime_exports
    if [[ -f "$GENERATED_ENV" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$GENERATED_ENV"
      if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LOCAL_ENV"
      fi
      if [[ -f "$GENERATED_LIBRECHAT_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LIBRECHAT_ENV"
      fi
      set +a
    fi
    node "$REPO_ROOT/viventium_v0_4/LibreChat/scripts/viventium-memory-dedupe.js" "$@"
    ;;
  status-bar)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage status-bar
      exit 0
    fi
    run_status_bar_command "$@"
    ;;
  runtime-checkout)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage runtime-checkout
      exit 0
    fi
    runtime_checkout_command "$@"
    ;;
  dev-env)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage dev-env
      exit 0
    fi
    dev_env_command "$@"
    ;;
  dev-runtime)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage dev-runtime
      exit 0
    fi
    dev_runtime_command "$@"
    ;;
  workflows)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage workflows
      exit 0
    fi
    workflows_command "$@"
    ;;
  prompt-workbench)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage prompt-workbench
      exit 0
    fi
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    exec "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/prompt_workbench.py" \
      --repo-root "$REPO_ROOT" \
      --app-support-dir "$APP_SUPPORT_DIR" \
      "$@"
    ;;
  health)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
      subcommand_usage health
      exit 0
    fi
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    ensure_viventium_health_runtime >/dev/null
    exec "$APP_SUPPORT_DIR/health/runtime/bin/viventium-health" "$@"
    ;;
  heal)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage heal
      exit 0
    fi
    heal_command "$@"
    ;;
  feature-request)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage feature-request
      exit 0
    fi
    feature_request_command "$@"
    ;;
  report-bug|bug-report)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage report-bug
      exit 0
    fi
    report_bug_command "$@"
    ;;
  uninstall-helper)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage uninstall-helper
      exit 0
    fi
    run_macos_helper_installer uninstall "$@"
    ;;
  _first-upgrade-runtime)
    # Internal successor-owned bridge invoked only from continuity_audit.py while
    # a verified predecessor upgrade still owns the CLI lock. This must not be a
    # public lock-bypass surface.
    if [[ "${VIVENTIUM_FIRST_UPGRADE_BRIDGE_INTERNAL:-0}" != "1" ]] ||
      [[ "${VIVENTIUM_CLI_LOCK_HELD:-0}" != "1" ]] ||
      [[ "${VIVENTIUM_CLI_LOCK_DIR:-}" != "$CLI_LOCK_DIR" ]]
    then
      echo "First-upgrade runtime bridge requires a verified parent upgrade lock." >&2
      exit 1
    fi
    bridge_lock_pid="$(read_cli_lock_metadata | sed -n '1p')"
    if [[ -z "$bridge_lock_pid" || "$bridge_lock_pid" != "${VIVENTIUM_CLI_LOCK_OWNER_PID:-}" ]] ||
      ! cli_lock_active_owner "$bridge_lock_pid"
    then
      echo "First-upgrade runtime bridge parent lock is no longer trustworthy." >&2
      exit 1
    fi
    bridge_action="${1:-}"
    case "$bridge_action" in
      start-quiesced-and-wait)
        UPGRADE_TRANSACTION_ACTIVE=1
        if ! restart_quiesced_runtime_after_upgrade; then
          exit 1
        fi
        ;;
      start-full-and-wait)
        UPGRADE_TRANSACTION_ACTIVE=1
        if ! restart_stack_after_upgrade; then
          exit 1
        fi
        if ! ensure_no_pending_agent_migration; then
          echo "First-upgrade runtime did not finish its managed-agent migration." >&2
          exit 1
        fi
        ;;
      restore-stopped)
        VIVENTIUM_CLI_LOCK_INHERITED_ONCE=1 \
          "$REPO_ROOT/bin/viventium" \
          --app-support-dir "$APP_SUPPORT_DIR" \
          --config-file "$CONFIG_FILE" \
          --runtime-dir "$RUNTIME_DIR" \
          --lock-file "$LOCK_FILE" \
          stop
        ;;
      *)
        echo "Unknown first-upgrade runtime bridge action: $bridge_action" >&2
        exit 2
        ;;
    esac
    ;;
  start)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage start
      exit 0
    fi
    # The exact active successor receipt is the only permitted pre-recovery
    # exception. Unrelated or malformed active pointers remain subject to the
    # generic fail-closed interrupted-upgrade path below.
    if ! inherit_quiesced_successor_validation_if_active; then
      echo "Active upgrade validation state is unsafe; refusing to start writers." >&2
      exit 1
    fi
    recover_interrupted_upgrade_before_runtime_start
    if ! recover_interrupted_helper_install; then
      echo "Interrupted helper installation recovery failed closed." >&2
      exit 1
    fi
    if ! recover_interrupted_dev_runtime_activations; then
      echo "Interrupted local-runtime promotion recovery failed closed." >&2
      exit 1
    fi
    if [[ "${DEV_RUNTIME_RECOVERY_PERFORMED:-0}" == "1" ]]; then
      echo "Recovered the interrupted local-runtime promotion. Rerun start from the active checkout if you still want to start it."
      exit 0
    fi
    if ! recover_pending_quiesced_upgrade_finalization; then
      echo "A committed upgrade is waiting for full-runtime recovery; start remains failed closed." >&2
      exit 1
    fi
    if ! inherit_pending_postcommit_finalization_if_needed; then
      echo "Pending post-upgrade runtime finalization is unsafe; refusing to start writers." >&2
      exit 1
    fi
    if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_MODE:-}" != "quiesced" &&
      "${VIVENTIUM_PRESERVE_HELPER_RUNTIME_INTENT:-0}" != "1" ]]
    then
      set_helper_runtime_intent running
    fi
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    if [[ ! -f "$CONFIG_FILE" ]]; then
      echo "Missing config: $CONFIG_FILE" >&2
      echo "Run: bin/viventium install" >&2
      exit 1
    fi
    if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_MODE:-}" != "quiesced" ]]; then
      bootstrap_components
      ensure_viventium_health_runtime >/dev/null
    fi
    # === VIVENTIUM START ===
    # Feature: Canonical runtime regeneration on every start.
    # Purpose: prevent stale generated runtime files from surviving across installer/compiler
    # fixes and silently leaving the machine in an older behavior state than the current branch.
    # compile_config is cheap relative to stack startup and keeps start deterministic.
    # === VIVENTIUM END ===
    if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_MODE:-}" != "quiesced" ]]; then
      apply_default_nightly_routines
    fi
    compile_config
    if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_MODE:-}" != "quiesced" ]]; then
      bootstrap_life
      sync_memory_hardening_schedule
    fi
    prepare_runtime_exports

    EXTRA_ARGS=()
    if [[ -f "$GENERATED_ENV" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$GENERATED_ENV"
      if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LOCAL_ENV"
      fi
      set +a
      if [[ "${VIVENTIUM_SUCCESSOR_VALIDATION_MODE:-}" == "quiesced" ]]; then
        VIVENTIUM_VOICE_ENABLED=false
        export VIVENTIUM_VOICE_ENABLED
      fi
      if [[ "${VIVENTIUM_INSTALL_MODE:-docker}" == "native" ]]; then
        if [[ -z "${MEILI_MASTER_KEY:-}" ]]; then
          persisted_meili_master_key="$(
            read_local_env_assignment \
              "$REPO_ROOT/viventium_v0_4/LibreChat/.env" \
              "MEILI_MASTER_KEY" || true
          )"
          if [[ -n "$persisted_meili_master_key" ]]; then
            MEILI_MASTER_KEY="$persisted_meili_master_key"
            export MEILI_MASTER_KEY
          fi
        fi
        write_stack_owner_state "$COMMAND"
        NATIVE_STACK_SKIP_MEILI=0
        if express_install_experience; then
          NATIVE_STACK_SKIP_MEILI=1
        fi
        VIVENTIUM_NATIVE_STACK_SKIP_LIVEKIT=1 \
          VIVENTIUM_NATIVE_STACK_SKIP_MEILI="$NATIVE_STACK_SKIP_MEILI" \
          "$REPO_ROOT/scripts/viventium/native_stack.sh" start
      else
        write_stack_owner_state "$COMMAND"
      fi
      if [[ "${VIVENTIUM_VOICE_ENABLED:-true}" != "true" ]]; then
        EXTRA_ARGS+=(--skip-voice-gateway --skip-livekit)
      fi
      if express_install_experience; then
        EXTRA_ARGS+=(--skip-playground)
      fi
    fi
    if [[ -z "${VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR:-}" ]]; then
      VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR="$(
        resolve_predecessor_telegram_user_config_root "$REPO_ROOT"
      )"
      export VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR
    fi

    if [[ -z "${VIVENTIUM_CALL_SESSION_SECRET:-}" ]]; then
      echo "Missing VIVENTIUM_CALL_SESSION_SECRET in generated runtime env: $GENERATED_ENV" >&2
      echo "Run: bin/viventium compile-config or bin/viventium configure" >&2
      exit 1
    fi

    USER_SELECTED_PLAYGROUND=0
    NORMALIZED_ARGS=()
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --runtime-profile)
          if [[ $# -lt 2 ]]; then
            echo "Missing value for --runtime-profile" >&2
            exit 1
          fi
          NORMALIZED_ARGS+=("--profile=$2")
          shift 2
          ;;
        --profile)
          if [[ $# -lt 2 ]]; then
            echo "Missing value for --profile" >&2
            exit 1
          fi
          NORMALIZED_ARGS+=("--profile=$2")
          shift 2
          ;;
        --profile=*|--modern-playground|--classic-playground)
          if [[ "${1:-}" == "--modern-playground" || "${1:-}" == "--classic-playground" ]]; then
            USER_SELECTED_PLAYGROUND=1
          fi
          NORMALIZED_ARGS+=("$1")
          shift
          ;;
        *)
          NORMALIZED_ARGS+=("$1")
          shift
          ;;
      esac
    done

    START_CMD=("$REPO_ROOT/viventium_v0_4/viventium-librechat-start.sh")
    if [[ "$USER_SELECTED_PLAYGROUND" != "1" ]] && ! express_install_experience; then
      if [[ "${PLAYGROUND_VARIANT:-modern}" == "classic" ]]; then
        START_CMD+=(--classic-playground)
      else
        START_CMD+=(--modern-playground)
      fi
    fi
    if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
      START_CMD+=("${EXTRA_ARGS[@]}")
    fi
    if [[ ${#NORMALIZED_ARGS[@]} -gt 0 ]]; then
      START_CMD+=("${NORMALIZED_ARGS[@]}")
    fi
    # The CLI lock protects start preparation, config compilation, and runtime
    # handoff setup. It must not be held by the long-running stack supervisor;
    # otherwise status, Stop/Quit, and manual memory-hardening jobs are blocked
    # while Viventium is healthy and running.
    if ! write_runtime_start_claim; then
      echo "Unable to record the active Viventium startup claim." >&2
      exit 1
    fi
    cleanup_cli_lock
    VIVENTIUM_LAUNCHER_INTERNAL=1 "${START_CMD[@]}"
    exit $?
    ;;
  stop)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage stop
      exit 0
    fi
    if [[ "${VIVENTIUM_PRESERVE_HELPER_RUNTIME_INTENT:-0}" != "1" ]]; then
      set_helper_runtime_intent stopped
    fi
    stop_status=0
    if value_is_true "${VIVENTIUM_DEV_ENV_SCOPE_ACTIVE:-false}"; then
      if ! compile_config; then
        echo "Dev-environment stop refused because its runtime identity could not be compiled; no services were stopped." >&2
        exit 1
      fi
    fi
    prepare_runtime_exports
    if [[ -f "$GENERATED_ENV" ]]; then
      set -a
      # shellcheck disable=SC1090
      source "$GENERATED_ENV"
      if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LOCAL_ENV"
      fi
      set +a
    fi
    write_stack_owner_state "$COMMAND"
    VIVENTIUM_LAUNCHER_INTERNAL=1 \
      "$REPO_ROOT/viventium_v0_4/viventium-librechat-start.sh" --stop "$@" || stop_status=$?
    # Native state can linger across mode switches or older runs. Stop cleanup
    # should drain owned native services whenever they exist, not only when the
    # current config still says "native".
    if [[ "${VIVENTIUM_HELPER_STOP_BACKGROUND_NATIVE:-0}" == "1" ]]; then
      stop_native_stack_detached
    else
      "$REPO_ROOT/scripts/viventium/native_stack.sh" stop || stop_status=$?
    fi
    exit "$stop_status"
    ;;
  snapshot)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage snapshot
      exit 0
    fi
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    prepare_runtime_exports
    VIVENTIUM_PYTHON_BIN="$PYTHON_BIN" \
      "$REPO_ROOT/viventium_v0_4/viventium-local-state-snapshot.sh" \
      --output-root "$APP_SUPPORT_DIR/snapshots" \
      "$@"
    ;;
  restore)
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage restore
      exit 0
    fi
    VIVENTIUM_DEFAULT_CONFIG_HOME="$APP_SUPPORT_DIR" \
      VIVENTIUM_PYTHON_BIN="$PYTHON_BIN" \
      exec "$REPO_ROOT/scripts/viventium/restore.sh" "$@"
    ;;
  uninstall)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage uninstall
      exit 0
    fi
    UNINSTALL_YES=0
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --yes)
          UNINSTALL_YES=1
          shift
          ;;
        *)
          echo "Unknown uninstall option: $1" >&2
          exit 1
          ;;
      esac
    done
    confirm_destructive_action "Uninstall" "$UNINSTALL_YES" "UNINSTALL"
    uninstall_local_installation
    ;;
  preflight)
    acquire_cli_lock "$COMMAND"
    ensure_app_support_layout "$APP_SUPPORT_DIR"
    APPLY_PREFLIGHT=0
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --apply)
          APPLY_PREFLIGHT=1
          shift
          ;;
        *)
          echo "Unknown preflight option: $1" >&2
          exit 1
          ;;
      esac
    done
    if [[ "$APPLY_PREFLIGHT" == "1" ]]; then
      run_preflight apply
    else
      run_preflight check
    fi
    ;;
  reset)
    acquire_cli_lock "$COMMAND"
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      subcommand_usage reset
      exit 0
    fi
    RESET_YES=0
    while [[ $# -gt 0 ]]; do
      case "${1:-}" in
        --yes)
          RESET_YES=1
          shift
          ;;
        *)
          echo "Unknown reset option: $1" >&2
          exit 1
          ;;
      esac
    done
    confirm_destructive_action "Factory reset" "$RESET_YES" "RESET"
    reset_local_install_state
    ;;
  help|-h|--help)
    if [[ $# -gt 0 ]]; then
      subcommand_usage "$1"
    else
      usage
    fi
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 1
    ;;
esac
