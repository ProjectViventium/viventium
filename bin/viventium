compile_config() {
  local compile_status=0
  refresh_repo_python
  ensure_app_support_layout "$APP_SUPPORT_DIR"
  if [[ -e "$GENERATED_ENV" || -L "$GENERATED_ENV" ]]; then
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/agent_migration_state.py" import-legacy \
      --repo-root "$REPO_ROOT" \
      --app-support-dir "$APP_SUPPORT_DIR" \
      --runtime-env "$GENERATED_ENV" >/dev/null
  fi
  export VIVENTIUM_LIBRECHAT_SOURCE_PHASE="compile"
  prepare_runtime_exports
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_compiler.py" \
    --config "$CONFIG_FILE" \
    --output-dir "$RUNTIME_DIR" \
    "$@" || compile_status=$?
  unset VIVENTIUM_LIBRECHAT_SOURCE_PHASE
  if [[ "$compile_status" -ne 0 ]]; then
    return "$compile_status"
  fi
  if [[ -f "$GENERATED_LIBRECHAT_YAML" ]]; then
    export VIVENTIUM_LIBRECHAT_SOURCE_OF_TRUTH="$GENERATED_LIBRECHAT_YAML"
  fi
}

telegram_component_selection_file() {
  local runtime_dir="${1:-$RUNTIME_DIR}"
  printf '%s\n' "$runtime_dir/components/telegram-viventium.json"
}

prepare_telegram_runtime_component() {
  local source_repo="${1:-$REPO_ROOT}"
  local runtime_dir="${2:-$RUNTIME_DIR}"
  local selection_override="${3:-}"
  local source_mode="${4:-}"
  local component_tool="${VIVENTIUM_TELEGRAM_COMPONENT_ASSEMBLER:-$REPO_ROOT/scripts/viventium/telegram_runtime_component.py}"
  local selection_file=""
  local predecessor_runtime=0
  if [[ -n "$selection_override" ]]; then
    selection_file="$selection_override"
  else
    selection_file="$(telegram_component_selection_file "$runtime_dir")"
  fi
  if [[ ! -f "$component_tool" || -L "$component_tool" ]]; then
    echo "Telegram runtime component assembler is missing or unsafe." >&2
    return 1
  fi
  if [[ "$source_mode" == "predecessor" ]]; then
    predecessor_runtime=1
  fi
  VIVENTIUM_TELEGRAM_PREDECESSOR_RUNTIME="$predecessor_runtime" \
    "$PYTHON_BIN" "$component_tool" prepare \
    --repo-root "$source_repo" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --selection-file "$selection_file" \
    --sync-dependencies >/dev/null
}

stage_telegram_runtime_component() {
  local source_repo="${1:-$REPO_ROOT}"
  local source_mode="${2:-}"
  local staging_dir="$APP_SUPPORT_DIR/state/runtime-component-staging"
  local staged_selection=""
  mkdir -p "$staging_dir"
  chmod 700 "$staging_dir"
  staged_selection="$(
    mktemp "$staging_dir/telegram-viventium-predecessor.json.XXXXXXXX"
  )" || return 1
  if ! prepare_telegram_runtime_component \
    "$source_repo" \
    "$RUNTIME_DIR" \
    "$staged_selection" \
    "$source_mode"
  then
    rm -f -- "$staged_selection"
    return 1
  fi
  STAGED_TELEGRAM_RECOVERY_SELECTION="$staged_selection"
  STAGED_TELEGRAM_COMPAT_LAUNCHER="$(
    json_string_field "$staged_selection" compat_launcher
  )"
  STAGED_TELEGRAM_COMPONENT_TOOL="$(
    json_string_field "$staged_selection" component_tool
  )"
  STAGED_TELEGRAM_HANDOFF_HELPER="$(
    json_string_field "$staged_selection" handoff_helper
  )"
  if [[ -z "$STAGED_TELEGRAM_COMPAT_LAUNCHER" ||
    -z "$STAGED_TELEGRAM_COMPONENT_TOOL" ||
    -z "$STAGED_TELEGRAM_HANDOFF_HELPER" ]]
  then
    echo "Telegram recovery controller selection is incomplete." >&2
    return 1
  fi
}

resolve_predecessor_telegram_user_config_root() {
  local source_repo="${1:-$REPO_ROOT}"
  "$PYTHON_BIN" - "$source_repo" "$APP_SUPPORT_DIR" <<'PY'
import json
import hashlib
import os
from pathlib import Path
import shlex
import stat
import sys

repo = Path(os.path.abspath(os.path.expanduser(sys.argv[1])))
support = Path(os.path.abspath(os.path.expanduser(sys.argv[2])))
canonical = support / "state" / "telegram-user-configs"
authority = (
    support / "state" / "telegram-user-config-migration" / "authority.json"
)
root_selection = (
    support
    / "state"
    / "telegram-user-config-migration"
    / "explicit-authority.json"
)

def validated_preference_root(raw_value, label, *, allow_missing=False):
    value = str(raw_value or "").strip()
    if not value:
        raise ValueError(f"{label} is empty")
    path = Path(os.path.abspath(os.path.expanduser(value)))
    current = Path(path.anchor)
    for part in path.parts[1:]:
        current = current / part
        if not os.path.lexists(current):
            break
        metadata = os.lstat(current)
        if stat.S_ISLNK(metadata.st_mode):
            raise ValueError(f"{label} contains a symlink")
        if current != path and not stat.S_ISDIR(metadata.st_mode):
            raise ValueError(f"{label} contains a non-directory parent")
    if not path.exists():
        if allow_missing:
            return path
        raise ValueError(f"{label} is unavailable")
    metadata = os.lstat(path)
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) & 0o022
    ):
        raise ValueError(f"{label} is unsafe")
    return path

explicit = str(os.environ.get("VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR") or "").strip()
if explicit:
    print(validated_preference_root(explicit, "Explicit Telegram preference root"))
    raise SystemExit(0)
if os.path.lexists(root_selection):
    try:
        metadata = os.lstat(root_selection)
        payload = json.loads(root_selection.read_text(encoding="utf-8"))
        selected = Path(
            os.path.abspath(
                os.path.expanduser(str(payload.get("preference_root") or ""))
            )
        )
        expected_generation = hashlib.sha256(
            ("explicit-authority\0" + str(selected)).encode("utf-8")
        ).hexdigest()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or stat.S_IMODE(metadata.st_mode) & 0o077
            or payload.get("schema_version") != 2
            or payload.get("kind")
            != "viventium-telegram-explicit-preference-authority"
            or payload.get("status") != "committed"
            or payload.get("generation") != expected_generation
        ):
            raise ValueError("invalid selection authority")
        print(
            validated_preference_root(
                selected,
                "Telegram preference root selection authority",
                allow_missing=selected == canonical,
            )
        )
        raise SystemExit(0)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(
            f"Telegram preference root selection authority is unsafe: {error}",
            file=sys.stderr,
        )
        raise SystemExit(4)
durable_candidate = None
owner_root = support / "state" / "runtime" / "isolated" / "telegram-poller"
receipts = sorted(
    owner_root.glob("owner-*.json"),
    key=lambda path: path.stat().st_mtime_ns if path.is_file() else -1,
    reverse=True,
)
for receipt in receipts:
    try:
        metadata = os.lstat(receipt)
        payload = json.loads(receipt.read_text(encoding="utf-8"))
        value = str(payload.get("user_configs_root") or "").strip()
        if (
            stat.S_ISREG(metadata.st_mode)
            and metadata.st_uid == os.getuid()
            and value
        ):
            durable_candidate = Path(
                os.path.abspath(os.path.expanduser(value))
            )
            break
    except (OSError, ValueError, json.JSONDecodeError):
        continue
bridge_state = (
    support / "state" / "continuity" / "first-upgrade-bridge.json"
)
if (
    durable_candidate is None
    and bridge_state.is_file()
    and not bridge_state.is_symlink()
):
    try:
        metadata = os.lstat(bridge_state)
        payload = json.loads(bridge_state.read_text(encoding="utf-8"))
        telegram = payload.get("telegramContinuity")
        value = (
            str(telegram.get("effectivePreferenceRoot") or "").strip()
            if isinstance(telegram, dict)
            and telegram.get("status") == "migration-finalized"
            else ""
        )
        if (
            stat.S_ISREG(metadata.st_mode)
            and metadata.st_uid == os.getuid()
            and value
        ):
            durable_candidate = Path(
                os.path.abspath(os.path.expanduser(value))
            )
    except (OSError, ValueError, json.JSONDecodeError):
        pass
launch_script = (
    support / "state" / "runtime" / "isolated" / "telegram_bot_launch.sh"
)
if (
    durable_candidate is None
    and launch_script.is_file()
    and not launch_script.is_symlink()
):
    for line in launch_script.read_text(encoding="utf-8").splitlines():
        if not line.startswith("export CONFIG_DIR="):
            continue
        try:
            words = shlex.split(line[len("export "):])
        except ValueError:
            break
        if len(words) == 1 and words[0].startswith("CONFIG_DIR="):
            value = words[0].split("=", 1)[1]
            if value:
                durable_candidate = Path(
                    os.path.abspath(os.path.expanduser(value))
                )
                break

def is_legacy_preference_root(path):
    parts = path.parts
    suffixes = (
        (
            "viventium_v0_4",
            "telegram-viventium",
            "TelegramVivBot",
            "user_configs",
        ),
        ("viventium_v0_4", "telegram-viventium", "user_configs"),
        ("runtime-state", "telegram-user-configs"),
    )
    return any(
        len(parts) >= len(suffix)
        and tuple(parts[-len(suffix):]) == suffix
        for suffix in suffixes
    )

if (
    durable_candidate is not None
    and durable_candidate != canonical
    and not is_legacy_preference_root(durable_candidate)
):
    print(
        validated_preference_root(
            durable_candidate,
            "Durably observed Telegram preference root",
        )
    )
    raise SystemExit(0)
if authority.is_file() and not authority.is_symlink():
    print(canonical)
    raise SystemExit(0)
if durable_candidate is not None:
    print(durable_candidate)
    raise SystemExit(0)
repo_candidates = []
durable_repo_candidates = []
for state_file in (
    support / "state" / "active-checkout.json",
    support / "helper-config.json",
):
    if not state_file.is_file() or state_file.is_symlink():
        continue
    try:
        metadata = os.lstat(state_file)
        payload = json.loads(state_file.read_text(encoding="utf-8"))
        value = str(payload.get("repoRoot") or "").strip()
        if stat.S_ISREG(metadata.st_mode) and metadata.st_uid == os.getuid() and value:
            candidate_repo = Path(os.path.abspath(os.path.expanduser(value)))
            if candidate_repo not in repo_candidates:
                repo_candidates.append(candidate_repo)
                durable_repo_candidates.append(candidate_repo)
    except (OSError, ValueError, json.JSONDecodeError):
        continue
if repo not in repo_candidates:
    repo_candidates.append(repo)
candidates = []
for candidate_repo in repo_candidates:
    candidates.extend(
        [
            candidate_repo
            / "viventium_v0_4"
            / "telegram-viventium"
            / "TelegramVivBot"
            / "user_configs",
            candidate_repo
            / "viventium_v0_4"
            / "telegram-viventium"
            / "user_configs",
        ]
    )
private_curated = str(os.environ.get("VIVENTIUM_PRIVATE_CURATED_DIR") or "").strip()
private_mirror = str(os.environ.get("VIVENTIUM_PRIVATE_MIRROR_DIR") or "").strip()
if private_curated:
    candidates.append(
        Path(os.path.abspath(os.path.expanduser(private_curated)))
        / "runtime-state"
        / "telegram-user-configs"
    )
if private_mirror:
    candidates.append(
        Path(os.path.abspath(os.path.expanduser(private_mirror)))
        / "viventium_v0_4"
        / "telegram-viventium"
        / "TelegramVivBot"
        / "user_configs"
    )
for candidate in candidates:
    if candidate.is_dir() and not candidate.is_symlink():
        print(candidate)
        raise SystemExit(0)
for candidate_repo in durable_repo_candidates:
    if candidate_repo == repo:
        continue
    if candidate_repo.is_dir() and not candidate_repo.is_symlink():
        continue
    print(
        candidate_repo
        / "viventium_v0_4"
        / "telegram-viventium"
        / "TelegramVivBot"
        / "user_configs"
    )
    raise SystemExit(0)
print(canonical)
PY
}

migrate_telegram_user_configs() {
  local source_repo="${1:-$REPO_ROOT}"
  local active_config_root="${2:-}"
  if [[ -z "$active_config_root" ]]; then
    active_config_root="$(resolve_predecessor_telegram_user_config_root "$source_repo")"
  fi
  local migration_tool="$REPO_ROOT/scripts/viventium/telegram_user_config_migration.py"
  if [[ ! -f "$migration_tool" || -L "$migration_tool" ]]; then
    echo "Telegram preference migration helper is missing or unsafe." >&2
    return 1
  fi
  TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$active_config_root"
  refresh_repo_python
  local migration_result=""
  if ! migration_result="$("$PYTHON_BIN" "$migration_tool" \
    --repo-root "$source_repo" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --active-config-root "$active_config_root" \
    --writer-stopped)"
  then
    return 1
  fi
  local migration_status=""
  migration_status="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("status", ""))' \
      "$migration_result"
  )" || return 1
  if [[ "$migration_status" != "explicit-override-preserved" ]]; then
    TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$APP_SUPPORT_DIR/state/telegram-user-configs"
  fi
}

resume_telegram_user_config_migration_if_pending() {
  local pending="$APP_SUPPORT_DIR/state/telegram-user-config-migration/pending.json"
  if [[ ! -e "$pending" && ! -L "$pending" ]]; then
    return 0
  fi
  if [[ -L "$pending" || ! -f "$pending" ]]; then
    echo "Telegram preference migration recovery journal is unsafe." >&2
    return 1
  fi
  migrate_telegram_user_configs "$REPO_ROOT"
}

initialize_telegram_user_config_authority() {
  local migration_tool="$REPO_ROOT/scripts/viventium/telegram_user_config_migration.py"
  if [[ ! -f "$migration_tool" || -L "$migration_tool" ]]; then
    echo "Telegram preference migration helper is missing or unsafe." >&2
    return 1
  fi
  local active_config_root=""
  active_config_root="$(resolve_predecessor_telegram_user_config_root "$REPO_ROOT")"
  refresh_repo_python
  if ! "$PYTHON_BIN" "$migration_tool" \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --active-config-root "$active_config_root" >/dev/null
  then
    echo "Install found legacy Telegram preferences whose active writer is unknown." >&2
    echo "Use bin/viventium upgrade --restart so the prior bot is stopped and its preferences are handed off safely." >&2
    return 1
  fi
}

load_telegram_predecessor_recovery_component() {
  local staged_selection="${STAGED_TELEGRAM_RECOVERY_SELECTION:-$APP_SUPPORT_DIR/state/runtime-component-staging/telegram-viventium-predecessor.json}"
  local staged_tool="${STAGED_TELEGRAM_COMPONENT_TOOL:-}"
  if [[ -z "${STAGED_TELEGRAM_RECOVERY_SELECTION:-}" &&
    ! -f "$staged_selection" && ! -L "$staged_selection" ]]
  then
    local staging_dir="$APP_SUPPORT_DIR/state/runtime-component-staging"
    local -a legacy_candidates=()
    local candidate=""
    shopt -s nullglob
    legacy_candidates=(
      "$staging_dir"/telegram-viventium-predecessor.json.*
    )
    shopt -u nullglob
    if [[ "${#legacy_candidates[@]}" == "1" ]]; then
      candidate="${legacy_candidates[0]}"
      if [[ -f "$candidate" && ! -L "$candidate" ]]; then
        staged_selection="$candidate"
      fi
    fi
  fi
  if [[ -z "$staged_tool" && -f "$staged_selection" && ! -L "$staged_selection" ]]; then
    staged_tool="$(json_string_field "$staged_selection" component_tool || true)"
  fi
  if [[ -z "$staged_tool" || ! -f "$staged_tool" || -L "$staged_tool" ]]; then
    echo "Telegram predecessor recovery controller is unavailable." >&2
    return 1
  fi
  if ! "$PYTHON_BIN" "$staged_tool" resolve \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --selection-file "$staged_selection" >/dev/null
  then
    return 1
  fi
  STAGED_TELEGRAM_COMPAT_LAUNCHER="$(
    json_string_field "$staged_selection" compat_launcher
  )"
  STAGED_TELEGRAM_COMPONENT_TOOL="$(
    json_string_field "$staged_selection" component_tool
  )"
  STAGED_TELEGRAM_HANDOFF_HELPER="$(
    json_string_field "$staged_selection" handoff_helper
  )"
  STAGED_TELEGRAM_RECOVERY_SELECTION="$staged_selection"
  [[ -n "$STAGED_TELEGRAM_COMPAT_LAUNCHER" &&
    -n "$STAGED_TELEGRAM_COMPONENT_TOOL" &&
    -n "$STAGED_TELEGRAM_HANDOFF_HELPER" ]]
}

load_active_telegram_recovery_component() {
  local expected_kind="${1:-}"
  local expected_path="${2:-}"
  local source_tool=""
  local resolved=""
  local disposition=""
  source_tool="$(
    "$PYTHON_BIN" - "$APP_SUPPORT_DIR" <<'PY'
import json
import os
from pathlib import Path
import stat
import sys

support = Path(os.path.abspath(os.path.expanduser(sys.argv[1])))
receipt = support / "state" / "continuity" / "telegram-recovery-active.json"
try:
    receipt_metadata = os.lstat(receipt)
    payload = json.loads(receipt.read_text(encoding="utf-8"))
    selection = payload.get("selection")
    raw_tool = selection.get("component_tool") if isinstance(selection, dict) else None
    if (
        not stat.S_ISREG(receipt_metadata.st_mode)
        or stat.S_ISLNK(receipt_metadata.st_mode)
        or receipt_metadata.st_uid != os.getuid()
        or stat.S_IMODE(receipt_metadata.st_mode) & 0o077
        or not isinstance(raw_tool, str)
        or not raw_tool
    ):
        raise ValueError("unsafe receipt")
    tool = Path(os.path.abspath(os.path.expanduser(raw_tool)))
    boundary = support / "runtime-components" / "telegram-viventium"
    tool.relative_to(boundary)
    current = support
    for part in tool.relative_to(support).parts:
        current = current / part
        metadata = os.lstat(current)
        if (
            stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or (
                current != tool
                and not stat.S_ISDIR(metadata.st_mode)
            )
        ):
            raise ValueError("unsafe component chain")
    metadata = os.lstat(tool)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_IMODE(metadata.st_mode) & 0o077
    ):
        raise ValueError("unsafe component tool")
except (
    FileNotFoundError,
    json.JSONDecodeError,
    OSError,
    TypeError,
    ValueError,
):
    raise SystemExit(1)
print(tool)
PY
  )" || return 1
  resolved="$(
    "$PYTHON_BIN" "$source_tool" resolve-recovery \
      --app-support-dir "$APP_SUPPORT_DIR"
  )" || return 1
  disposition="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("disposition", ""))' \
      "$resolved"
  )" || return 1
  if [[ "$disposition" != "passive" && "$disposition" != "recovery" ]]; then
    return 1
  fi
  if [[ "$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("transaction_kind", ""))' \
      "$resolved"
  )" != "$expected_kind" ]] ||
    [[ "$(
      "$PYTHON_BIN" -c \
        'import json,sys; print(json.loads(sys.argv[1]).get("transaction_path", ""))' \
        "$resolved"
    )" != "$expected_path" ]]
  then
    return 1
  fi
  STAGED_TELEGRAM_COMPAT_LAUNCHER="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("compat_launcher", ""))' \
      "$resolved"
  )" || return 1
  STAGED_TELEGRAM_COMPONENT_TOOL="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("component_tool", ""))' \
      "$resolved"
  )" || return 1
  STAGED_TELEGRAM_HANDOFF_HELPER="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("handoff_helper", ""))' \
      "$resolved"
  )" || return 1
  STAGED_TELEGRAM_RECOVERY_SELECTION="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("selection_file", ""))' \
      "$resolved"
  )" || return 1
  TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("user_configs_root", ""))' \
      "$resolved"
  )" || return 1
  [[ -n "$STAGED_TELEGRAM_COMPAT_LAUNCHER" &&
    -n "$STAGED_TELEGRAM_COMPONENT_TOOL" &&
    -n "$STAGED_TELEGRAM_HANDOFF_HELPER" &&
    -n "$STAGED_TELEGRAM_RECOVERY_SELECTION" &&
    -n "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" ]]
}

verify_loaded_telegram_recovery_after_rollback() {
  local expected_kind="${1:-}"
  local expected_path="${2:-}"
  local resolved=""
  local disposition=""
  if [[ -z "${STAGED_TELEGRAM_COMPONENT_TOOL:-}" ]] ||
    [[ ! -f "$STAGED_TELEGRAM_COMPONENT_TOOL" ]] ||
    [[ -L "$STAGED_TELEGRAM_COMPONENT_TOOL" ]]
  then
    return 1
  fi
  resolved="$(
    "$PYTHON_BIN" "$STAGED_TELEGRAM_COMPONENT_TOOL" resolve-recovery \
      --app-support-dir "$APP_SUPPORT_DIR"
  )" || return 1
  disposition="$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("disposition", ""))' \
      "$resolved"
  )" || return 1
  [[ "$disposition" == "recovery" ]] || return 1
  [[ "$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("transaction_kind", ""))' \
      "$resolved"
  )" == "$expected_kind" ]] || return 1
  [[ "$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("transaction_path", ""))' \
      "$resolved"
  )" == "$expected_path" ]] || return 1
  [[ "$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("selection_file", ""))' \
      "$resolved"
  )" == "$STAGED_TELEGRAM_RECOVERY_SELECTION" ]] || return 1
  [[ "$(
    "$PYTHON_BIN" -c \
      'import json,sys; print(json.loads(sys.argv[1]).get("user_configs_root", ""))' \
      "$resolved"
  )" == "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" ]]
}

active_telegram_recovery_selection_file() {
  printf '%s\n' "$APP_SUPPORT_DIR/state/continuity/telegram-recovery-active.json"
}

publish_active_telegram_recovery_component() {
  local transaction_kind="${1:-upgrade}"
  local transaction_path="${2:-${UPGRADE_TRANSACTION_DIR:-}}"
  local source_selection="${STAGED_TELEGRAM_RECOVERY_SELECTION:-}"
  local component_tool="${STAGED_TELEGRAM_COMPONENT_TOOL:-}"
  local active_config_root="${TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT:-$APP_SUPPORT_DIR/state/telegram-user-configs}"
  if [[ -z "$source_selection" || -z "$component_tool" ]] ||
    [[ ! -f "$source_selection" || -L "$source_selection" ]] ||
    [[ ! -f "$component_tool" || -L "$component_tool" ]] ||
    [[ -z "$transaction_path" ]]
  then
    echo "Telegram recovery component cannot be made durable." >&2
    return 1
  fi
  "$PYTHON_BIN" "$component_tool" publish-recovery \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --selection-file "$source_selection" \
    --transaction-kind "$transaction_kind" \
    --transaction-path "$transaction_path" \
    --user-configs-root "$active_config_root" >/dev/null
}

clear_active_telegram_recovery_component() {
  local component_tool="${STAGED_TELEGRAM_COMPONENT_TOOL:-$REPO_ROOT/scripts/viventium/telegram_runtime_component.py}"
  if [[ ! -f "$component_tool" || -L "$component_tool" ]]; then
    echo "Telegram recovery controller cannot be retired safely." >&2
    return 1
  fi
  if ! "$PYTHON_BIN" "$component_tool" \
    clear-recovery \
    --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
  then
    return 1
  fi
  local staged_selection="${STAGED_TELEGRAM_RECOVERY_SELECTION:-}"
  case "$staged_selection" in
    "$APP_SUPPORT_DIR"/state/runtime-component-staging/telegram-viventium-predecessor.json.*|\
    "$APP_SUPPORT_DIR"/state/runtime-component-staging/first-upgrade-telegram-recovery-*.json|\
    "$APP_SUPPORT_DIR"/state/runtime-component-staging/telegram-viventium-predecessor.json)
      if [[ -f "$staged_selection" && ! -L "$staged_selection" ]]; then
        rm -f -- "$staged_selection"
      fi
      ;;
  esac
}

bootstrap_life() {
  local life_bootstrap_script="$REPO_ROOT/scripts/viventium/life_bootstrap.py"
  local runtime_env="${1:-$GENERATED_ENV}"
  if [[ ! -f "$runtime_env" || ! -f "$life_bootstrap_script" ]]; then
    return 0
  fi
  local life_bootstrap_status=0
  "$PYTHON_BIN" "$life_bootstrap_script" \
    --runtime-env "$runtime_env" \
    --state-file "$APP_SUPPORT_DIR/state/life-bootstrap.json" || life_bootstrap_status=$?
  if [[ "$life_bootstrap_status" -ne 0 ]]; then
    if (
      set +u
      START_GLASSHIVE=false
      # shellcheck disable=SC1090
      source "$runtime_env"
      case "${START_GLASSHIVE:-false}" in
        1|true|TRUE|True|yes|YES|Yes|on|ON|On) exit 0 ;;
        *) exit 1 ;;
      esac
    ); then
      echo "[viventium] Error: canonical LIFE bootstrap is required by the enabled GlassHive runtime." >&2
      echo "[viventium] Resolve the reported LIFE path conflict before starting chat." >&2
      return "$life_bootstrap_status"
    fi
    echo "[viventium] Warning: canonical LIFE bootstrap could not complete; chat startup will continue." >&2
    echo "[viventium] Fix the configured LIFE path, then rerun bin/viventium configure or start." >&2
  fi
  return 0
}

sync_memory_hardening_schedule() {
  if [[ "$(uname -s)" != "Darwin" || ! -f "$GENERATED_ENV" ]]; then
    return 0
  fi
  local canonical_app_support_dir enabled schedule plist_path
  canonical_app_support_dir="$HOME/Library/Application Support/Viventium"
  if [[ "$APP_SUPPORT_DIR" != "$canonical_app_support_dir" && "${VIVENTIUM_ALLOW_NONCANONICAL_SCHEDULE_MUTATION:-0}" != "1" ]]; then
    echo "Warning: Skipping the machine-global memory hardening schedule for a noncanonical Application Support directory." >&2
    echo "Set VIVENTIUM_ALLOW_NONCANONICAL_SCHEDULE_MUTATION=1 only when this installation intentionally owns the single user LaunchAgent." >&2
    return 0
  fi
  enabled="$(
    awk -F= '$1=="VIVENTIUM_MEMORY_HARDENING_ENABLED"{print $2; exit}' "$GENERATED_ENV" | sed "s/^'//;s/'$//"
  )"
  schedule="$(
    awk -F= '$1=="VIVENTIUM_MEMORY_HARDENING_SCHEDULE"{value=$0; sub(/^VIVENTIUM_MEMORY_HARDENING_SCHEDULE=/, "", value); print value; exit}' "$GENERATED_ENV" | sed "s/^'//;s/'$//"
  )"
  plist_path="$HOME/Library/LaunchAgents/ai.viventium.memory-harden.plist"
  local memory_harden_script="$REPO_ROOT/scripts/viventium/memory_harden.py"
  if [[ "$enabled" == "true" ]]; then
    if [[ ! -f "$memory_harden_script" ]]; then
      echo "Warning: memory hardening is enabled but memory_harden.py was not found." >&2
      return 1
    fi
    if ! "$PYTHON_BIN" "$memory_harden_script" \
      --repo-root "$REPO_ROOT" \
      --app-support-dir "$APP_SUPPORT_DIR" \
      --runtime-dir "$RUNTIME_DIR" \
      install-schedule --schedule "${schedule:-0 3 * * *}" --json >/dev/null; then
      echo "Warning: failed to install memory hardening schedule." >&2
      return 1
    fi
    echo "Memory hardening schedule installed."
  elif [[ "$enabled" == "false" && -f "$plist_path" ]]; then
    if [[ ! -f "$memory_harden_script" ]]; then
      echo "Warning: memory hardening cleanup skipped; memory_harden.py was not found." >&2
      return 0
    fi
    if ! "$PYTHON_BIN" "$memory_harden_script" \
      --repo-root "$REPO_ROOT" \
      --app-support-dir "$APP_SUPPORT_DIR" \
      --runtime-dir "$RUNTIME_DIR" \
      uninstall-schedule --json >/dev/null; then
      echo "Warning: failed to uninstall disabled memory hardening schedule." >&2
      return 1
    fi
    echo "Memory hardening schedule disabled."
  elif [[ -z "$enabled" && -f "$plist_path" ]]; then
    echo "Warning: generated config does not declare memory hardening enabled/disabled; preserving the existing LaunchAgent." >&2
  elif [[ -n "$enabled" && "$enabled" != "false" ]]; then
    echo "Warning: generated memory hardening enabled value '$enabled' is invalid; preserving the existing LaunchAgent." >&2
    return 1
  fi
}

apply_default_nightly_routines() {
  local config_path="${1:-$CONFIG_FILE}"
  [[ -f "$config_path" ]] || return 0
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/default_nightly_routines.py" \
    --config "$config_path" \
    --write \
    --quiet
}

CONFIG_TRANSACTION_DIR=""
CONFIG_CANDIDATE_FILE=""
CONFIG_TRANSACTION_BACKUP=""
CONFIG_TRANSACTION_HAD_EXISTING="false"
CONFIG_TRANSACTION_APPLIED=0

ensure_config_candidate_components() {
  local candidate_config="${1:-}"
  local agents_bundle="$REPO_ROOT/viventium_v0_4/LibreChat/viventium/source_of_truth/local.viventium-agents.yaml"
  if [[ ! -f "$candidate_config" || -L "$candidate_config" ]]; then
    echo "Configuration candidate is unavailable for component selection." >&2
    return 1
  fi

  echo "Verifying the pinned components required to validate this configuration..."
  refresh_repo_python
  if ! VIVENTIUM_DISABLE_PRIVATE_SNAPSHOTS=1 \
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/bootstrap_components.py" \
      --repo-root "$REPO_ROOT" \
      --lock-file "$LOCK_FILE" \
      --config "$candidate_config"
  then
    echo "Fresh-install component bootstrap failed before configuration was applied." >&2
    return 1
  fi
  if [[ ! -f "$agents_bundle" || -L "$agents_bundle" ]]; then
    echo "Pinned LibreChat agent source-of-truth is unavailable after component bootstrap." >&2
    return 1
  fi
  if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/repo_path_safety.py" \
    --repo-root "$REPO_ROOT" \
    --file "$agents_bundle" \
    --label "pinned LibreChat agent source-of-truth" >/dev/null
  then
    echo "Pinned LibreChat agent source-of-truth has an unsafe linked path." >&2
    return 1
  fi
}

prepare_config_candidate() {
  local config_input="$1"
  local candidate_root="$APP_SUPPORT_DIR/state/config-candidates"
  local merged_input=""
  local transaction_args=()
  CONFIG_TRANSACTION_DIR="$(
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_transaction.py" allocate \
      --candidate-root "$candidate_root" \
      --app-support-dir "$APP_SUPPORT_DIR"
  )"
  merged_input="$CONFIG_TRANSACTION_DIR/merged-input.yaml"
  CONFIG_CANDIDATE_FILE="$CONFIG_TRANSACTION_DIR/config.yaml"

  transaction_args=(
    prepare
    --input "$config_input"
    --output "$merged_input"
    --app-support-dir "$APP_SUPPORT_DIR"
  )
  if [[ -f "$CONFIG_FILE" ]]; then
    transaction_args+=(--existing "$CONFIG_FILE")
  fi
  if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_transaction.py" "${transaction_args[@]}"; then
    echo "Unable to prepare a configuration candidate from the supplied settings." >&2
    return 1
  fi

  WIZARD_ARGS=(--output "$CONFIG_CANDIDATE_FILE")
  WIZARD_ARGS+=(--preset "$merged_input" --non-interactive)
  if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/wizard.py" "${WIZARD_ARGS[@]}"; then
    if [[ ! -s "$CONFIG_CANDIDATE_FILE" ]]; then
      echo "Config candidate was not created because the supplied settings failed validation." >&2
    fi
    return 1
  fi
  if [[ ! -s "$CONFIG_CANDIDATE_FILE" ]]; then
    echo "Config candidate was not created; the existing Viventium configuration was left unchanged." >&2
    return 1
  fi
  if ! apply_default_nightly_routines "$CONFIG_CANDIDATE_FILE"; then
    return 1
  fi
  if ! ensure_config_candidate_components "$CONFIG_CANDIDATE_FILE"; then
    return 1
  fi
  if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_compiler.py" \
    --config "$CONFIG_CANDIDATE_FILE" \
    --output-dir "$CONFIG_TRANSACTION_DIR/runtime" \
    --dry-run >/dev/null; then
    return 1
  fi
}

apply_config_candidate() {
  local transaction_status=""
  transaction_status="$(
    "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_transaction.py" apply \
      --candidate "$CONFIG_CANDIDATE_FILE" \
      --config "$CONFIG_FILE" \
      --backup-dir "$APP_SUPPORT_DIR/state/config-backups" \
      --app-support-dir "$APP_SUPPORT_DIR"
  )"
  CONFIG_TRANSACTION_BACKUP="$(
    "$PYTHON_BIN" -c 'import json,sys; print(json.loads(sys.argv[1])["backup_path"])' \
      "$transaction_status"
  )"
  CONFIG_TRANSACTION_HAD_EXISTING="$(
    "$PYTHON_BIN" -c 'import json,sys; print(str(json.loads(sys.argv[1])["had_existing"]).lower())' \
      "$transaction_status"
  )"
  CONFIG_TRANSACTION_APPLIED=1
  if [[ -n "$CONFIG_TRANSACTION_BACKUP" ]]; then
    echo "Backed up the previous config to $(display_safe_path "$CONFIG_TRANSACTION_BACKUP")" >&2
  fi
}

rollback_config_candidate() {
  [[ "$CONFIG_TRANSACTION_APPLIED" == "1" ]] || return 0
  local rollback_args=(
    rollback
    --config "$CONFIG_FILE"
    --had-existing "$CONFIG_TRANSACTION_HAD_EXISTING"
    --app-support-dir "$APP_SUPPORT_DIR"
  )
  if [[ -n "$CONFIG_TRANSACTION_BACKUP" ]]; then
    rollback_args+=(--backup "$CONFIG_TRANSACTION_BACKUP")
  fi
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_transaction.py" "${rollback_args[@]}" >/dev/null
  CONFIG_TRANSACTION_APPLIED=0
  if [[ "$CONFIG_TRANSACTION_HAD_EXISTING" == "true" ]]; then
    if ! compile_config; then
      echo "Config rollback succeeded, but generated runtime refresh failed; run bin/viventium compile-config." >&2
      return 1
    fi
  fi
  echo "Restored the previous canonical config after the failed operation." >&2
}

cleanup_config_candidate() {
  if [[ -z "$CONFIG_TRANSACTION_DIR" ]]; then
    return 0
  fi
  case "$CONFIG_TRANSACTION_DIR" in
    "$APP_SUPPORT_DIR/state/config-candidates/"*)
      rm -rf -- "$CONFIG_TRANSACTION_DIR"
      ;;
    *)
      echo "Refusing to remove unexpected config candidate path: $CONFIG_TRANSACTION_DIR" >&2
      return 1
      ;;
  esac
  CONFIG_TRANSACTION_DIR=""
  CONFIG_CANDIDATE_FILE=""
}

finish_config_candidate() {
  CONFIG_TRANSACTION_APPLIED=0
  cleanup_config_candidate
}

continuity_audit_root() {
  if declare -F continuity_audit_dir >/dev/null 2>&1; then
    continuity_audit_dir "$APP_SUPPORT_DIR"
    return 0
  fi
  printf '%s\n' "$APP_SUPPORT_DIR/state/continuity"
}

continuity_audit_path() {
  local label="${1:-continuity-audit}"
  printf '%s\n' "$(continuity_audit_root)/${label}.json"
}

capture_continuity_audit() {
  local label="${1:-continuity-audit}"
  local output_path="${2:-$(continuity_audit_path "$label")}"
  if [[ "${VIVENTIUM_CONTINUITY_AUDIT_SKIP_PYTHON_REFRESH:-0}" != "1" ]]; then
    refresh_repo_python
  fi
  ensure_app_support_layout "$APP_SUPPORT_DIR"
  prepare_runtime_exports
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/continuity_audit.py" capture \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --config-file "$CONFIG_FILE" \
    --runtime-dir "$RUNTIME_DIR" \
    --label "$label" \
    --output "$output_path" >/dev/null
  printf '%s\n' "$output_path"
}

display_safe_path() {
  local candidate="${1:-}"
  if declare -F public_safe_path_label >/dev/null 2>&1; then
    public_safe_path_label "$candidate"
  else
    printf '%s\n' "$candidate"
  fi
}

compare_upgrade_continuity_audits() {
  local pre_upgrade_manifest="${1:-}"
  local post_upgrade_manifest="${2:-}"
  local label="${3:-upgrade-continuity-comparison}"
  local output_path=""
  local comparison_status=""
  [[ -f "$pre_upgrade_manifest" && -f "$post_upgrade_manifest" ]] || return 1
  output_path="$(continuity_audit_path "$label")"
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/continuity_audit.py" compare \
    --snapshot-manifest "$pre_upgrade_manifest" \
    --live-manifest "$post_upgrade_manifest" \
    --strict-semantic \
    --output "$output_path" >/dev/null
  comparison_status="$(continuity_audit_status "$output_path")"
  echo "Upgrade continuity comparison written to $(display_safe_path "$output_path")"
  if [[ "$comparison_status" != "ok" ]]; then
    echo "Upgrade-protected config, conversations, memory, prompts, auth/channel state, or schedules could not be proven unchanged; rolling back." >&2
    echo "Review $(display_safe_path "$output_path") before retrying." >&2
    return 1
  fi
}

continuity_audit_status() {
  local audit_path="$1"
  if [[ ! -f "$audit_path" ]]; then
    printf '%s\n' "unknown"
    return 0
  fi
  "$PYTHON_BIN" - "$audit_path" <<'PY'
import json
import sys
from pathlib import Path

payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
print(str(payload.get("status") or "unknown"))
PY
}

remove_recall_rebuild_marker() {
  local runtime_profile="${VIVENTIUM_RUNTIME_PROFILE:-isolated}"
  local marker_file=""
  if declare -F recall_rebuild_required_file >/dev/null 2>&1; then
    marker_file="$(recall_rebuild_required_file "$APP_SUPPORT_DIR" "$runtime_profile")"
  else
    marker_file="$APP_SUPPORT_DIR/state/runtime/${runtime_profile}/continuity/recall-rebuild-required.json"
  fi
  if [[ -f "$marker_file" ]]; then
    rm -f "$marker_file"
    printf '%s\n' "$marker_file"
    return 0
  fi
  return 1
}

run_macos_helper_installer() {
  local mode="${1:-install}"
  shift || true
  "$REPO_ROOT/scripts/viventium/install_macos_helper.sh" \
    "$mode" \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    "$@"
}

arm_persistent_telegram_recovery_helper() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  local helper_config="$APP_SUPPORT_DIR/helper-config.json"
  local helper_bundle="${VIVENTIUM_HELPER_APP_BUNDLE:-${VIVENTIUM_HELPER_APP_DIR:-$HOME/Applications}/Viventium.app}"
  if [[ ! -f "$helper_config" || -L "$helper_config" ||
    ! -d "$helper_bundle" || -L "$helper_bundle" ]]
  then
    return 0
  fi
  local before_hash=""
  local after_hash=""
  before_hash="$(shasum -a 256 "$helper_config" | awk '{print $1}')"
  if ! VIVENTIUM_HELPER_RECOVERY_ARM=1 \
    run_macos_helper_installer install \
      --no-launch \
      --preserve-helper-config \
      --recovery-bundle-only
  then
    echo "Upgrade could not pre-activate its persistent rollback-aware helper." >&2
    return 1
  fi
  after_hash="$(shasum -a 256 "$helper_config" | awk '{print $1}')"
  if [[ -z "$before_hash" || "$after_hash" != "$before_hash" ]]; then
    echo "Persistent recovery helper activation changed protected helper configuration." >&2
    return 1
  fi
}

install_ownership_receipt_file() {
  printf '%s\n' "$APP_SUPPORT_DIR/state/install-ownership.json"
}

write_install_ownership_receipt() {
  local helper_owned="${1:-false}"
  local receipt_file=""
  receipt_file="$(install_ownership_receipt_file)"
  mkdir -p "$(dirname "$receipt_file")"
  "$PYTHON_BIN" - "$receipt_file" "$APP_SUPPORT_DIR" "$helper_owned" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path

receipt_path = Path(sys.argv[1])
app_support_dir = str(Path(sys.argv[2]).expanduser().resolve())
helper_owned = sys.argv[3].strip().lower() == "true"
payload = {
    "schema_version": 1,
    "app_support_dir": app_support_dir,
    "helper_owned": helper_owned,
}
fd, temporary = tempfile.mkstemp(prefix=f".{receipt_path.name}.", dir=str(receipt_path.parent))
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, sort_keys=True, separators=(",", ":"))
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, receipt_path)
    os.chmod(receipt_path, 0o600)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

read_install_helper_ownership() {
  local receipt_file=""
  receipt_file="$(install_ownership_receipt_file)"
  [[ -f "$receipt_file" && ! -L "$receipt_file" ]] || {
    printf '%s\n' "unknown"
    return 0
  }
  "$PYTHON_BIN" - "$receipt_file" "$APP_SUPPORT_DIR" <<'PY'
import json
import os
import stat
import sys
from pathlib import Path

path = Path(sys.argv[1])
expected_app_support = str(Path(sys.argv[2]).expanduser().resolve())
try:
    metadata = os.lstat(path)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077:
        raise ValueError("unsafe receipt metadata")
    payload = json.loads(path.read_text(encoding="utf-8"))
    if payload.get("schema_version") != 1:
        raise ValueError("unsupported receipt")
    if str(Path(str(payload.get("app_support_dir") or "")).expanduser().resolve()) != expected_app_support:
        raise ValueError("receipt target mismatch")
    helper_owned = payload.get("helper_owned")
    if not isinstance(helper_owned, bool):
        raise ValueError("invalid helper ownership")
except Exception:
    print("unknown")
else:
    print("owned" if helper_owned else "not-owned")
PY
}

legacy_helper_ownership_matches_install() {
  local helper_config="$APP_SUPPORT_DIR/helper-config.json"
  local helper_bundle="${VIVENTIUM_HELPER_APP_BUNDLE:-${VIVENTIUM_HELPER_APP_DIR:-$HOME/Applications}/Viventium.app}"
  local owner_marker="$helper_bundle/Contents/Resources/viventium-owner.json"
  [[ -f "$helper_config" && ! -L "$helper_config" && -f "$owner_marker" && ! -L "$owner_marker" ]] || return 1
  "$PYTHON_BIN" - "$helper_config" "$owner_marker" "$APP_SUPPORT_DIR" <<'PY'
import json
import os
import stat
import sys
from pathlib import Path

config_path, marker_path = map(Path, sys.argv[1:3])
expected_app_support = str(Path(sys.argv[3]).expanduser().resolve())
for path in (config_path, marker_path):
    metadata = os.lstat(path)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
        raise SystemExit(1)
try:
    config = json.loads(config_path.read_text(encoding="utf-8"))
    marker = json.loads(marker_path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)
configured_app_support = str(Path(str(config.get("appSupportDir") or "")).expanduser().resolve())
if configured_app_support != expected_app_support:
    raise SystemExit(1)
if marker.get("product") != "ai.viventium.helper" or marker.get("schema_version") != 1:
    raise SystemExit(1)
PY
}

run_macos_helper_install_command() {
  local skip_login_item="${1:-0}"
  shift || true

  if [[ "$skip_login_item" == "1" ]]; then
    if [[ "$#" -gt 0 ]]; then
      VIVENTIUM_HELPER_SKIP_LOGIN_ITEM=1 run_macos_helper_installer install "$@"
    else
      VIVENTIUM_HELPER_SKIP_LOGIN_ITEM=1 run_macos_helper_installer install
    fi
    return $?
  fi

  if [[ "$#" -gt 0 ]]; then
    run_macos_helper_installer install "$@"
  else
    run_macos_helper_installer install
  fi
}

maybe_install_macos_helper() {
  if [[ "${VIVENTIUM_SKIP_HELPER_INSTALL:-0}" == "1" ]]; then
    write_install_ownership_receipt false
    return 0
  fi
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  local helper_args=()
  local defer_launch=0
  local helper_install_succeeded=0

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --no-launch)
        defer_launch=1
        shift
        ;;
      *)
        echo "Unknown helper install option: $1" >&2
        return 1
        ;;
    esac
  done

  if [[ "$defer_launch" == "1" || "${HEADLESS:-0}" == "1" || "${AUTO_START:-1}" != "1" ]]; then
    helper_args+=(--no-launch)
  fi

  if [[ "${HEADLESS:-0}" == "1" ]]; then
    if [[ ${#helper_args[@]} -gt 0 ]]; then
      if ! run_macos_helper_install_command 1 "${helper_args[@]}"; then
        echo "Warning: Viventium installed, but the macOS status-bar helper failed to install." >&2
      else
        helper_install_succeeded=1
      fi
    elif ! run_macos_helper_install_command 1; then
      echo "Warning: Viventium installed, but the macOS status-bar helper failed to install." >&2
    else
      helper_install_succeeded=1
    fi
    [[ "$helper_install_succeeded" == "1" ]] && write_install_ownership_receipt true
    return 0
  fi

  if [[ ${#helper_args[@]} -gt 0 ]]; then
    if ! run_macos_helper_install_command 0 "${helper_args[@]}"; then
      echo "Warning: Viventium installed, but the macOS status-bar helper failed to install." >&2
    else
      helper_install_succeeded=1
    fi
  elif ! run_macos_helper_install_command 0; then
    echo "Warning: Viventium installed, but the macOS status-bar helper failed to install." >&2
  else
    helper_install_succeeded=1
  fi
  [[ "$helper_install_succeeded" == "1" ]] && write_install_ownership_receipt true
}

launch_macos_helper_app() {
  [[ "${VIVENTIUM_SKIP_HELPER_INSTALL:-0}" == "1" ]] && return 0
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  [[ "${HEADLESS:-0}" == "1" ]] && return 0

  local helper_app_bundle="${VIVENTIUM_HELPER_APP_BUNDLE:-$HOME/Applications/Viventium.app}"
  [[ -d "$helper_app_bundle" ]] || return 0

  /usr/bin/open -g "$helper_app_bundle" >/dev/null 2>&1 || true
}

run_status_bar_command() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "The Viventium status-bar helper is only available on macOS." >&2
    exit 1
  fi

  local action="${1:-status}"
  shift || true
  if [[ "$#" -gt 0 ]]; then
    echo "Unknown status-bar option: $1" >&2
    exit 1
  fi

  case "$action" in
    on)
      set_helper_status_bar_visibility 1
      run_macos_helper_install_command 0 --no-launch
      echo "Viventium status-bar helper is enabled."
      echo "Launch ~/Applications/Viventium.app to show it immediately."
      ;;
    off)
      set_helper_status_bar_visibility 0
      pkill -x ViventiumHelper >/dev/null 2>&1 || true
      echo "Viventium status-bar helper is hidden."
      echo "Run bin/viventium status-bar on to bring it back."
      ;;
    status)
      if helper_status_bar_enabled; then
        echo "Viventium status-bar helper: on"
      else
        echo "Viventium status-bar helper: off"
      fi
      ;;
    *)
      echo "Unknown status-bar action: $action" >&2
      subcommand_usage status-bar >&2
      exit 1
      ;;
  esac
}

expand_user_path() {
  local candidate="${1:-}"
  case "$candidate" in
    "~")
      printf '%s\n' "$HOME"
      ;;
    "~/"*)
      printf '%s/%s\n' "$HOME" "${candidate#~/}"
      ;;
    *)
      printf '%s\n' "$candidate"
      ;;
  esac
}

json_string_field() {
  local json_file="${1:-}"
  local field_name="${2:-}"
  [[ -f "$json_file" && -n "$field_name" ]] || return 1
  refresh_repo_python
  "$PYTHON_BIN" - "$json_file" "$field_name" <<'PY'
import json
import sys
from pathlib import Path

path, field_name = sys.argv[1:]
try:
    payload = json.loads(Path(path).read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)
value = payload.get(field_name)
if value is None:
    raise SystemExit(1)
print(str(value))
PY
}

write_runtime_checkout_setting() {
  local repo_root="${1:-}"
  local allow_protected="${2:-0}"
  local state_file=""
  state_file="$(runtime_checkout_file)"
  refresh_repo_python
  "$PYTHON_BIN" - "$state_file" "$repo_root" "$allow_protected" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

state_file, repo_root, allow_protected = sys.argv[1:]
payload = {
    "repoRoot": str(Path(repo_root).expanduser().resolve()),
    "allowProtectedFolderAccess": allow_protected == "1",
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "source": "bin/viventium runtime-checkout",
}
path = Path(state_file)
path.parent.mkdir(parents=True, exist_ok=True)
tmp_path = path.with_name(f".{path.name}.tmp")
tmp_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
os.replace(tmp_path, path)
PY
}

runtime_checkout_refresh_helper() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  local active_repo=""
  active_repo="$(active_runtime_checkout_repo_root "$APP_SUPPORT_DIR" 2>/dev/null || true)"
  if [[ -n "$active_repo" ]] && path_is_viventium_runtime_repo_root "$active_repo"; then
    active_repo="$(canonicalize_existing_dir "$active_repo")"
  else
    active_repo="$REPO_ROOT"
  fi

  if [[ "$active_repo" != "$(canonicalize_existing_dir "$REPO_ROOT")" ]]; then
    echo "Refreshing helper from active checkout: $(display_safe_path "$active_repo")"
    "$active_repo/bin/viventium" \
      --app-support-dir "$APP_SUPPORT_DIR" \
      --config-file "$CONFIG_FILE" \
      --runtime-dir "$RUNTIME_DIR" \
      install-helper \
      --no-launch
  else
    run_macos_helper_install_command 0 --no-launch
  fi
  launch_macos_helper_app
  echo "Viventium status-bar helper refreshed and relaunched."
}

recover_interrupted_helper_install() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  local receipt="$APP_SUPPORT_DIR/state/helper-install-in-progress.json"
  [[ -e "$receipt" ]] || return 0
  if [[ -L "$receipt" || ! -f "$receipt" ]]; then
    echo "Refusing unsafe interrupted helper-install receipt: $(display_safe_path "$receipt")" >&2
    return 1
  fi
  echo "Finishing an interrupted Viventium helper installation..."
  if ! runtime_checkout_refresh_helper; then
    echo "Interrupted helper installation is still pending and will retry on the next start." >&2
    return 1
  fi
  if [[ -e "$receipt" ]]; then
    echo "Helper installer returned without clearing its durable recovery receipt." >&2
    return 1
  fi
}

runtime_checkout_status() {
  local active_repo=""
  local helper_repo=""
  local owner_repo=""
  local state_file=""
  local helper_config=""
  local owner_file=""
  state_file="$(runtime_checkout_file)"
  helper_config="$(helper_config_file)"
  owner_file="$(stack_owner_state_file)"

  active_repo="$(active_runtime_checkout_repo_root "$APP_SUPPORT_DIR" 2>/dev/null || true)"
  if [[ -n "$active_repo" ]]; then
    if active_runtime_checkout_allows_protected_folder_access "$APP_SUPPORT_DIR"; then
      echo "Active runtime checkout: $(display_safe_path "$active_repo") (developer protected-folder access allowed)"
    else
      echo "Active runtime checkout: $(display_safe_path "$active_repo")"
    fi
  elif [[ -f "$state_file" ]]; then
    echo "Active runtime checkout: invalid setting at $(display_safe_path "$state_file")"
  else
    echo "Active runtime checkout: automatic"
  fi

  helper_repo="$(json_string_field "$helper_config" repoRoot 2>/dev/null || true)"
  if [[ -n "$helper_repo" ]]; then
    echo "Helper checkout: $(display_safe_path "$helper_repo")"
  else
    echo "Helper checkout: not installed"
  fi

  owner_repo="$(json_string_field "$owner_file" repoRoot 2>/dev/null || true)"
  if [[ -n "$owner_repo" ]]; then
    echo "Live stack owner: $(display_safe_path "$owner_repo")"
  else
    echo "Live stack owner: none recorded"
  fi

  echo "This command checkout: $(display_safe_path "$REPO_ROOT")"
}

runtime_checkout_command() {
  local action="${1:-status}"
  shift || true

  case "$action" in
    status)
      if [[ "$#" -gt 0 ]]; then
        echo "Unknown runtime-checkout status option: $1" >&2
        exit 1
      fi
      runtime_checkout_status
      ;;
    use)
      local target=""
      local allow_protected=0
      local refresh_helper=1

      while [[ $# -gt 0 ]]; do
        case "${1:-}" in
          --this)
            target="$REPO_ROOT"
            shift
            ;;
          --allow-protected-folder)
            allow_protected=1
            shift
            ;;
          --no-helper-refresh)
            refresh_helper=0
            shift
            ;;
          --help|-h)
            subcommand_usage runtime-checkout
            exit 0
            ;;
          -*)
            echo "Unknown runtime-checkout use option: $1" >&2
            exit 1
            ;;
          *)
            if [[ -n "$target" ]]; then
              echo "Only one runtime checkout path can be selected." >&2
              exit 1
            fi
            target="$1"
            shift
            ;;
        esac
      done

      if [[ -z "$target" ]]; then
        echo "Missing runtime checkout path. Use --this or pass a checkout path." >&2
        exit 1
      fi
      target="$(expand_user_path "$target")"
      if ! path_is_viventium_runtime_repo_root "$target"; then
        echo "Not a valid Viventium runtime checkout: $target" >&2
        echo "Expected bin/viventium, scripts/viventium/common.sh, and viventium_v0_4/viventium-librechat-start.sh." >&2
        exit 1
      fi
      target="$(canonicalize_existing_dir "$target")"

      if repo_root_uses_macos_protected_folder_access "$target" && [[ "$allow_protected" != "1" ]]; then
        echo "Refusing to select a checkout inside Documents, Desktop, or Downloads without explicit acknowledgement." >&2
        echo "Rerun with --allow-protected-folder if this is an intentional developer checkout. macOS may ask the helper for folder access." >&2
        exit 1
      fi

      ensure_app_support_layout "$APP_SUPPORT_DIR"
      write_runtime_checkout_setting "$target" "$allow_protected"
      echo "Active runtime checkout set to $(display_safe_path "$target")."
      if [[ "$allow_protected" == "1" && "$(uname -s)" == "Darwin" ]]; then
        echo "Developer protected-folder access is allowed for this checkout; macOS may prompt the helper for folder access."
      fi

      if [[ "$refresh_helper" == "1" ]]; then
        runtime_checkout_refresh_helper
      else
        echo "Skipped helper refresh; run bin/viventium install-helper --no-launch when ready."
      fi

      local owner_repo=""
      owner_repo="$(json_string_field "$(stack_owner_state_file)" repoRoot 2>/dev/null || true)"
      if [[ -n "$owner_repo" && "$(canonicalize_existing_dir "$owner_repo" 2>/dev/null || true)" != "$target" ]]; then
        echo "Current live stack still belongs to $(display_safe_path "$owner_repo"). Stop and start when you want this checkout to take over."
      fi
      ;;
    clear)
      local refresh_helper=1
      while [[ $# -gt 0 ]]; do
        case "${1:-}" in
          --no-helper-refresh)
            refresh_helper=0
            shift
            ;;
          --help|-h)
            subcommand_usage runtime-checkout
            exit 0
            ;;
          *)
            echo "Unknown runtime-checkout clear option: $1" >&2
            exit 1
            ;;
        esac
      done

      rm -f "$(runtime_checkout_file)"
      echo "Active runtime checkout cleared; helper/start will use automatic checkout resolution."
      if [[ "$refresh_helper" == "1" ]]; then
        runtime_checkout_refresh_helper
      else
        echo "Skipped helper refresh; run bin/viventium install-helper --no-launch when ready."
      fi
      ;;
    --help|-h|help)
      subcommand_usage runtime-checkout
      ;;
    *)
      echo "Unknown runtime-checkout action: $action" >&2
      subcommand_usage runtime-checkout >&2
      exit 1
      ;;
  esac
}

dev_env_command() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
    subcommand_usage dev-env
    exit 0
  fi
  ensure_app_support_layout "$APP_SUPPORT_DIR"
  exec "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/dev_runtime.py" \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --config-file "$CONFIG_FILE" \
    "$@"
}

dev_runtime_activation_tool() {
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/dev_runtime_activation.py" "$@"
}

quiesce_macos_helper_process_for_activation() {
  local transaction_dir="${1:-}"
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  local helper_app_dir="${VIVENTIUM_HELPER_APP_DIR:-$HOME/Applications}"
  local helper_bundle="${VIVENTIUM_HELPER_APP_BUNDLE:-$helper_app_dir/Viventium.app}"
  local legacy_bundle="${VIVENTIUM_HELPER_LEGACY_APP_BUNDLE:-$helper_app_dir/Viventium Helper.app}"
  dev_runtime_activation_tool quiesce-helper-process \
    --transaction-dir "$transaction_dir" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --helper-executable "$helper_bundle/Contents/MacOS/ViventiumHelper" \
    --helper-executable "$legacy_bundle/Contents/MacOS/ViventiumHelper" >/dev/null
}

restore_dev_runtime_helper_process_after_rollback() {
  local transaction_dir="${1:-}"
  dev_runtime_activation_tool restore-helper-process \
    --transaction-dir "$transaction_dir" \
    --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
}

dev_runtime_owner_env_alignment_required() {
  local transaction_dir="${1:-}"
  local alignment_json=""
  alignment_json="$(
    dev_runtime_activation_tool alignment-status \
      --transaction-dir "$transaction_dir" \
      --app-support-dir "$APP_SUPPORT_DIR"
  )" || return 1
  printf '%s\n' "$alignment_json" |
    "$PYTHON_BIN" -c \
      'import json,sys; print(1 if json.load(sys.stdin).get("required") else 0)'
}

align_committed_dev_runtime_owner_env() {
  local transaction_dir="${1:-}"
  local alignment_json=""
  local expected_receipt=""
  alignment_json="$(
    dev_runtime_activation_tool alignment-status \
      --transaction-dir "$transaction_dir" \
      --app-support-dir "$APP_SUPPORT_DIR"
  )" || return 1
  expected_receipt="$(
    printf '%s\n' "$alignment_json" |
      "$PYTHON_BIN" -c \
        'import json,sys; print(json.dumps(json.load(sys.stdin).get("currentReceipt"), sort_keys=True))'
  )" || return 1
  if [[ -z "$expected_receipt" || "$expected_receipt" == "null" ]]; then
    echo "Committed runtime owner-environment alignment receipt is unavailable." >&2
    return 1
  fi
  # The current candidate owner file may contain a preserved post-acceptance
  # edit. Use that exact file as canonical during the alignment restart so a
  # deleted provider key cannot be resurrected from the older staged snapshot.
  export VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE="$REPO_ROOT/viventium_v0_4/LibreChat/.env"
  if ! force_restart_stack_after_owner_env_alignment; then
    unset VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE
    return 1
  fi
  unset VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE
  dev_runtime_activation_tool mark-aligned \
    --transaction-dir "$transaction_dir" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --expected-receipt-json "$expected_receipt" >/dev/null
}

remove_dev_runtime_activation_transaction() {
  local transaction_dir="${1:-}"
  local telegram_recovery_receipt=""
  telegram_recovery_receipt="$(active_telegram_recovery_selection_file)"
  if [[ -e "$telegram_recovery_receipt" || -L "$telegram_recovery_receipt" ]]; then
    echo "Refusing to remove a dev-runtime transaction while Telegram recovery is still active." >&2
    return 1
  fi
  case "$transaction_dir" in
    "$APP_SUPPORT_DIR"/state/dev-runtime-activation.*)
      rm -rf -- "$transaction_dir"
      ;;
    *)
      echo "Refusing to remove an unrecognized dev-runtime activation path." >&2
      return 1
      ;;
  esac
}

rollback_prepared_dev_runtime_activation() {
  local transaction_dir="${1:-}"
  local recovery_receipt_loaded=0
  local active_receipt=""
  active_receipt="$(active_telegram_recovery_selection_file)"
  if [[ -e "$active_receipt" || -L "$active_receipt" ]]; then
    if ! load_active_telegram_recovery_component \
      "dev-runtime-activation" "$transaction_dir"
    then
      echo "Prepared activation rollback could not validate its sealed Telegram recovery receipt." >&2
      return 1
    fi
    recovery_receipt_loaded=1
  fi
  if ! dev_runtime_activation_tool rollback \
    --transaction-dir "$transaction_dir" \
    --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
  then
    echo "Prepared activation rollback failed closed; the transaction remains for recovery." >&2
    return 1
  fi
  if [[ "$recovery_receipt_loaded" == "1" ]] &&
    ! verify_loaded_telegram_recovery_after_rollback \
      "dev-runtime-activation" "$transaction_dir"
  then
    echo "Prepared activation rollback restored state, but its sealed Telegram recovery receipt no longer matches." >&2
    return 1
  fi
  if ! restore_dev_runtime_helper_process_after_rollback "$transaction_dir"; then
    echo "Prepared activation rolled back, but its prior helper process could not be restored." >&2
    return 1
  fi
  if [[ "$recovery_receipt_loaded" == "1" ]] &&
    ! clear_active_telegram_recovery_component
  then
    echo "Prepared activation rolled back, but its sealed Telegram recovery receipt could not be retired." >&2
    return 1
  fi
  remove_dev_runtime_activation_transaction "$transaction_dir"
}

restore_previous_dev_runtime_after_failure() {
  local transaction_dir="${1:-}"
  local previous_repo="${2:-}"
  local was_running="${3:-0}"
  local rollback_status=0
  local recovery_receipt_loaded=0
  local loaded_receipt_config_root=""

  if ! VIVENTIUM_PRESERVE_HELPER_RUNTIME_INTENT=1 \
    VIVENTIUM_DEV_RUNTIME_RECOVERY_INTERNAL=1 \
    VIVENTIUM_CLI_LOCK_INHERITED_ONCE=1 \
    stop_stack_for_upgrade >/dev/null 2>&1
  then
    echo "Candidate runtime could not be stopped; refusing to replace live generated state during rollback." >&2
    echo "The recoverable activation transaction remains at $(display_safe_path "$transaction_dir")." >&2
    return 1
  fi
  if load_active_telegram_recovery_component \
    "dev-runtime-activation" "$transaction_dir"
  then
    recovery_receipt_loaded=1
    loaded_receipt_config_root="$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT"
  elif ! load_telegram_predecessor_recovery_component; then
    echo "The prior runtime's staged Telegram recovery component is unavailable." >&2
    return 1
  fi
  if ! resume_telegram_user_config_migration_if_pending; then
    echo "Dev-runtime rollback could not complete its stopped-writer Telegram preference journal." >&2
    echo "The recoverable activation transaction remains at $(display_safe_path "$transaction_dir")." >&2
    return 1
  fi
  if ! migrate_telegram_user_configs \
    "$previous_repo" "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT"
  then
    echo "Dev-runtime rollback could not reconcile the stopped-writer Telegram preference authority." >&2
    echo "The recoverable activation transaction remains at $(display_safe_path "$transaction_dir")." >&2
    return 1
  fi
  TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
    resolve_predecessor_telegram_user_config_root "$previous_repo"
  )" || return 1
  if [[ "$recovery_receipt_loaded" != "1" ||
    "$loaded_receipt_config_root" != "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" ]]
  then
    if ! publish_active_telegram_recovery_component \
      "dev-runtime-activation" "$transaction_dir" ||
      ! load_active_telegram_recovery_component \
        "dev-runtime-activation" "$transaction_dir"
    then
      echo "Dev-runtime rollback could not bind sealed recovery to the committed Telegram preference authority." >&2
      return 1
    fi
    recovery_receipt_loaded=1
    loaded_receipt_config_root="$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT"
  fi
  dev_runtime_activation_tool rollback \
    --transaction-dir "$transaction_dir" \
    --app-support-dir "$APP_SUPPORT_DIR" >/dev/null || rollback_status=$?
  if [[ "$rollback_status" != "0" ]]; then
    echo "Dev-runtime activation rollback failed closed; the transaction remains at $(display_safe_path "$transaction_dir")." >&2
    return "$rollback_status"
  fi
  if [[ "$recovery_receipt_loaded" == "1" ]]; then
    if ! verify_loaded_telegram_recovery_after_rollback \
      "dev-runtime-activation" "$transaction_dir"
    then
      echo "The prior runtime was restored, but its sealed Telegram recovery receipt no longer matches." >&2
      return 1
    fi
  else
    echo "The prior runtime was restored without a validated Telegram recovery receipt." >&2
    return 1
  fi
  if [[ "$was_running" == "1" ]]; then
    if [[ -z "$previous_repo" ]] ||
      ! path_is_viventium_runtime_repo_root "$previous_repo"
    then
      echo "The prior runtime files and binding were restored, but its checkout could not be resolved for restart." >&2
      return 1
    fi
    if ! VIVENTIUM_PRESERVE_HELPER_RUNTIME_INTENT=1 \
      VIVENTIUM_DEV_RUNTIME_RECOVERY_INTERNAL=1 \
      VIVENTIUM_DETACHED_INHERIT_CLI_LOCK=1 \
      VIVENTIUM_DETACHED_REPO_ROOT="$previous_repo" \
      VIVENTIUM_DETACHED_LOCK_FILE="$previous_repo/components.lock.json" \
      VIVENTIUM_DETACHED_COMPAT_LAUNCHER="$STAGED_TELEGRAM_COMPAT_LAUNCHER" \
      VIVENTIUM_TELEGRAM_COMPONENT_SELECTION_FILE="$STAGED_TELEGRAM_RECOVERY_SELECTION" \
      VIVENTIUM_TELEGRAM_COMPONENT_TOOL="$STAGED_TELEGRAM_COMPONENT_TOOL" \
      VIVENTIUM_TELEGRAM_POLLER_HANDOFF_HELPER="$STAGED_TELEGRAM_HANDOFF_HELPER" \
      VIVENTIUM_TELEGRAM_USER_CONFIGS_DIR="${TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT:-$APP_SUPPORT_DIR/state/telegram-user-configs}" \
      VIVENTIUM_LIBRECHAT_CANONICAL_ENV_FILE="" \
      launch_stack_detached
    then
      echo "The prior runtime files and binding were restored, but its running state could not be resumed." >&2
      return 1
    fi
    if ! wait_for_upgrade_runtime_health; then
      echo "The prior checkout relaunched but did not return to full configured health." >&2
      return 1
    fi
  fi
  if ! restore_dev_runtime_helper_process_after_rollback "$transaction_dir"; then
    echo "The prior runtime was restored, but its prior helper process could not be restored." >&2
    return 1
  fi
  if ! clear_active_telegram_recovery_component; then
    echo "The prior runtime and helper were restored, but Telegram recovery could not be retired safely." >&2
    return 1
  fi
  remove_dev_runtime_activation_transaction "$transaction_dir"
}

recover_interrupted_dev_runtime_activations() {
  local transaction_dir=""
  local status_json=""
  local activation_status=""
  local previous_repo=""
  local was_running=""
  if [[ "${VIVENTIUM_DEV_RUNTIME_RECOVERY_INTERNAL:-0}" == "1" ]]; then
    return 0
  fi
  DEV_RUNTIME_RECOVERY_PERFORMED=0
  for transaction_dir in "$APP_SUPPORT_DIR"/state/dev-runtime-activation.*; do
    [[ -d "$transaction_dir" ]] || continue
    status_json="$(
      dev_runtime_activation_tool status \
        --transaction-dir "$transaction_dir" \
        --app-support-dir "$APP_SUPPORT_DIR"
    )" || return 1
    activation_status="$(
      printf '%s\n' "$status_json" |
        "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("status", ""))'
    )" || return 1
    previous_repo="$(
      printf '%s\n' "$status_json" |
        "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("previousRepo", ""))'
    )" || return 1
    was_running="$(
      printf '%s\n' "$status_json" |
        "$PYTHON_BIN" -c 'import json,sys; print("1" if json.load(sys.stdin).get("wasRunning") else "0")'
    )" || return 1
    TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
      printf '%s\n' "$status_json" |
        "$PYTHON_BIN" -c \
          'import json,sys; print(json.load(sys.stdin).get("telegramPreferenceRoot", ""))'
    )" || return 1
    STAGED_TELEGRAM_RECOVERY_SELECTION="$(
      printf '%s\n' "$status_json" |
        "$PYTHON_BIN" -c \
          'import json,sys; print(json.load(sys.stdin).get("telegramRecoverySelection", ""))'
    )" || return 1
    case "$activation_status" in
      committed)
        clear_active_telegram_recovery_component || return 1
        remove_dev_runtime_activation_transaction "$transaction_dir"
        ;;
      rolled_back)
        restore_previous_dev_runtime_after_failure \
          "$transaction_dir" "$previous_repo" "$was_running" || return 1
        DEV_RUNTIME_RECOVERY_PERFORMED=1
        ;;
      core_committed)
        local alignment_required=0
        alignment_required="$(
          dev_runtime_owner_env_alignment_required "$transaction_dir"
        )" || return 1
        if [[ "$alignment_required" == "1" ]]; then
          if is_stack_running; then
            echo "Realigning the committed runtime to a preserved owner environment edit..."
            if ! align_committed_dev_runtime_owner_env "$transaction_dir"; then
              echo "The candidate runtime remains committed, but owner-environment alignment will retry on the next start or dev-runtime command." >&2
              return 1
            fi
          elif ! dev_runtime_activation_tool mark-aligned \
            --transaction-dir "$transaction_dir" \
            --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
          then
            echo "The stopped candidate remains committed, but owner-environment alignment acknowledgement will retry on the next start or dev-runtime command." >&2
            return 1
          fi
        fi
        echo "Finishing the committed local-runtime helper refresh..."
        if ! runtime_checkout_refresh_helper; then
          echo "The candidate runtime remains committed and healthy; helper refresh will retry on the next start or dev-runtime command." >&2
          return 1
        fi
        if ! dev_runtime_activation_tool finalize-helper \
          --transaction-dir "$transaction_dir" \
          --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
        then
          echo "The candidate runtime remains committed; helper finalization receipt is still pending." >&2
          return 1
        fi
        clear_active_telegram_recovery_component || return 1
        remove_dev_runtime_activation_transaction "$transaction_dir"
        DEV_RUNTIME_RECOVERY_PERFORMED=1
        ;;
      prepared)
        # The old process may already have been stopped immediately before
        # the activator died, and a passive recovery receipt may already
        # reference this prepared ledger even when the prior runtime was
        # intentionally stopped.
        restore_previous_dev_runtime_after_failure \
          "$transaction_dir" "$previous_repo" "$was_running" || return 1
        DEV_RUNTIME_RECOVERY_PERFORMED=1
        ;;
      publishing|runtime_backed_up|published|binding_applied|commit_env_accepted|commit_env_finalizing)
        restore_previous_dev_runtime_after_failure \
          "$transaction_dir" "$previous_repo" "$was_running" || return 1
        DEV_RUNTIME_RECOVERY_PERFORMED=1
        ;;
      *)
        echo "Unknown interrupted dev-runtime activation stage: $activation_status" >&2
        return 1
        ;;
    esac
  done
}

dev_runtime_command() {
  local action="${1:-status}"
  shift || true
  if ! recover_interrupted_dev_runtime_activations; then
    echo "Interrupted dev-runtime activation recovery failed closed." >&2
    return 1
  fi
  case "$action" in
    status)
      runtime_checkout_status
      ;;
    clear)
      runtime_checkout_command clear "$@"
      ;;
    activate-current)
      local validate=0
      local restart=0
      local allow_protected=0
      local allow_dirty=0
      local activation_config_sha256=""
      local current_config_sha256=""
      while [[ $# -gt 0 ]]; do
        case "${1:-}" in
          --validate)
            validate=1
            shift
            ;;
          --restart)
            restart=1
            shift
            ;;
          --allow-protected-folder)
            allow_protected=1
            shift
            ;;
          --allow-dirty-local-testing)
            allow_dirty=1
            shift
            ;;
          --help|-h)
            subcommand_usage dev-runtime
            exit 0
            ;;
          *)
            echo "Unknown dev-runtime activate-current option: $1" >&2
            exit 1
            ;;
        esac
      done
      ensure_upgradeable_git_state "$allow_dirty" 0
      if ! ensure_local_checkout_alignment "$allow_dirty"; then
        echo "Dev-runtime activation aborted before config, runtime, helper, or binding mutation." >&2
        return 1
      fi
      if [[ "$restart" == "1" && "$validate" != "1" ]]; then
        echo "dev-runtime restart requires --validate so promotion can be rolled back safely." >&2
        return 1
      fi
      if [[ "$validate" != "1" ]]; then
        local runtime_checkout_args=(use --this --no-helper-refresh)
        if [[ "$allow_protected" == "1" ]]; then
          runtime_checkout_args+=(--allow-protected-folder)
        fi
        runtime_checkout_command "${runtime_checkout_args[@]}"
        return 0
      fi

      if ! activation_config_sha256="$(config_file_sha256 "$CONFIG_FILE")"; then
        echo "Dev-runtime activation could not bind the canonical config to this attempt." >&2
        echo "Config, runtime, helper, and binding state were not changed." >&2
        return 1
      fi
      if ! bootstrap_components --prefer-existing-checkout-head \
        --expected-config-sha256 "$activation_config_sha256"
      then
        echo "Dev-runtime activation could not bootstrap the configured pinned components." >&2
        echo "Config, runtime, helper, and binding state were not changed." >&2
        return 1
      fi
      if ! bootstrap_components --validate-only --strict-pinned \
        --expected-config-sha256 "$activation_config_sha256"
      then
        echo "Dev-runtime activation found a selected component outside its exact clean pin." >&2
        echo "Config, runtime, helper, and binding state were not changed." >&2
        return 1
      fi
      if ! ensure_local_checkout_alignment "$allow_dirty" "$activation_config_sha256"; then
        echo "Dev-runtime activation aborted before App Support or live runtime mutation because component bootstrap did not reach a safe aligned state." >&2
        return 1
      fi
      if ! bootstrap_components --validate-only --strict-pinned \
        --expected-config-sha256 "$activation_config_sha256"
      then
        echo "Dev-runtime activation detected component selection drift before App Support mutation." >&2
        echo "Config, runtime, helper, and binding state were not changed." >&2
        return 1
      fi
      current_config_sha256="$(
        config_file_sha256 "$CONFIG_FILE" 2>/dev/null || true
      )"
      if [[ "$current_config_sha256" != "$activation_config_sha256" ]]; then
        echo "Dev-runtime activation detected a concurrent canonical config change." >&2
        echo "Config, runtime, helper, and binding state were not changed." >&2
        return 1
      fi

      ensure_app_support_layout "$APP_SUPPORT_DIR"
      refresh_repo_python
      if ! VIVENTIUM_LIBRECHAT_SOURCE_PHASE="compile" \
        "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_compiler.py" \
          --config "$CONFIG_FILE" \
          --output-dir "$RUNTIME_DIR" \
          --dry-run >/dev/null
      then
        echo "Runtime activation validation failed before Telegram staging; binding, live runtime, helper, and running state were not changed." >&2
        return 1
      fi
      local activation_dir=""
      local candidate_runtime=""
      local previous_repo=""
      local owner_repo=""
      local activation_commit_status=""
      local activation_begin_json=""
      local owner_env_source=""
      local owner_env_destination=""
      local owner_env_manifest=""
      local candidate_commit=""
      local owner_env_source_is_candidate=0
      local owner_env_alignment_required=0
      local telegram_predecessor_source_mode=""
      local established_runtime=0
      local was_running=0
      local was_running_arg="--no-was-running"

      previous_repo="$(
        active_runtime_checkout_repo_root "$APP_SUPPORT_DIR" 2>/dev/null || true
      )"
      if [[ -n "$previous_repo" ]]; then
        established_runtime=1
        telegram_predecessor_source_mode="predecessor"
      fi
      owner_repo="$(
        json_string_field "$(stack_owner_state_file)" repoRoot 2>/dev/null || true
      )"
      if [[ -z "$previous_repo" ]]; then
        previous_repo="$owner_repo"
        if [[ -n "$previous_repo" ]]; then
          established_runtime=1
          telegram_predecessor_source_mode="predecessor"
        fi
      fi
      if [[ "$established_runtime" != "1" ]] &&
        ! prove_fresh_dev_runtime_activation
      then
        echo "Dev-runtime activation found durable Viventium state but no trustworthy active-checkout owner receipt." >&2
        echo "Activation failed closed so existing configuration, accounts, conversations, schedules, and credentials cannot be mistaken for a fresh install." >&2
        return 1
      fi
      if [[ -z "$previous_repo" ]]; then
        previous_repo="$REPO_ROOT"
      fi
      TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT="$(
        resolve_predecessor_telegram_user_config_root "$previous_repo"
      )"
      if ! stage_telegram_runtime_component \
        "$previous_repo" \
        "$telegram_predecessor_source_mode"
      then
        echo "Dev-runtime activation could not stage a rollback-safe Telegram predecessor component." >&2
        echo "Binding, generated runtime, helper, and running state were not changed." >&2
        return 1
      fi
      candidate_commit="$(
        git -C "$REPO_ROOT/viventium_v0_4/LibreChat" rev-parse --verify HEAD
      )"
      if ! owner_env_source="$(
        resolve_dev_runtime_librechat_owner_env_source \
          "$previous_repo" "$established_runtime"
      )"; then
        echo "Candidate activation could not prove the owner-managed LibreChat environment." >&2
        return 1
      fi
      if [[ -n "$owner_env_source" &&
        "$owner_env_source" == "$REPO_ROOT/viventium_v0_4/LibreChat/.env" ]]
      then
        owner_env_source_is_candidate=1
      fi
      if is_stack_running; then
        was_running=1
        was_running_arg="--was-running"
      fi
      if [[ "$was_running" == "1" && "$restart" != "1" ]]; then
        echo "A running local runtime can only be promoted with --validate --restart." >&2
        return 1
      fi
      activation_begin_json="$(
        dev_runtime_activation_tool begin-new \
        --transaction-parent "$APP_SUPPORT_DIR/state" \
        --app-support-dir "$APP_SUPPORT_DIR" \
        --runtime-dir "$RUNTIME_DIR" \
        --runtime-checkout-file "$(runtime_checkout_file)" \
        --helper-config-file "$(helper_config_file)" \
        --previous-repo "$previous_repo" \
        --telegram-preference-root "$TELEGRAM_PREDECESSOR_ACTIVE_CONFIG_ROOT" \
        --telegram-recovery-selection "$STAGED_TELEGRAM_RECOVERY_SELECTION" \
        --candidate-repo "$REPO_ROOT" \
        "$was_running_arg"
      )"
      activation_dir="$(
        printf '%s\n' "$activation_begin_json" |
          "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin)["transactionDir"])'
      )"
      candidate_runtime="$(
        printf '%s\n' "$activation_begin_json" |
          "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin)["candidateRuntime"])'
      )"
      if ! publish_active_telegram_recovery_component \
        "dev-runtime-activation" "$activation_dir"
      then
        echo "Runtime activation could not publish transaction-bound passive helper recovery." >&2
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running"
        return 1
      fi
      if ! quiesce_macos_helper_process_for_activation "$activation_dir"; then
        rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
        echo "Runtime activation could not pause the installed helper process; live runtime and checkout state were not changed." >&2
        return 1
      fi
      if ! dev_runtime_activation_tool quiesce-helper \
        --transaction-dir "$activation_dir" \
        --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
      then
        rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
        echo "Runtime activation could not transactionally quiesce helper supervision; live runtime and checkout state were not changed." >&2
        return 1
      fi

      if [[ -n "$owner_env_source" ]]; then
        owner_env_destination="$candidate_runtime/service-env/librechat.owner.env"
        owner_env_manifest="$candidate_runtime/service-env/librechat.owner.manifest.json"
        if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" stage \
          --source "$owner_env_source" \
          --runtime-dir "$candidate_runtime" \
          --destination "$owner_env_destination" \
          --manifest "$owner_env_manifest" \
          --target-repo "$REPO_ROOT" \
          --target-commit "$candidate_commit" >/dev/null
        then
          rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
          echo "Runtime activation could not snapshot the established LibreChat owner environment; binding, live runtime, helper, and running state were not changed." >&2
          return 1
        fi
        if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify-compatible \
          --manifest "$owner_env_manifest" \
          --target "$REPO_ROOT/viventium_v0_4/LibreChat/.env" >/dev/null
        then
          rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
          echo "Candidate LibreChat owner state conflicts with the established runtime; the candidate environment was restored exactly." >&2
          return 1
        fi
        if ! dev_runtime_activation_tool owner-env-planned \
          --transaction-dir "$activation_dir" \
          --app-support-dir "$APP_SUPPORT_DIR" \
          --owner-env-manifest "$owner_env_manifest" >/dev/null
        then
          rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
          echo "Runtime activation could not bind the owner environment to its rollback transaction." >&2
          return 1
        fi
        if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify-source \
          --manifest "$owner_env_manifest" \
          --source "$owner_env_source" >/dev/null
        then
          rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
          echo "Established LibreChat owner state changed before materialization; the candidate environment was restored exactly." >&2
          return 1
        fi
        if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" materialize \
          --manifest "$owner_env_manifest" \
          --snapshot "$owner_env_destination" \
          --target-repo "$REPO_ROOT" \
          --target-env "$REPO_ROOT/viventium_v0_4/LibreChat/.env" \
          --target-commit "$candidate_commit" >/dev/null
        then
          rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
          echo "Runtime activation could not materialize the protected LibreChat owner environment; the candidate environment was restored exactly." >&2
          return 1
        fi
        if ! dev_runtime_activation_tool owner-env-materialized \
          --transaction-dir "$activation_dir" \
          --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
        then
          rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
          echo "Runtime activation could not bind the materialized owner environment to its rollback transaction." >&2
          return 1
        fi
      fi

      export VIVENTIUM_LIBRECHAT_SOURCE_PHASE="compile"
      local compiler_status=0
      if [[ -n "$owner_env_source" ]]; then
        VIVENTIUM_LIBRECHAT_CANONICAL_ENV_FILE="$owner_env_destination" \
          "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_compiler.py" \
            --config "$CONFIG_FILE" \
            --output-dir "$candidate_runtime" || compiler_status=$?
      else
        "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/config_compiler.py" \
          --config "$CONFIG_FILE" \
          --output-dir "$candidate_runtime" || compiler_status=$?
      fi
      if [[ "$compiler_status" != "0" ]]; then
        unset VIVENTIUM_LIBRECHAT_SOURCE_PHASE
        rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
        echo "Runtime activation validation failed during candidate config compilation; binding, live runtime, helper, and running state were not changed." >&2
        return 1
      fi
      unset VIVENTIUM_LIBRECHAT_SOURCE_PHASE
      if ! prepare_telegram_runtime_component "$REPO_ROOT" "$candidate_runtime"; then
        rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
        echo "Runtime activation could not stage its Telegram runtime component; binding, live runtime, helper, and running state were not changed." >&2
        return 1
      fi
      if ! "$REPO_ROOT/scripts/viventium/doctor.sh" \
        --config "$CONFIG_FILE" \
        --runtime-dir "$candidate_runtime" \
        --repo-root "$REPO_ROOT" \
        --lock-file "$LOCK_FILE" \
        --prefer-existing-checkout-head
      then
        rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
        echo "Runtime activation validation failed during candidate doctor checks; binding, live runtime, helper, and running state were not changed." >&2
        return 1
      fi
      if [[ -n "$owner_env_source" ]]; then
        if {
          [[ "$owner_env_source_is_candidate" != "1" ]] &&
            ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify-source \
              --manifest "$owner_env_manifest" \
              --source "$owner_env_source" >/dev/null
        } ||
          ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify \
            --manifest "$owner_env_manifest" \
            --target "$REPO_ROOT/viventium_v0_4/LibreChat/.env" \
            --target-repo "$REPO_ROOT" \
            --target-commit "$candidate_commit" >/dev/null ||
          {
            [[ "$owner_env_source_is_candidate" != "1" ]] &&
              ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify-source \
                --manifest "$owner_env_manifest" \
                --source "$REPO_ROOT/viventium_v0_4/LibreChat/.env" >/dev/null
          }
        then
          rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
          echo "LibreChat owner state changed during candidate validation; the candidate environment was restored exactly before publication." >&2
          return 1
        fi
      fi
      if [[ "$(uname -s)" == "Darwin" ]] &&
        ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/helper_artifact_verify.py" \
          --package-dir "$REPO_ROOT/apps/macos/ViventiumHelper"
      then
        rollback_prepared_dev_runtime_activation "$activation_dir" || return 1
        echo "Runtime activation validation failed during helper artifact verification; binding, live runtime, helper, and running state were not changed." >&2
        return 1
      fi
      if [[ "$was_running" == "1" ]]; then
        if ! stop_stack_for_upgrade; then
          if ! rollback_prepared_dev_runtime_activation "$activation_dir"; then
            echo "Runtime activation stop failed and exact helper-intent restoration also failed; the prepared transaction remains for recovery." >&2
            return 1
          fi
          echo "Runtime activation could not stop the prior checkout; no binding or generated-runtime change was published." >&2
          return 1
        fi
      fi
      if ! migrate_telegram_user_configs "$previous_repo"; then
        echo "Runtime activation could not preserve legacy Telegram preferences in canonical App Support state." >&2
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running"
        return 1
      fi
      if ! publish_active_telegram_recovery_component \
        "dev-runtime-activation" "$activation_dir"
      then
        echo "Runtime activation could not bind its migrated Telegram preference authority to rollback." >&2
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running"
        return 1
      fi
      if ! arm_persistent_telegram_recovery_helper; then
        echo "Runtime activation could not arm persistent helper recovery before publication." >&2
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running"
        return 1
      fi

      if ! dev_runtime_activation_tool publish \
        --transaction-dir "$activation_dir" \
        --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
      then
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running" || true
        return 1
      fi
      local runtime_checkout_args=(use --this --no-helper-refresh)
      if [[ "$allow_protected" == "1" ]]; then
        runtime_checkout_args+=(--allow-protected-folder)
      fi
      if ! runtime_checkout_command "${runtime_checkout_args[@]}"; then
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running" || true
        return 1
      fi
      if ! dev_runtime_activation_tool binding-applied \
        --transaction-dir "$activation_dir" \
        --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
      then
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running" || true
        return 1
      fi
      if [[ "$restart" == "1" ]]; then
        if [[ -n "$owner_env_source" ]]; then
          export VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE="$RUNTIME_DIR/service-env/librechat.owner.env"
        fi
        if ! VIVENTIUM_PRESERVE_HELPER_RUNTIME_INTENT=1 \
          VIVENTIUM_DEV_RUNTIME_RECOVERY_INTERNAL=1 restart_stack_after_upgrade
        then
          unset VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE
          echo "Candidate runtime restart failed; restoring the prior checkout and generated runtime." >&2
          restore_previous_dev_runtime_after_failure \
            "$activation_dir" "$previous_repo" "$was_running"
          return 1
        fi
        unset VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE
        if [[ -n "$owner_env_source" ]] &&
          ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify \
            --manifest "$RUNTIME_DIR/service-env/librechat.owner.manifest.json" \
            --target "$REPO_ROOT/viventium_v0_4/LibreChat/.env" \
            --target-repo "$REPO_ROOT" \
            --target-commit "$candidate_commit" >/dev/null
        then
          echo "Candidate runtime changed protected LibreChat auth or owner environment state; restoring the prior checkout and generated runtime." >&2
          restore_previous_dev_runtime_after_failure \
            "$activation_dir" "$previous_repo" "$was_running"
          return 1
        fi
      fi
      if [[ -n "$owner_env_source" ]] &&
        {
          {
            [[ "$owner_env_source_is_candidate" != "1" ]] &&
              ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify-source \
                --manifest "$RUNTIME_DIR/service-env/librechat.owner.manifest.json" \
                --source "$owner_env_source" >/dev/null
          } ||
          ! "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/librechat_owner_env.py" verify \
            --manifest "$RUNTIME_DIR/service-env/librechat.owner.manifest.json" \
            --target "$REPO_ROOT/viventium_v0_4/LibreChat/.env" \
            --target-repo "$REPO_ROOT" \
            --target-commit "$candidate_commit" >/dev/null
        }
      then
        echo "LibreChat owner source or candidate revision changed at the activation commit boundary; restoring the prior checkout and generated runtime." >&2
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running"
        return 1
      fi
      if ! dev_runtime_activation_tool commit \
          --transaction-dir "$activation_dir" \
          --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
      then
        activation_commit_status="$(
          dev_runtime_activation_tool status \
            --transaction-dir "$activation_dir" \
            --app-support-dir "$APP_SUPPORT_DIR" 2>/dev/null |
            "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("status", ""))' \
              2>/dev/null || true
        )"
        if [[ "$activation_commit_status" == "core_committed" ||
          "$activation_commit_status" == "committed" ]]
        then
          echo "Candidate runtime and binding committed, but forward helper finalization is still pending." >&2
          echo "The next start or dev-runtime command will reconcile it safely." >&2
          return 1
        fi
        echo "Candidate activation could not commit its local transaction; restoring the prior checkout and runtime." >&2
        restore_previous_dev_runtime_after_failure \
          "$activation_dir" "$previous_repo" "$was_running"
        return 1
      fi
      owner_env_alignment_required="$(
        dev_runtime_owner_env_alignment_required "$activation_dir"
      )" || return 1
      if [[ "$owner_env_alignment_required" == "1" ]]; then
        if [[ "$restart" == "1" ]]; then
          if ! align_committed_dev_runtime_owner_env "$activation_dir"; then
            echo "Candidate runtime committed and preserved a concurrent owner environment edit, but its alignment restart is incomplete." >&2
            echo "The helper will retry the committed candidate without rolling back the owner edit." >&2
            return 1
          fi
        elif ! dev_runtime_activation_tool mark-aligned \
          --transaction-dir "$activation_dir" \
          --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
        then
          echo "Candidate runtime committed and preserved a concurrent owner environment edit, but its alignment restart is incomplete." >&2
          echo "The helper will retry the committed candidate without rolling back the owner edit." >&2
          return 1
        fi
      fi
      if ! runtime_checkout_refresh_helper; then
        echo "Candidate runtime and binding committed, but helper refresh is incomplete." >&2
        echo "The next start or dev-runtime command will retry the helper refresh without rolling back the healthy candidate." >&2
        return 1
      fi
      if ! dev_runtime_activation_tool finalize-helper \
        --transaction-dir "$activation_dir" \
        --app-support-dir "$APP_SUPPORT_DIR" >/dev/null
      then
        echo "Candidate runtime and helper refresh completed, but the forward-finalization receipt is still pending." >&2
        echo "The next start or dev-runtime command will reconcile it safely." >&2
        return 1
      fi
      if ! clear_active_telegram_recovery_component; then
        echo "Candidate runtime and helper committed, but stale Telegram recovery state could not be cleared." >&2
        return 1
      fi
      remove_dev_runtime_activation_transaction "$activation_dir"
      echo "Current checkout passed candidate validation and was activated transactionally."
      ;;
    --help|-h|help)
      subcommand_usage dev-runtime
      ;;
    *)
      echo "Unknown dev-runtime action: $action" >&2
      subcommand_usage dev-runtime >&2
      exit 1
      ;;
  esac
}

workflows_command() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || $# -lt 1 ]]; then
    subcommand_usage workflows
    exit 0
  fi
  ensure_app_support_layout "$APP_SUPPORT_DIR"
  if [[ -f "$CONFIG_FILE" ]]; then
    compile_config >/dev/null
  fi
  exec "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/workflows.py" \
    --repo-root "$REPO_ROOT" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --runtime-dir "$RUNTIME_DIR" \
    "$@"
}

heal_command() {
  local action="${1:-status}"
  shift || true
  case "$action" in
    start)
      workflows_command start heal "$@"
      ;;
    status|cancel|open-artifacts)
      workflows_command "$action" "$@"
      ;;
    --help|-h|help)
      subcommand_usage heal
      ;;
    *)
      echo "Unknown heal action: $action" >&2
      subcommand_usage heal >&2
      exit 1
      ;;
  esac
}

feature_request_command() {
  local action="${1:-status}"
  shift || true
  case "$action" in
    start)
      workflows_command start feature-request "$@"
      ;;
    status|approve|cancel|open-artifacts)
      workflows_command "$action" "$@"
      ;;
    --help|-h|help)
      subcommand_usage feature-request
      ;;
    *)
      echo "Unknown feature-request action: $action" >&2
      subcommand_usage feature-request >&2
      exit 1
      ;;
  esac
}

report_bug_command() {
  local action="${1:-status}"
  shift || true
  case "$action" in
    start)
      workflows_command start bug-report "$@"
      ;;
    status|approve|cancel|open-artifacts)
      workflows_command "$action" "$@"
      ;;
    --help|-h|help)
      subcommand_usage report-bug
      ;;
    *)
      echo "Unknown report-bug action: $action" >&2
      subcommand_usage report-bug >&2
      exit 1
      ;;
  esac
}

transcripts_command() {
  local subject="${1:-}"
  if [[ "$subject" == "--help" || "$subject" == "-h" || "$subject" == "help" || -z "$subject" ]]; then
    subcommand_usage transcripts
    return 0
  fi
  if [[ "$subject" != "source" ]]; then
    echo "Unknown transcripts subject: $subject" >&2
    subcommand_usage transcripts >&2
    return 1
  fi
  shift || true

  local action="${1:-status}"
  if [[ "$action" == "--help" || "$action" == "-h" || "$action" == "help" ]]; then
    subcommand_usage transcripts
    return 0
  fi
  shift || true

  ensure_app_support_layout "$APP_SUPPORT_DIR"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Missing config: $CONFIG_FILE" >&2
    echo "Run: bin/viventium install" >&2
    return 1
  fi
  refresh_repo_python

  local config_tool="$REPO_ROOT/scripts/viventium/config_settings.py"
  local backup_dir="$APP_SUPPORT_DIR/state/config-backups"
  case "$action" in
    status)
      "$PYTHON_BIN" "$config_tool" \
        --config-file "$CONFIG_FILE" \
        transcripts-source-status \
        "$@"
      ;;
    set)
      if [[ $# -lt 1 ]]; then
        echo "Missing transcript source folder." >&2
        subcommand_usage transcripts >&2
        return 1
      fi
      acquire_cli_lock "$COMMAND"
      local folder="$1"
      shift || true
      local output=""
      output="$("$PYTHON_BIN" "$config_tool" \
        --config-file "$CONFIG_FILE" \
        --backup-dir "$backup_dir" \
        transcripts-source-set "$folder" \
        "$@")"
      compile_config >/dev/null
      sync_memory_hardening_schedule >/dev/null 2>&1 || true
      printf '%s\n' "$output"
      ;;
    clear)
      acquire_cli_lock "$COMMAND"
      local output=""
      output="$("$PYTHON_BIN" "$config_tool" \
        --config-file "$CONFIG_FILE" \
        --backup-dir "$backup_dir" \
        transcripts-source-clear \
        "$@")"
      compile_config >/dev/null
      sync_memory_hardening_schedule >/dev/null 2>&1 || true
      printf '%s\n' "$output"
      ;;
    *)
      echo "Unknown transcripts source action: $action" >&2
      subcommand_usage transcripts >&2
      return 1
      ;;
  esac
}

qa_test_account_command() {
  local action="${1:-status}"
  if [[ "$action" == "--help" || "$action" == "-h" || "$action" == "help" ]]; then
    subcommand_usage qa-test-account
    return 0
  fi
  shift || true

  ensure_app_support_layout "$APP_SUPPORT_DIR"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Missing config: $CONFIG_FILE" >&2
    echo "Run: bin/viventium install" >&2
    return 1
  fi
  refresh_repo_python

  local config_tool="$REPO_ROOT/scripts/viventium/config_settings.py"
  local backup_dir="$APP_SUPPORT_DIR/state/config-backups"
  case "$action" in
    status)
      "$PYTHON_BIN" "$config_tool" \
        --config-file "$CONFIG_FILE" \
        qa-test-account-status \
        "$@"
      ;;
    set)
      if [[ $# -lt 1 ]]; then
        echo "Missing QA test-account email or --email-stdin." >&2
        subcommand_usage qa-test-account >&2
        return 1
      fi
      acquire_cli_lock "$COMMAND"
      local output=""
      if [[ "$1" == "--email-stdin" ]]; then
        shift || true
        output="$("$PYTHON_BIN" "$config_tool" \
          --config-file "$CONFIG_FILE" \
          --backup-dir "$backup_dir" \
          qa-test-account-set --email-stdin \
          "$@")"
      else
        local qa_email="$1"
        shift || true
        output="$("$PYTHON_BIN" "$config_tool" \
          --config-file "$CONFIG_FILE" \
          --backup-dir "$backup_dir" \
          qa-test-account-set "$qa_email" \
          "$@")"
      fi
      compile_config >/dev/null
      printf '%s\n' "$output"
      ;;
    clear)
      acquire_cli_lock "$COMMAND"
      local output=""
      output="$("$PYTHON_BIN" "$config_tool" \
        --config-file "$CONFIG_FILE" \
        --backup-dir "$backup_dir" \
        qa-test-account-clear \
        "$@")"
      compile_config >/dev/null
      printf '%s\n' "$output"
      ;;
    *)
      echo "Unknown qa-test-account action: $action" >&2
      subcommand_usage qa-test-account >&2
      return 1
      ;;
  esac
}

maybe_reexec_active_runtime_checkout() {
  [[ "${VIVENTIUM_DISABLE_ACTIVE_CHECKOUT_REEXEC:-0}" == "1" ]] && return 0
  local command_name="${1:-}"
  shift || true

  case "$command_name" in
    start|launch|stop|install-helper|uninstall-helper|status-bar|memory-harden|memory-dedupe|transcripts|workflows|heal|feature-request|report-bug|bug-report|prompt-workbench|health)
      ;;
    *)
      return 0
      ;;
  esac

  local active_repo=""
  active_repo="$(active_runtime_checkout_repo_root "$APP_SUPPORT_DIR" 2>/dev/null || true)"
  [[ -n "$active_repo" ]] || return 0
  path_is_viventium_runtime_repo_root "$active_repo" || return 0
  active_repo="$(canonicalize_existing_dir "$active_repo")"

  if [[ "$active_repo" == "$(canonicalize_existing_dir "$REPO_ROOT")" ]]; then
    return 0
  fi

  local active_lock_file="$active_repo/components.lock.json"
  echo "Using active runtime checkout: $(display_safe_path "$active_repo")" >&2
  VIVENTIUM_COMPONENTS_LOCK_FILE="$active_lock_file" exec "$active_repo/bin/viventium" \
    --app-support-dir "$APP_SUPPORT_DIR" \
    --config-file "$CONFIG_FILE" \
    --runtime-dir "$RUNTIME_DIR" \
    --lock-file "$active_lock_file" \
    "$command_name" \
    "$@"
}

yaml_file_has_unique_mapping_keys() {
  local yaml_file="$1"
  local timeout_seconds="${VIVENTIUM_PRIVATE_YAML_VALIDATE_TIMEOUT_SECONDS:-3}"
  [[ -f "$yaml_file" ]] || return 1
  "$PYTHON_BIN" - "$yaml_file" "$timeout_seconds" <<'PY'
import math
import signal
import sys
import yaml
from yaml.constructor import ConstructorError
from yaml.resolver import BaseResolver


class UniqueKeyLoader(yaml.SafeLoader):
    pass


def construct_mapping(loader, node, deep=False):
    mapping = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in mapping:
            raise ConstructorError(
                "while constructing a mapping",
                node.start_mark,
                f"found duplicate key ({key})",
                key_node.start_mark,
            )
        mapping[key] = loader.construct_object(value_node, deep=deep)
    return mapping


UniqueKeyLoader.add_constructor(BaseResolver.DEFAULT_MAPPING_TAG, construct_mapping)

def timeout_handler(signum, frame):
    raise TimeoutError("timed out while reading YAML")


timeout_seconds = max(1, int(math.ceil(float(sys.argv[2]))))
signal.signal(signal.SIGALRM, timeout_handler)
signal.alarm(timeout_seconds)
try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        yaml.load(handle, Loader=UniqueKeyLoader)
finally:
    signal.alarm(0)
PY
}

prepare_runtime_exports() {
  local runtime_profile="${VIVENTIUM_RUNTIME_PROFILE:-isolated}"
  export VIVENTIUM_ENV_FILE="$GENERATED_ENV"
  export VIVENTIUM_ENV_LOCAL_FILE="$GENERATED_LOCAL_ENV"
  export VIVENTIUM_CANONICAL_ENV_LOCK_EXISTING_KEYS="1"
  export VIVENTIUM_BASE_STATE_DIR="$APP_SUPPORT_DIR/state"
  export VIVENTIUM_STATE_ROOT="${VIVENTIUM_STATE_ROOT:-$APP_SUPPORT_DIR/state/runtime/${runtime_profile}}"
  export VIVENTIUM_PUBLIC_NETWORK_STATE_FILE="${VIVENTIUM_PUBLIC_NETWORK_STATE_FILE:-$VIVENTIUM_STATE_ROOT/public-network.json}"
  export VIVENTIUM_CALL_TUNNEL_LOG_DIR="${VIVENTIUM_CALL_TUNNEL_LOG_DIR:-$VIVENTIUM_STATE_ROOT/logs}"
  export VIVENTIUM_REMOTE_CALL_TUNNEL_SCRIPT="${VIVENTIUM_REMOTE_CALL_TUNNEL_SCRIPT:-$REPO_ROOT/scripts/viventium/remote_call_tunnel.py}"
  export VIVENTIUM_PRIVATE_REPO_DIR="${VIVENTIUM_PRIVATE_REPO_DIR:-$PRIVATE_REPO_DIR_DEFAULT}"
  export VIVENTIUM_PRIVATE_CURATED_DIR="${VIVENTIUM_PRIVATE_CURATED_DIR:-$PRIVATE_CURATED_DIR_DEFAULT}"
  if declare -F recall_rebuild_required_file >/dev/null 2>&1; then
    export VIVENTIUM_RECALL_REBUILD_REQUIRED_FILE="${VIVENTIUM_RECALL_REBUILD_REQUIRED_FILE:-$(recall_rebuild_required_file "$APP_SUPPORT_DIR" "$runtime_profile")}"
  else
    export VIVENTIUM_RECALL_REBUILD_REQUIRED_FILE="${VIVENTIUM_RECALL_REBUILD_REQUIRED_FILE:-$APP_SUPPORT_DIR/state/runtime/${runtime_profile}/continuity/recall-rebuild-required.json}"
  fi

  local source_phase="${VIVENTIUM_LIBRECHAT_SOURCE_PHASE:-runtime}"
  local private_root_env_local=""
  local private_librechat_env=""
  local private_source_of_truth=""
  local private_agents_bundle=""
  local private_telegram_env=""
  local generated_telegram_env="$RUNTIME_DIR/service-env/telegram.config.env"
  local generated_telegram_codex_env="$RUNTIME_DIR/service-env/telegram-codex.env"
  local generated_telegram_codex_settings="$RUNTIME_DIR/telegram-codex/settings.yaml"
  local generated_telegram_codex_projects="$RUNTIME_DIR/telegram-codex/projects.yaml"
  local private_source_valid=0

  if [[ -n "$VIVENTIUM_PRIVATE_CURATED_DIR" ]]; then
    private_root_env_local="$VIVENTIUM_PRIVATE_CURATED_DIR/configs/root.env.local"
    private_librechat_env="$VIVENTIUM_PRIVATE_CURATED_DIR/configs/librechat/librechat.env"
    private_source_of_truth="$VIVENTIUM_PRIVATE_CURATED_DIR/configs/librechat/source_of_truth/local.librechat.yaml"
    private_agents_bundle="$VIVENTIUM_PRIVATE_CURATED_DIR/configs/librechat/source_of_truth/local.viventium-agents.yaml"
    private_telegram_env="$VIVENTIUM_PRIVATE_CURATED_DIR/configs/telegram/config.env"
  fi

  if [[ -f "$private_root_env_local" ]]; then
    export VIVENTIUM_ENV_LOCAL_FILE="$private_root_env_local"
  fi
  if [[ -n "${VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE:-}" ]]; then
    export VIVENTIUM_LIBRECHAT_CANONICAL_ENV_FILE="$VIVENTIUM_LIBRECHAT_PROMOTION_OWNER_ENV_FILE"
  elif [[ -f "$private_librechat_env" ]]; then
    export VIVENTIUM_LIBRECHAT_CANONICAL_ENV_FILE="$private_librechat_env"
  fi
  if [[ -f "$private_source_of_truth" ]]; then
    if yaml_file_has_unique_mapping_keys "$private_source_of_truth"; then
      export VIVENTIUM_LIBRECHAT_PRIVATE_SOURCE_OF_TRUTH="$private_source_of_truth"
      private_source_valid=1
    else
      echo "Warning: ignoring unreadable or invalid private LibreChat source-of-truth YAML at $private_source_of_truth" >&2
      unset VIVENTIUM_LIBRECHAT_PRIVATE_SOURCE_OF_TRUTH
    fi
  else
    unset VIVENTIUM_LIBRECHAT_PRIVATE_SOURCE_OF_TRUTH
  fi
  if [[ "$source_phase" == "compile" && "$private_source_valid" == "1" ]]; then
    export VIVENTIUM_LIBRECHAT_SOURCE_OF_TRUTH="$private_source_of_truth"
  elif [[ "$source_phase" == "compile" ]]; then
    unset VIVENTIUM_LIBRECHAT_SOURCE_OF_TRUTH
  elif [[ -f "$GENERATED_LIBRECHAT_YAML" ]]; then
    export VIVENTIUM_LIBRECHAT_SOURCE_OF_TRUTH="$GENERATED_LIBRECHAT_YAML"
  elif [[ "$private_source_valid" == "1" ]]; then
    export VIVENTIUM_LIBRECHAT_SOURCE_OF_TRUTH="$private_source_of_truth"
  else
    unset VIVENTIUM_LIBRECHAT_SOURCE_OF_TRUTH
  fi
  if [[ -f "$private_agents_bundle" ]]; then
    if yaml_file_has_unique_mapping_keys "$private_agents_bundle"; then
      export LIBRECHAT_AGENTS_BUNDLE_FILE="$private_agents_bundle"
    else
      echo "Warning: ignoring unreadable or invalid private Viventium agents bundle at $private_agents_bundle" >&2
      unset LIBRECHAT_AGENTS_BUNDLE_FILE
    fi
  fi
  if [[ -f "$generated_telegram_env" ]]; then
    export VIVENTIUM_TELEGRAM_ENV_FILE="$generated_telegram_env"
  elif [[ -f "$private_telegram_env" ]]; then
    export VIVENTIUM_TELEGRAM_ENV_FILE="$private_telegram_env"
  fi
  if [[ -f "$generated_telegram_codex_env" ]]; then
    export VIVENTIUM_TELEGRAM_CODEX_ENV_FILE="$generated_telegram_codex_env"
  fi
  if [[ -f "$generated_telegram_codex_settings" ]]; then
    export VIVENTIUM_TELEGRAM_CODEX_SETTINGS_FILE="$generated_telegram_codex_settings"
  fi
  if [[ -f "$generated_telegram_codex_projects" ]]; then
    export VIVENTIUM_TELEGRAM_CODEX_PROJECTS_FILE="$generated_telegram_codex_projects"
  fi
}

load_selected_runtime_environment_for_children() {
  [[ -f "$GENERATED_ENV" ]] || return 0

  # A side-by-side wrapper selects the runtime before this process starts. Keep
  # that identity authoritative while replacing any inherited ownership values
  # from a canonical or previously selected runtime.
  local wrapper_scope="${VIVENTIUM_DEV_ENV_SCOPE_ACTIVE:-}"
  local wrapper_instance_id="${VIVENTIUM_DEV_ENV_INSTANCE_ID:-}"
  local wrapper_name="${VIVENTIUM_DEV_ENV_NAME:-}"
  local runtime_profile=""
  local selected_state_dir="$APP_SUPPORT_DIR/state"
  local selected_profile_dir=""
  unset VIVENTIUM_APP_SUPPORT_DIR VIVENTIUM_BASE_STATE_DIR VIVENTIUM_STATE_ROOT
  unset VIVENTIUM_PUBLIC_NETWORK_STATE_FILE VIVENTIUM_CALL_TUNNEL_LOG_DIR
  unset VIVENTIUM_RUNTIME_PROFILE
  unset VIVENTIUM_LOCAL_MONGO_PORT VIVENTIUM_LOCAL_MONGO_DB VIVENTIUM_LOCAL_MONGO_DATA_PATH
  unset VIVENTIUM_LOCAL_MEILI_PORT VIVENTIUM_LOCAL_MEILI_DATA_PATH
  unset MEILI_MASTER_KEY VIVENTIUM_LOCAL_MEILI_MASTER_KEY
  unset MONGO_HOST MEILI_BIND_HOST
  unset LIVEKIT_HTTP_PORT LIVEKIT_TCP_PORT LIVEKIT_UDP_PORT LIVEKIT_NODE_IP
  unset VIVENTIUM_LIVEKIT_CFG_DIR
  unset VIVENTIUM_DEV_ENV_ENABLED VIVENTIUM_DEV_ENV_NAME

  # Child launchers and native lifecycle scripts need the selected generated
  # values in their environment. Establish the selected structural roots before
  # the local layer so references inside runtime.local.env cannot expand through
  # hostile ambient canonical values. The local override layer still loads last.
  export VIVENTIUM_APP_SUPPORT_DIR="$APP_SUPPORT_DIR"
  export VIVENTIUM_BASE_STATE_DIR="$selected_state_dir"
  set -a
  # shellcheck disable=SC1090
  source "$GENERATED_ENV"
  runtime_profile="${VIVENTIUM_RUNTIME_PROFILE:-isolated}"
  selected_profile_dir="$selected_state_dir/runtime/$runtime_profile"
  export VIVENTIUM_STATE_ROOT="$selected_profile_dir"
  if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
    # shellcheck disable=SC1090
    source "$GENERATED_LOCAL_ENV"
  fi
  set +a

  if [[ -n "$wrapper_scope" ]]; then
    export VIVENTIUM_DEV_ENV_SCOPE_ACTIVE="$wrapper_scope"
  fi
  if [[ -n "$wrapper_instance_id" ]]; then
    export VIVENTIUM_DEV_ENV_INSTANCE_ID="$wrapper_instance_id"
  fi
  if [[ "$wrapper_scope" == "true" || "$wrapper_scope" == "1" ]]; then
    export VIVENTIUM_DEV_ENV_NAME="$wrapper_name"
  fi

  runtime_profile="${VIVENTIUM_RUNTIME_PROFILE:-$runtime_profile}"
  selected_profile_dir="$selected_state_dir/runtime/$runtime_profile"
  export VIVENTIUM_APP_SUPPORT_DIR="$APP_SUPPORT_DIR"
  export VIVENTIUM_BASE_STATE_DIR="$selected_state_dir"
  export VIVENTIUM_STATE_ROOT="$selected_profile_dir"
  export VIVENTIUM_RUNTIME_PROFILE="$runtime_profile"
  export VIVENTIUM_PUBLIC_NETWORK_STATE_FILE="$selected_profile_dir/public-network.json"
  export VIVENTIUM_CALL_TUNNEL_LOG_DIR="$selected_profile_dir/logs"

  if [[ -z "${VIVENTIUM_LOCAL_MONGO_DATA_PATH:-}" ]]; then
    if [[ -d "$selected_profile_dir/mongo-data" ]]; then
      VIVENTIUM_LOCAL_MONGO_DATA_PATH="$selected_profile_dir/mongo-data"
    elif [[ -d "$selected_state_dir/mongo-data" ]]; then
      VIVENTIUM_LOCAL_MONGO_DATA_PATH="$selected_state_dir/mongo-data"
    else
      VIVENTIUM_LOCAL_MONGO_DATA_PATH="$selected_profile_dir/mongo-data"
    fi
  fi
  export VIVENTIUM_LOCAL_MONGO_DATA_PATH

  if [[ -z "${VIVENTIUM_LOCAL_MEILI_DATA_PATH:-}" ]]; then
    if [[ -d "$selected_profile_dir/meili-data" ]]; then
      VIVENTIUM_LOCAL_MEILI_DATA_PATH="$selected_profile_dir/meili-data"
    elif [[ -d "$selected_state_dir/meili-data" ]]; then
      VIVENTIUM_LOCAL_MEILI_DATA_PATH="$selected_state_dir/meili-data"
    else
      VIVENTIUM_LOCAL_MEILI_DATA_PATH="$selected_profile_dir/meili-data"
    fi
  fi
  export VIVENTIUM_LOCAL_MEILI_DATA_PATH

  if [[ -z "${VIVENTIUM_LIVEKIT_CFG_DIR:-}" ]]; then
    VIVENTIUM_LIVEKIT_CFG_DIR="$selected_profile_dir/livekit"
  fi
  export VIVENTIUM_LIVEKIT_CFG_DIR
}

install_progress_dir() {
  printf '%s\n' "$APP_SUPPORT_DIR/state/install"
}

write_install_stage() {
  local stage="$1"
  local progress_dir
  progress_dir="$(install_progress_dir)"
  mkdir -p "$progress_dir"
  printf '%s\n' "$stage" >"$progress_dir/stage.txt"
}

read_install_stage() {
  local progress_dir
  progress_dir="$(install_progress_dir)"
  if [[ -f "$progress_dir/stage.txt" ]]; then
    tr -d '\r\n' <"$progress_dir/stage.txt"
  fi
}

clear_install_stage() {
  local progress_dir
  progress_dir="$(install_progress_dir)"
  rm -f "$progress_dir/stage.txt" >/dev/null 2>&1 || true
  rmdir "$progress_dir" >/dev/null 2>&1 || true
}

backup_existing_install_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    return 0
  fi
  local progress_dir backup_dir timestamp backup_path
  progress_dir="$(install_progress_dir)"
  backup_dir="$progress_dir/backups"
  mkdir -p "$backup_dir"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_path="$backup_dir/config-$timestamp.yaml"
  cp "$CONFIG_FILE" "$backup_path"
  printf '%s\n' "$backup_path"
}

prompt_install_recovery_action() {
  local prior_stage="${1:-}"
  if [[ -z "$prior_stage" ]]; then
    printf 'resume\n'
    return 0
  fi

  echo "A previous install stopped during: $prior_stage" >&2
  if [[ ! -t 0 ]]; then
    printf 'resume\n'
    return 0
  fi

  local response=""
  printf 'Choose recovery action [resume/reconfigure/start-over] (default: resume): ' >&2
  IFS= read -r response || true
  response="$(printf '%s' "${response:-resume}" | tr '[:upper:]' '[:lower:]')"
  case "$response" in
    ""|resume|r)
      printf 'resume\n'
      ;;
    reconfigure|config|c)
      printf 'reconfigure\n'
      ;;
    start-over|startover|reset|s)
      printf 'start-over\n'
      ;;
    *)
      echo "Unknown recovery choice '$response'; resuming with the current config." >&2
      printf 'resume\n'
      ;;
  esac
}

print_install_recovery_guidance() {
  local failed_stage="${1:-unknown}"
  echo
  echo "Install stopped during stage: $failed_stage" >&2
  echo "Resume after fixing the blocker: bin/viventium install" >&2
  echo "Change installer choices first:  bin/viventium configure" >&2
}

print_install_summary() {
  local stack_started="${1:-0}"
  local args=(--config "$CONFIG_FILE" --runtime-dir "$RUNTIME_DIR" --repo-root "$REPO_ROOT")
  if [[ "$stack_started" == "1" ]]; then
    args+=(--probe-live)
  fi
  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/install_summary.py" "${args[@]}"
}

needs_connected_accounts_guidance() {
  refresh_repo_python
  "$PYTHON_BIN" - "$CONFIG_FILE" "$RUNTIME_DIR" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

import yaml


def configured(node):
    return isinstance(node, dict) and bool(
        str(node.get("secret_ref") or "").strip() or str(node.get("secret_value") or "").strip()
    )


def parse_env_file(path):
    values = {}
    if not path.is_file():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        value = value.strip()
        if (value.startswith("'") and value.endswith("'")) or (
            value.startswith('"') and value.endswith('"')
        ):
            value = value[1:-1]
        values[key.strip()] = value
    return values


def runtime_connected(config, runtime_env, provider):
    provider = str(provider or "").strip().lower()
    if provider not in {"openai", "anthropic"}:
        return False
    llm = config.get("llm", {}) or {}
    configured_connected = any(
        str(node.get("provider") or "").strip().lower() == provider
        and str(node.get("auth_mode") or "").strip().lower() == "connected_account"
        for node in (llm.get("primary", {}) or {}, llm.get("secondary", {}) or {})
    )
    if not configured_connected:
        return False
    env_key = {
        "openai": "VIVENTIUM_OPENAI_AUTH_MODE",
        "anthropic": "VIVENTIUM_ANTHROPIC_AUTH_MODE",
    }[provider]
    return (
        str(runtime_env.get("VIVENTIUM_LOCAL_SUBSCRIPTION_AUTH") or "").strip().lower()
        in {"1", "true", "yes", "on"}
        and str(runtime_env.get(env_key) or "").strip().lower() == "connected_account"
    )


config_path = Path(sys.argv[1])
runtime_dir = Path(sys.argv[2])
config = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
runtime_env = {}
runtime_env.update(parse_env_file(runtime_dir / "runtime.env"))
runtime_env.update(parse_env_file(runtime_dir / "runtime.local.env"))
llm = config.get("llm", {}) or {}
primary = llm.get("primary", {}) or {}
secondary = llm.get("secondary", {}) or {}
extra_provider_keys = llm.get("extra_provider_keys", {}) or {}

foundation_present = any(
    provider in {"openai", "anthropic"} and auth_mode == "api_key" and configured(node)
    for provider, auth_mode, node in (
        (
            str(primary.get("provider") or "").strip().lower(),
            str(primary.get("auth_mode") or "").strip().lower(),
            primary,
        ),
        (
            str(secondary.get("provider") or "").strip().lower(),
            str(secondary.get("auth_mode") or "").strip().lower(),
            secondary,
        ),
    )
) or any(
    provider_name in {"openai", "anthropic"} and configured(node)
    for provider_name, node in extra_provider_keys.items()
 ) or any(
    runtime_connected(config, runtime_env, provider) for provider in ("openai", "anthropic")
)

integrations = config.get("integrations", {}) or {}
google_workspace_enabled = bool((integrations.get("google_workspace") or {}).get("enabled"))
ms365_enabled = bool((integrations.get("ms365") or {}).get("enabled"))

needs_guidance = (not foundation_present) or google_workspace_enabled or ms365_enabled
print("1" if needs_guidance else "0")
PY
}

print_connected_accounts_browser_reminder() {
  [[ "${HEADLESS:-0}" == "1" ]] && return 0
  if [[ "$(needs_connected_accounts_guidance)" != "1" ]]; then
    return 0
  fi

  echo
  echo "Important: after you create your account in the browser, click your account in the left sidebar,"
  echo "open Settings -> Connected Accounts, add an OpenAI or Anthropic API key so the shipped Viventium agents can run,"
  echo "and connect Google Workspace and/or Microsoft 365 there as well if you want those tasks on this user account."
}

open_default_browser() {
  [[ "${HEADLESS:-0}" == "1" ]] && return 0

  local _api_port _frontend_port _playground_port
  assign_runtime_ports _api_port _frontend_port _playground_port
  local url="http://localhost:${_frontend_port}"

  if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  fi
}

PASSWORD_RESET_LINK_SCRIPT=""

prepare_password_reset_link_runtime() {
  local reset_librechat_dir="${VIVENTIUM_LIBRECHAT_DIR:-$REPO_ROOT/viventium_v0_4/LibreChat}"

  if ! reset_librechat_dir="$(cd "$reset_librechat_dir" 2>/dev/null && pwd -P)"; then
    echo "Password-reset link failed because the selected LibreChat checkout is missing: $reset_librechat_dir" >&2
    return 1
  fi
  PASSWORD_RESET_LINK_SCRIPT="$reset_librechat_dir/config/issue-password-reset-link.js"
  if [[ ! -f "$PASSWORD_RESET_LINK_SCRIPT" ]]; then
    echo "Password-reset link helper is missing from the selected LibreChat checkout: $PASSWORD_RESET_LINK_SCRIPT" >&2
    return 1
  fi

  if [[ -z "${DOMAIN_CLIENT:-}" ]]; then
    if [[ -n "${CLIENT_URL:-}" ]]; then
      export DOMAIN_CLIENT="$CLIENT_URL"
    elif [[ -n "${VIVENTIUM_PUBLIC_CLIENT_URL:-}" ]]; then
      export DOMAIN_CLIENT="$VIVENTIUM_PUBLIC_CLIENT_URL"
    else
      export DOMAIN_CLIENT="http://127.0.0.1:${VIVENTIUM_LC_FRONTEND_PORT:-3190}"
    fi
  fi
}

removal_backup_root() {
  printf '%s\n' "${VIVENTIUM_REMOVAL_BACKUP_ROOT:-$HOME/Library/Application Support/Viventium Removed}"
}

backup_install_state_for_removal() {
  local reason="${1:-reset}"
  local backup_root backup_dir timestamp
  backup_root="$(removal_backup_root)"
  case "$backup_root" in
    "$APP_SUPPORT_DIR"|"$APP_SUPPORT_DIR"/*)
      echo "Refusing removal backup root inside the active Viventium App Support directory: $backup_root" >&2
      return 1
      ;;
  esac
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_dir="$backup_root/${timestamp}-${reason}"
  mkdir -p "$backup_root"
  chmod 700 "$backup_root" >/dev/null 2>&1 || true
  if [[ -e "$backup_dir" ]]; then
    echo "Refusing to overwrite an existing Viventium removal backup: $backup_dir" >&2
    return 1
  fi

  if [[ -e "$APP_SUPPORT_DIR" ]]; then
    # Services are drained before this function is called. Moving the entire
    # tree on the same local filesystem preserves databases, state, snapshots,
    # generated config, logs, and helper metadata without a torn live copy.
    mv -- "$APP_SUPPORT_DIR" "$backup_dir"
    chmod 700 "$backup_dir" >/dev/null 2>&1 || true
  elif [[ -f "$CONFIG_FILE" ]]; then
    mkdir -p "$backup_dir"
    chmod 700 "$backup_dir" >/dev/null 2>&1 || true
    cp "$CONFIG_FILE" "$backup_dir/config.yaml"
  else
    return 1
  fi

  printf '%s\n' "$backup_dir"
}

confirm_destructive_action() {
  local action_label="$1"
  local yes_flag="${2:-0}"
  local confirm_token="$3"

  if [[ "$yes_flag" == "1" ]]; then
    return 0
  fi

  if [[ ! -t 0 ]]; then
    echo "${action_label} requires --yes in non-interactive mode." >&2
    exit 1
  fi

  echo "${action_label} will only affect this Viventium install under:" >&2
  echo "  $APP_SUPPORT_DIR" >&2
  echo "It will not delete this git checkout." >&2
  printf 'Type %s to continue: ' "$confirm_token" >&2
  local response=""
  IFS= read -r response || true
  if [[ "$response" != "$confirm_token" ]]; then
    echo "${action_label} cancelled." >&2
    exit 1
  fi
}

drain_native_stack_before_state_removal() {
  # Destructive flows cannot rely on helper-detached cleanup alone because the
  # helper can return before native services have drained and before App Support
  # state is still present for command-line matching.
  prepare_runtime_exports
  if [[ -f "$GENERATED_ENV" ]]; then
    set -a
    set +u
    # shellcheck disable=SC1090
    source "$GENERATED_ENV"
    if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
      # shellcheck disable=SC1090
      source "$GENERATED_LOCAL_ENV"
    fi
    set -u
    set +a
  fi
  if ! "$REPO_ROOT/scripts/viventium/native_stack.sh" stop; then
    echo "Native services did not drain; refusing to remove Viventium state." >&2
    return 1
  fi
}

reset_local_install_state() {
  local backup_dir=""

  if is_stack_running; then
    echo "Stopping the current Viventium stack before reset..."
    stop_stack_for_upgrade
  fi
  if ! drain_native_stack_before_state_removal; then
    echo "Factory reset stopped before any Viventium state was removed." >&2
    return 1
  fi
  if [[ -e "$APP_SUPPORT_DIR" || -f "$CONFIG_FILE" ]]; then
    backup_dir="$(backup_install_state_for_removal "reset")"
  fi

  rm -rf "$APP_SUPPORT_DIR"
  if [[ -n "$backup_dir" ]]; then
    echo "Backed up the previous local install state to $backup_dir"
  fi
  echo "Factory reset complete. Next: bin/viventium install"
}

uninstall_local_installation() {
  local backup_dir=""
  local helper_ownership="unknown"

  if is_stack_running; then
    echo "Stopping the current Viventium stack before uninstall..."
    stop_stack_for_upgrade
  fi
  if ! drain_native_stack_before_state_removal; then
    echo "Uninstall stopped before any Viventium state was removed." >&2
    return 1
  fi
  helper_ownership="$(read_install_helper_ownership)"
  if [[ "$helper_ownership" == "unknown" ]] && legacy_helper_ownership_matches_install; then
    helper_ownership="legacy-owned"
  fi
  if [[ -e "$APP_SUPPORT_DIR" || -f "$CONFIG_FILE" ]]; then
    backup_dir="$(backup_install_state_for_removal "uninstall")"
  fi

  case "$helper_ownership" in
    owned|legacy-owned)
      if [[ "$helper_ownership" == "legacy-owned" ]]; then
        echo "Verified legacy helper ownership for this install target."
      fi
      run_macos_helper_installer uninstall || true
      ;;
    not-owned)
      echo "Skipped macOS helper removal because this install's owner receipt records no helper ownership."
      ;;
    *)
      echo "Skipped macOS helper removal because helper ownership for this install target could not be proven."
      ;;
  esac
  rm -rf "$APP_SUPPORT_DIR"
  if [[ -n "$backup_dir" ]]; then
    echo "Backed up the previous local install state to $backup_dir"
  fi
  echo "Viventium has been removed from this Mac. The repo checkout was left in place."
}

read_runtime_ports() {
  local api_port="3180"
  local frontend_port="3190"
  local playground_port="3300"
  local sandpack_port="3191"

  if [[ -f "$GENERATED_ENV" ]]; then
    local loaded_ports
    loaded_ports="$(
      set +u
      # shellcheck disable=SC1090
      source "$GENERATED_ENV"
      if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
        # shellcheck disable=SC1090
        source "$GENERATED_LOCAL_ENV"
      fi
      printf '%s %s %s %s\n' \
        "${VIVENTIUM_LC_API_PORT:-3180}" \
        "${VIVENTIUM_LC_FRONTEND_PORT:-3190}" \
        "${VIVENTIUM_PLAYGROUND_PORT:-3300}" \
        "${SANDPACK_BUNDLER_LISTEN_PORT:-3191}"
    )"
    read -r api_port frontend_port playground_port sandpack_port <<<"$loaded_ports"
  fi

  printf '%s %s %s %s\n' "$api_port" "$frontend_port" "$playground_port" "$sandpack_port"
}

assign_runtime_ports() {
  local api_var="${1:-}"
  local frontend_var="${2:-}"
  local playground_var="${3:-}"
  local sandpack_var="${4:-}"
  local loaded_ports=""
  local resolved_api_port="3180"
  local resolved_frontend_port="3190"
  local resolved_playground_port="3300"
  local resolved_sandpack_port="3191"

  loaded_ports="$(read_runtime_ports 2>/dev/null || printf '3180 3190 3300 3191\n')"
  # shellcheck disable=SC2086
  set -- $loaded_ports
  resolved_api_port="${1:-3180}"
  resolved_frontend_port="${2:-3190}"
  resolved_playground_port="${3:-3300}"
  resolved_sandpack_port="${4:-3191}"

  if [[ -n "$api_var" ]]; then
    printf -v "$api_var" '%s' "$resolved_api_port"
  fi
  if [[ -n "$frontend_var" ]]; then
    printf -v "$frontend_var" '%s' "$resolved_frontend_port"
  fi
  if [[ -n "$playground_var" ]]; then
    printf -v "$playground_var" '%s' "$resolved_playground_port"
  fi
  if [[ -n "$sandpack_var" ]]; then
    printf -v "$sandpack_var" '%s' "$resolved_sandpack_port"
  fi
}

read_generated_env_value() {
  local key="${1:-}"
  local default_value="${2:-}"
  [[ -n "$key" ]] || {
    printf '%s\n' "$default_value"
    return 0
  }

  if [[ ! -f "$GENERATED_ENV" && ! -f "$GENERATED_LOCAL_ENV" ]]; then
    printf '%s\n' "$default_value"
    return 0
  fi

  local value=""
  value="$(
    set +u
    if [[ -f "$GENERATED_ENV" ]]; then
      # shellcheck disable=SC1090
      source "$GENERATED_ENV"
    fi
    if [[ -f "$GENERATED_LOCAL_ENV" ]]; then
      # shellcheck disable=SC1090
      source "$GENERATED_LOCAL_ENV"
    fi
    printf '%s\n' "${!key:-}"
  )"

  if [[ -n "$value" ]]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$default_value"
  fi
}

read_local_env_assignment() {
  local file="${1:-}"
  local key="${2:-}"
  local line=""
  local value=""
  [[ -n "$file" && -n "$key" && -f "$file" && ! -L "$file" ]] || return 1

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key="* ]]; then
      value="${line#*=}"
      value="${value%%#*}"
      value="$(printf '%s' "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      value="${value#\"}"
      value="${value%\"}"
      value="${value#\'}"
      value="${value%\'}"
      [[ -n "$value" ]] || return 1
      printf '%s' "$value"
      return 0
    fi
  done <"$file"
  return 1
}

runtime_env_true() {
  local key="${1:-}"
  local default_value="${2:-false}"
  local value=""
  value="$(read_generated_env_value "$key" "$default_value")"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  [[ "$value" == "1" || "$value" == "true" || "$value" == "yes" || "$value" == "on" ]]
}

value_is_true() {
  local value="${1:-false}"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  [[ "$value" == "1" || "$value" == "true" || "$value" == "yes" || "$value" == "on" ]]
}

express_install_experience() {
  local value=""
  value="$(read_generated_env_value "VIVENTIUM_INSTALL_EXPERIENCE" "legacy")"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  [[ "$value" == "express" ]]
}

ensure_configured_prerequisites() {
  if ! express_install_experience; then
    return 0
  fi
  echo "Checking Easy Install prerequisites..."
  run_preflight apply
}

runtime_port_listening() {
  local port="${1:-}"
  [[ -n "$port" ]] || return 1
  if declare -F viventium_port_listener_active >/dev/null 2>&1; then
    viventium_port_listener_active "$port"
    return $?
  fi

  # An upgrade can execute this newer CLI while it is still sourcing an older
  # common.sh that predates viventium_port_listener_active. Keep the successor
  # health check self-contained until the candidate has committed successfully.
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN -t >/dev/null 2>&1
    return $?
  fi

  local python_bin="${PYTHON_BIN:-$(command -v python3 2>/dev/null || true)}"
  [[ -n "$python_bin" ]] || return 1
  "$python_bin" - "$port" <<'PY' 2>/dev/null
import socket
import sys

port = int(sys.argv[1])
for host in ("127.0.0.1", "::1"):
    try:
        with socket.create_connection((host, port), timeout=1):
            raise SystemExit(0)
    except OSError:
        pass
raise SystemExit(1)
PY
}

http_url_healthy() {
  local url="${1:-}"
  local timeout_seconds="${2:-2}"
  [[ -n "$url" ]] || return 1

  local code=""
  if command -v curl >/dev/null 2>&1; then
    code="$(curl -sS -L -o /dev/null --max-time "$timeout_seconds" -w '%{http_code}' "$url" 2>/dev/null || true)"
  else
    code="$(
      "$PYTHON_BIN" - "$url" "$timeout_seconds" <<'PY'
import sys
import urllib.error
import urllib.request

url = sys.argv[1]
timeout_seconds = float(sys.argv[2])
request = urllib.request.Request(url, method="GET")
try:
    with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
        print(getattr(response, "status", 200))
except urllib.error.HTTPError as error:
    print(error.code)
except Exception:
    print("000")
PY
    )"
  fi

  [[ "$code" =~ ^(2|3)[0-9][0-9]$ ]]
}

http_json_status_up() {
  local url="${1:-}"
  local timeout_seconds="${2:-2}"
  [[ -n "$url" ]] || return 1

  "$PYTHON_BIN" - "$url" "$timeout_seconds" <<'PY'
import json
import sys
import urllib.request

url = sys.argv[1]
timeout_seconds = float(sys.argv[2])
request = urllib.request.Request(url, method="GET")
try:
    with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
        if getattr(response, "status", 200) != 200:
            raise SystemExit(1)
        payload = json.load(response)
except Exception:
    raise SystemExit(1)

raise SystemExit(0 if isinstance(payload, dict) and payload.get("status") == "UP" else 1)
PY
}

http_json_status_healthy() {
  local url="${1:-}"
  local timeout_seconds="${2:-2}"
  [[ -n "$url" ]] || return 1

  "$PYTHON_BIN" - "$url" "$timeout_seconds" <<'PY'
import json
import sys
import urllib.request

url = sys.argv[1]
timeout_seconds = float(sys.argv[2])
request = urllib.request.Request(url, method="GET")
try:
    with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
        if getattr(response, "status", 200) != 200:
            raise SystemExit(1)
        payload = json.load(response)
except Exception:
    raise SystemExit(1)

status = payload.get("status") if isinstance(payload, dict) else None
raise SystemExit(
    0 if isinstance(status, str) and status.strip().lower() in {"up", "ok"} else 1
)
PY
}

http_url_reachable() {
  local url="${1:-}"
  local timeout_seconds="${2:-2}"
  [[ -n "$url" ]] || return 1

  local code=""
  if command -v curl >/dev/null 2>&1; then
    code="$(curl -sS -L -o /dev/null --max-time "$timeout_seconds" -w '%{http_code}' "$url" 2>/dev/null || true)"
  else
    code="$(
      "$PYTHON_BIN" - "$url" "$timeout_seconds" <<'PY'
import sys
import urllib.error
import urllib.request

url = sys.argv[1]
timeout_seconds = float(sys.argv[2])
request = urllib.request.Request(url, method="GET")
try:
    with urllib.request.urlopen(request, timeout=timeout_seconds) as response:
        print(getattr(response, "status", 200))
except urllib.error.HTTPError as error:
    print(error.code)
except Exception:
    print("000")
PY
    )"
  fi

  [[ "$code" =~ ^[1-4][0-9][0-9]$ ]]
}

local_http_surface_healthy() {
  local port="${1:-}"
  local path_suffix="${2:-/}"
  [[ -n "$port" ]] || return 1
  [[ -n "$path_suffix" ]] || path_suffix="/"

  http_url_healthy "http://localhost:${port}${path_suffix}" ||
    http_url_healthy "http://127.0.0.1:${port}${path_suffix}"
}

api_surface_healthy() {
  local port="${1:-}"
  local_http_surface_healthy "$port" "/api/health"
}

postcommit_api_finalization_ready() {
  local run_id="${VIVENTIUM_POSTCOMMIT_FINALIZATION_ID:-}"
  local source_id="${VIVENTIUM_POSTCOMMIT_SOURCE_ID:-}"
  local receipt="$APP_SUPPORT_DIR/state/continuity/postcommit-api-finalization.json"
  [[ -n "$run_id" ]] || return 0

  "$PYTHON_BIN" - "$APP_SUPPORT_DIR" "$receipt" "$run_id" "$source_id" <<'PY'
import json
import os
import re
import stat
import sys
from pathlib import Path

app_support = Path(os.path.abspath(sys.argv[1]))
receipt = Path(os.path.abspath(sys.argv[2]))
run_id = sys.argv[3]
source_id = sys.argv[4]
required = {
    "database-connected",
    "database-seed-ready",
    "startup-checks-ready",
    "interface-permissions-ready",
    "mcp-runtime-ready",
    "oauth-reconnect-ready",
    "channel-persistence-ready",
    "permission-migration-inspection",
    "stale-cortex-recovery",
    "generation-runtime-ready",
}
if not re.fullmatch(r"[0-9a-f]{64}", run_id):
    raise SystemExit(1)
if not re.fullmatch(r"[0-9a-f]{40,64}", source_id):
    raise SystemExit(1)
try:
    receipt.relative_to(app_support)
    if os.path.realpath(receipt) != str(receipt):
        raise SystemExit(1)
    metadata = receipt.lstat()
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise SystemExit(1)
    payload = json.loads(receipt.read_text(encoding="utf-8"))
except (OSError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
completed = payload.get("completed")
degraded = payload.get("degraded")
valid = (
    payload.get("schemaVersion") == 1
    and payload.get("runId") == run_id
    and payload.get("sourceId") == source_id
    and payload.get("status") == "ready"
    and payload.get("stage") == "ready"
    and isinstance(payload.get("attempt"), int)
    and not isinstance(payload.get("attempt"), bool)
    and payload["attempt"] >= 1
    and isinstance(completed, list)
    and all(isinstance(item, str) for item in completed)
    and required.issubset(set(completed))
    and isinstance(degraded, list)
    and {
        "stage": "derived-search-index",
        "code": "best-effort-derived-state",
    }
    in degraded
)
raise SystemExit(0 if valid else 1)
PY
}

frontend_surface_healthy() {
  local port="${1:-}"
  local_http_surface_healthy "$port" "/"
}

playground_surface_healthy() {
  local port="${1:-}"
  [[ -n "$port" ]] || return 1

  local variant=""
  variant="$(read_generated_env_value "PLAYGROUND_VARIANT" "modern" | tr '[:upper:]' '[:lower:]')"
  if [[ "$variant" != "classic" ]]; then
    variant="modern"
  fi

  local app_dir="$REPO_ROOT/viventium_v0_4/agent-starter-react"
  if [[ "$variant" == "classic" ]]; then
    app_dir="$REPO_ROOT/viventium_v0_4/agents-playground"
  fi

  local source_ref=""
  if [[ -f "$app_dir/.viventium-source-ref" ]]; then
    source_ref="$(tr -d '[:space:]' < "$app_dir/.viventium-source-ref")"
  elif git -C "$app_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    source_ref="$(git -C "$app_dir" rev-parse HEAD 2>/dev/null || true)"
  fi
  [[ "$source_ref" =~ ^[0-9a-f]{40}$ ]] || return 1

  "$PYTHON_BIN" "$REPO_ROOT/scripts/viventium/verify_playground_identity.py" \
    --base-url "http://127.0.0.1:${port}" \
    --variant "$variant" \
    --source-ref "$source_ref" \
    --timeout 2 \
    >/dev/null 2>&1
}

sandpack_surface_healthy() {
  local port="${1:-}"
  [[ -n "$port" ]] || return 1
  "$PYTHON_BIN" - "$port" <<'PY'
import sys
import urllib.request

port = int(sys.argv[1])
for host in ("127.0.0.1", "localhost"):
    try:
        request = urllib.request.Request(f"http://{host}:{port}/index.html", method="GET")
        with urllib.request.urlopen(request, timeout=2) as response:
            body = response.read(1024 * 1024)
            if getattr(response, "status", 200) == 200 and b'IS_ONPREM:"true"' in body:
                raise SystemExit(0)
    except Exception:
        continue
raise SystemExit(1)
PY
}

